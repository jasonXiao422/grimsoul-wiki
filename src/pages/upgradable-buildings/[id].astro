---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ImageZoom from '../../components/ImageZoom.astro';
import MaterialCostList from '../../components/MaterialCostList.astro';
import materials from '../../data/materials.json';
import upgradableBuildings from '../../data/upgradable-buildings.json';
import { getItemIconSrc, getMaterialHref } from '../../lib/data';
import { QUALITY_META, type Quality } from '../../lib/quality';

export function getStaticPaths() {
  return upgradableBuildings.map((building) => ({ params: { id: building.id }, props: { building } }));
}

const { building } = Astro.props;
const levels = [...building.levels].sort((a, b) => a.levelRank - b.levelRank);
const materialByName = new Map(materials.map((material) => [material.name, material]));
const hasValue = (value: unknown) => value !== null && value !== undefined && value !== '';
const getQualityMeta = (quality: unknown) =>
  typeof quality === 'string' && quality in QUALITY_META
    ? QUALITY_META[quality as Quality]
    : QUALITY_META.common;
const fallback =
  'data:image/svg+xml;charset=utf-8,' +
  encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 96 96"><rect width="96" height="96" fill="#1b1d21"/><path d="M21 69h54L61 48 49 61 39 41z" fill="#2c2f35"/></svg>');
const pendingText = '游戏未出，敬请期待';
const commonQualityStyle = `--quality-border:${QUALITY_META.common.border};--quality-glow:${QUALITY_META.common.glow}`;
---

<BaseLayout title={building.name} description={`${building.name}的等级、用途、组装材料与图纸来源`}>
  <Breadcrumb items={[{ label: '首页', href: '/' }, { label: '可升级建筑', href: '/upgradable-buildings' }, { label: building.name }]} />

  <section class="upgradable-building-detail-hero panel">
    <div class="upgradable-building-detail-image-wrap">
      <img
        class="upgradable-building-detail-image quality-icon"
        src={`/images/upgradable-buildings/${building.id}-cover.webp`}
        alt={building.name}
        style={commonQualityStyle}
        data-fallback={fallback}
        onerror="this.onerror=null;this.src=this.dataset.fallback;this.classList.add('is-missing')"
      />
    </div>
    <div>
      <h1>{building.name}</h1>
      {hasValue(building.maxCount) && (
        <span class="tag upgradable-building-max-count">
          最多建造 {building.maxCount}{typeof building.maxCount === 'number' ? ' 座' : ''}
        </span>
      )}
    </div>
  </section>

  {building.notes.length > 0 && (
    <section class="upgradable-building-notes panel">
      <h2 class="detail-panel-title">备注</h2>
      <ul class="recipe-list compact upgradable-building-notes-list">
        {building.notes.map((note) => {
          const material = materialByName.get(note.name);
          const quality = getQualityMeta(material?.quality ?? note.quality);
          const qualityStyle = `--quality-border:${quality.border};--quality-glow:${quality.glow}`;
          return (
            <li>
              {material ? (
                <a href={getMaterialHref(material)}>
                  <span class="upgradable-building-note-icon">
                    <img
                      class="item-icon quality-icon"
                      src={getItemIconSrc('materials', material)}
                      alt={material.name}
                      loading="lazy"
                      style={qualityStyle}
                      data-fallback={fallback}
                      onerror="this.onerror=null;this.src=this.dataset.fallback;this.classList.add('is-missing')"
                    />
                  </span>
                  <span class="upgradable-building-note-content">
                    <span class="upgradable-building-note-name" style={`color:${quality.text}`}>{material.name}</span>
                    <span class="upgradable-building-note-description">：{note.description}</span>
                  </span>
                </a>
              ) : (
                <span>
                  <span class="upgradable-building-note-content">
                    <strong class="upgradable-building-note-name" style={`color:${quality.text}`}>{note.name}</strong>
                    <span class="upgradable-building-note-description">：{note.description}</span>
                  </span>
                </span>
              )}
            </li>
          );
        })}
      </ul>
    </section>
  )}

  <section class="upgradable-building-levels">
    <h2 class="detail-panel-title">等级信息</h2>
    <div class="upgradable-building-level-grid">
      {levels.map((level) => (
        <article class="upgradable-building-level panel">
          {(() => {
            const levelPending = level.purposePending || level.costPending || level.blueprintPending;
            return (
          <div class="upgradable-building-level-heading">
            <h3>{level.level}</h3>
            {building.iconMode === 'per-level' && (levelPending || level.iconId) && (
              levelPending ? (
                <div
                  class="upgradable-building-level-icon upgradable-building-level-placeholder quality-icon"
                  style={`${commonQualityStyle};width:180px;height:180px;box-sizing:border-box;border-radius:6px;display:flex;align-items:center;justify-content:center;color:var(--accent)`}
                  aria-label={`${building.name} ${level.level} 敬请期待`}
                >
                  敬请期待
                </div>
              ) : (
                <ImageZoom
                  src={`/images/upgradable-buildings/${level.iconId}.webp`}
                  alt={`${building.name} ${level.level}`}
                  class="upgradable-building-level-icon quality-icon"
                  style={`${commonQualityStyle};width:180px;height:180px;max-width:180px;max-height:180px;box-sizing:border-box;border-radius:6px`}
                />
              )
            )}
          </div>
            );
          })()}
          <table class="attr-table upgradable-building-level-summary">
            <tbody>
              {hasValue(level.castlePoints) && <tr><th>城堡点数</th><td>{level.castlePoints}</td></tr>}
              <tr><th>用途</th><td>{level.purposePending ? pendingText : (level.purpose ?? '无')}</td></tr>
              <tr><th>图纸掉落地点</th><td>{level.blueprintPending ? pendingText : (level.blueprintSource ?? '无')}</td></tr>
            </tbody>
          </table>
          <section class="upgradable-building-level-cost">
            <h4>组装材料</h4>
            {level.costPending ? <p class="muted">{pendingText}</p> : level.cost.length > 0 ? <MaterialCostList cost={level.cost} compact /> : <p>无</p>}
          </section>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .upgradable-building-detail-hero {
    display: grid;
    grid-template-columns: minmax(120px, 180px) minmax(0, 1fr);
    gap: 20px;
    align-items: center;
  }

  .upgradable-building-detail-image-wrap {
    width: 180px;
    height: 180px;
    max-width: 100%;
  }

  .upgradable-building-detail-image {
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    object-fit: contain;
    border-radius: 6px;
  }

  .upgradable-building-detail-hero .upgradable-building-max-count {
    display: inline-block;
    width: fit-content;
    max-width: 100%;
    margin-top: 4px;
    white-space: nowrap;
    justify-self: start;
    color: var(--accent);
  }

  .upgradable-building-notes,
  .upgradable-building-levels {
    margin-top: 18px;
  }

  .upgradable-building-notes h2,
  .upgradable-building-levels > h2 {
    margin-top: 0;
  }

  .upgradable-building-notes .upgradable-building-notes-list {
    margin: 0;
  }

  .upgradable-building-notes-list a {
    display: flex;
    align-items: center;
  }

  .upgradable-building-notes-list .item-icon {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .upgradable-building-note-icon {
    flex: 0 0 48px;
    width: 48px;
    height: 48px;
    align-self: center;
  }

  .upgradable-building-note-content {
    flex: 1 1 auto;
    min-width: 0;
  }

  .upgradable-building-note-name {
    min-width: 0;
    white-space: nowrap;
  }

  .upgradable-building-note-description {
    min-width: 0;
    color: var(--text);
    white-space: pre-line;
    overflow-wrap: anywhere;
  }

  .upgradable-building-level-grid {
    display: grid;
    gap: 18px;
  }

  .upgradable-building-level {
    min-width: 0;
  }

  .upgradable-building-level h3 {
    margin: 0;
    color: var(--accent);
  }

  .upgradable-building-level-heading {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }

  .upgradable-building-level-icon {
    flex: 0 0 auto;
    object-fit: contain;
    cursor: zoom-in;
  }

  .upgradable-building-level-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px;
    color: var(--accent);
    font-size: 1rem;
    text-align: center;
  }

  .upgradable-building-level-summary {
    width: fit-content;
    max-width: 100%;
    margin: 0;
  }

  .upgradable-building-level-summary th {
    width: auto;
    padding-right: 24px;
    white-space: nowrap;
  }

  .upgradable-building-level-summary td {
    max-width: 44em;
    white-space: pre-line;
    overflow-wrap: anywhere;
  }

  .upgradable-building-level-cost {
    margin-top: 18px;
  }

  .upgradable-building-level-cost h4 {
    margin: 0 0 10px;
    color: var(--accent);
  }

  .upgradable-building-level-cost > p {
    margin: 0;
  }

  .upgradable-building-level-cost :global(.recipe-list.compact) {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
  }

  .upgradable-building-level-cost :global(.recipe-list.compact > li) {
    min-width: 0;
  }

  .upgradable-building-level-cost :global(.recipe-list.compact > li > a) {
    min-height: 62px;
    align-items: center;
  }

  .upgradable-building-level-cost :global(.recipe-list.compact > li > a > span:first-of-type) {
    min-width: 0;
    line-height: 1.3;
  }

  .upgradable-building-level-cost :global(.recipe-list.compact .qty) {
    white-space: nowrap;
    margin-left: auto;
  }

  @media (max-width: 1199px) {
    .upgradable-building-level-cost :global(.recipe-list.compact) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 1023px) {
    .upgradable-building-level-cost :global(.recipe-list.compact) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 639px) {
    .upgradable-building-level-cost :global(.recipe-list.compact) {
      grid-template-columns: repeat(1, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .upgradable-building-detail-hero {
      grid-template-columns: 1fr;
    }

    .upgradable-building-detail-image-wrap {
      width: 100%;
      max-width: none;
      margin: 0;
      height: auto;
      aspect-ratio: 1 / 1;
    }

    .upgradable-building-notes .upgradable-building-notes-list {
      grid-template-columns: 1fr;
    }

    .upgradable-building-level-summary td {
      max-width: none;
    }
  }
</style>
