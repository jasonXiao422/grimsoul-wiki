---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import upgradableBuildings from '../../data/upgradable-buildings.json';
import { QUALITY_META } from '../../lib/quality';

const tags = [...new Set(upgradableBuildings.flatMap((building) => building.tags))];
const fallback =
  'data:image/svg+xml;charset=utf-8,' +
  encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 96 96"><rect width="96" height="96" fill="#1b1d21"/><path d="M21 69h54L61 48 49 61 39 41z" fill="#2c2f35"/></svg>');
const qualityStyle = `--quality-border:${QUALITY_META.common.border};--quality-glow:${QUALITY_META.common.glow}`;
---

<BaseLayout title="可升级建筑" description={`收录 ${upgradableBuildings.length} 个可升级建筑的等级、用途、材料与图纸来源`}>
  <Breadcrumb items={[{ label: '首页', href: '/' }, { label: '可升级建筑' }]} />

  <section class="page-heading">
    <p class="eyebrow">建筑资料</p>
    <h1>可升级建筑</h1>
    <p class="muted">收录可升级建筑的等级、用途、组装材料与图纸掉落地点。</p>
  </section>

  <div class="upgradable-buildings-filter" data-upgradable-buildings-filter>
    <label class="upgradable-buildings-search">
      <span class="sr-only">搜索建筑名称</span>
      <input type="search" placeholder="搜索建筑名称" aria-label="搜索建筑名称" data-upgradable-building-search />
    </label>
    <label class="upgradable-buildings-tag-filter">
      <span class="sr-only">按标签筛选</span>
      <select aria-label="按标签筛选" data-upgradable-building-tag>
        <option value="">全部标签</option>
        {tags.map((tag) => <option value={tag}>{tag}</option>)}
      </select>
    </label>
  </div>

  <div class="upgradable-buildings-grid">
    {upgradableBuildings.map((building) => (
      <a class="upgradable-building-card" href={`/upgradable-buildings/${building.id}`} data-tags={building.tags.join('|')}>
        <div class="upgradable-building-card-image">
          <img
            class="upgradable-building-card-icon quality-icon"
            src={`/images/upgradable-buildings/${building.id}-cover.webp`}
            alt={building.name}
            loading="lazy"
            style={qualityStyle}
            data-fallback={fallback}
            onerror="this.onerror=null;this.src=this.dataset.fallback;this.classList.add('is-missing')"
          />
        </div>
        <strong class="upgradable-building-card-name">{building.name}</strong>
      </a>
    ))}
  </div>

  <div class="upgradable-buildings-empty" data-upgradable-building-empty hidden>
    <p>没有找到匹配的建筑。</p>
    <button type="button" class="upgradable-buildings-empty-action" data-clear-upgradable-building-search>清除搜索</button>
  </div>

  <script>
    const cards = [...document.querySelectorAll('.upgradable-building-card')];
    const search = document.querySelector('[data-upgradable-building-search]');
    const tagSelect = document.querySelector('[data-upgradable-building-tag]');
    const empty = document.querySelector('[data-upgradable-building-empty]');
    const applyFilters = () => {
      const query = (search?.value ?? '').trim().toLocaleLowerCase('zh-Hans-CN');
      const activeTag = tagSelect?.value ?? '';
      let visibleCount = 0;
      cards.forEach((card) => {
        const cardTags = (card.dataset.tags ?? '').split('|');
        const name = card.querySelector('.upgradable-building-card-name')?.textContent?.toLocaleLowerCase('zh-Hans-CN') ?? '';
        const visible = (!activeTag || cardTags.includes(activeTag)) && (!query || name.includes(query));
        card.hidden = !visible;
        if (visible) visibleCount += 1;
      });
      empty?.toggleAttribute('hidden', visibleCount > 0);
    };
    tagSelect?.addEventListener('change', applyFilters);
    search?.addEventListener('input', applyFilters);
    document.querySelector('[data-clear-upgradable-building-search]')?.addEventListener('click', () => {
      if (search) search.value = '';
      if (tagSelect) tagSelect.value = '';
      search?.focus();
      applyFilters();
    });
  </script>
</BaseLayout>

<style>
  .upgradable-buildings-filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 0 0 16px;
  }

  .upgradable-buildings-search {
    flex: 1 1 220px;
    min-width: 180px;
  }

  .upgradable-buildings-search input,
  .upgradable-buildings-tag-filter select {
    width: 100%;
    min-height: 36px;
    padding: 7px 10px;
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text);
    background: var(--bg-panel);
  }

  .upgradable-buildings-tag-filter {
    flex: 0 1 240px;
    min-width: 180px;
  }

  .upgradable-buildings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 12px;
    align-items: stretch;
  }

  .upgradable-building-card {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 10px;
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
    background: var(--bg-panel);
    transition: transform 160ms ease, border-color 160ms ease;
  }

  .upgradable-building-card:hover,
  .upgradable-building-card:focus-visible {
    border-color: var(--accent-dim);
    transform: translateY(-2px);
  }

  .upgradable-building-card[hidden] {
    display: none !important;
  }

  .upgradable-building-card-image {
    display: grid;
    width: 100%;
    aspect-ratio: 1 / 1;
    place-items: center;
    border-radius: 6px;
    background: var(--bg);
  }

  .upgradable-building-card-icon {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .upgradable-building-card-name {
    min-height: 2.6em;
    font-family: var(--font-serif);
    font-size: 0.95rem;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .upgradable-buildings-empty {
    padding: 26px 16px;
    border: 1px dashed var(--border);
    border-radius: 8px;
    color: var(--text-dim);
    text-align: center;
  }

  .upgradable-buildings-empty[hidden] {
    display: none !important;
  }

  .upgradable-buildings-empty p {
    margin: 0 0 12px;
  }

  .upgradable-buildings-empty-action {
    padding: 6px 12px;
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text-dim);
    background: var(--bg-panel);
    cursor: pointer;
  }

  .upgradable-buildings-empty-action:hover,
  .upgradable-buildings-empty-action:focus-visible {
    border-color: var(--accent-dim);
    color: var(--accent);
  }

  @media (max-width: 720px) {
    .upgradable-buildings-filter {
      align-items: stretch;
    }

    .upgradable-buildings-search,
    .upgradable-buildings-tag-filter {
      flex: 1 1 100%;
      min-width: 0;
    }
  }
</style>
