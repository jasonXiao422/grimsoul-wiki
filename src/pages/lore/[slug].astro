---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

type LoreEntry = CollectionEntry<'lore'>;

const getLoreSlug = (id: string) => id.replace(/\.md$/, '');

export async function getStaticPaths() {
  const entries = (await getCollection('lore'))
    .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title, 'zh-Hans-CN'));

  return entries.map((entry, index) => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: {
      entry,
      previous: entries[index - 1] ?? null,
      next: entries[index + 1] ?? null,
    },
  }));
}

const { entry, previous, next } = Astro.props as {
  entry: LoreEntry;
  previous: LoreEntry | null;
  next: LoreEntry | null;
};
const { Content, headings } = await render(entry);
const toc = headings.filter((heading) => heading.depth === 2);
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <div class="lore-detail-layout">
    <article class="lore-article">
      <header class="page-heading">
        <p class="eyebrow">背景故事 · 第{entry.data.order}篇</p>
        <h1>{entry.data.title}</h1>
        <p class="muted">{entry.data.summary}</p>
      </header>

      {toc.length > 0 && (
        <details class="lore-toc-mobile">
          <summary>目录</summary>
          <nav aria-label="文章目录">
            {toc.map((heading) => (
              <a href={`#${heading.slug}`}>{heading.text}</a>
            ))}
          </nav>
        </details>
      )}

      <div class="lore-content panel">
        <Content />
      </div>

      <nav class="lore-pager" aria-label="上一篇和下一篇">
        {previous ? (
          <a href={`/lore/${getLoreSlug(previous.id)}`}>
            <span>上一篇</span>
            <strong>{previous.data.title}</strong>
          </a>
        ) : (
          <span></span>
        )}
        {next ? (
          <a href={`/lore/${getLoreSlug(next.id)}`}>
            <span>下一篇</span>
            <strong>{next.data.title}</strong>
          </a>
        ) : (
          <span></span>
        )}
      </nav>
    </article>

    {toc.length > 0 && (
      <aside class="lore-toc">
        <h2>目录</h2>
        <nav aria-label="文章目录">
          {toc.map((heading) => (
            <a href={`#${heading.slug}`}>{heading.text}</a>
          ))}
        </nav>
      </aside>
    )}
  </div>
</BaseLayout>
