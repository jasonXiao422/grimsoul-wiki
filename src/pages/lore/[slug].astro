---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import MarkdownImageZoom from '../../components/MarkdownImageZoom.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

type LoreEntry = CollectionEntry<'lore'>;

const getLoreSlug = (id: string) => id.replace(/\.md$/, '');

export async function getStaticPaths() {
  const entries = (await getCollection('lore'))
    .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title, 'zh-Hans-CN'));

  return entries.map((entry, index) => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: {
      entry,
      previous: entries[index - 1] ?? null,
      next: entries[index + 1] ?? null,
    },
  }));
}

const { entry, previous, next } = Astro.props as {
  entry: LoreEntry;
  previous: LoreEntry | null;
  next: LoreEntry | null;
};
const { Content, headings } = await render(entry);
const toc = headings.filter((heading) => heading.depth === 2);
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <div class="lore-detail-layout">
    <article class="lore-article">
      <header class="page-heading">
        <Breadcrumb items={[
          { label: '首页', href: '/' },
          { label: '世界观', href: '/lore' },
          { label: entry.data.title },
        ]} />
        <p class="eyebrow">第{entry.data.order}篇</p>
        <h1>{entry.data.title}</h1>
        <p class="muted">{entry.data.summary}</p>
      </header>

      {toc.length > 0 && (
        <details class="lore-toc-mobile">
          <summary>目录</summary>
          <nav aria-label="文章目录">
            {toc.map((heading) => (
              <a href={`#${heading.slug}`}>{heading.text}</a>
            ))}
          </nav>
        </details>
      )}

      <div class="lore-content panel">
        <Content />
        <MarkdownImageZoom containerSelector=".lore-content figure.enemy-concept, .lore-content .lore-gallery" />
      </div>

      <script is:inline>
        (() => {
          const initLoreGalleries = () => {
            try {
              document.querySelectorAll('[data-gallery]').forEach((gallery) => {
                if (gallery.dataset.initialized) return;
                gallery.dataset.initialized = 'true';
                const slides = [...gallery.querySelectorAll(':scope > .lore-gallery-slide')];
                if (slides.length === 0) return;

                const track = document.createElement('div');
                track.className = 'lore-gallery-track';
                slides.forEach((slide) => track.append(slide));
                gallery.append(track);

                let counterCurrent;
                let progressFill;
                const formatCounter = (value) => String(value).padStart(2, '0');
                const positionArrows = () => {
                  const activeSlide = slides.find((slide) => slide.classList.contains('is-active'));
                  const image = activeSlide?.querySelector('img');
                  if (!image) return;
                  const galleryRect = gallery.getBoundingClientRect();
                  const imageRect = image.getBoundingClientRect();
                  const center = imageRect.top + imageRect.height / 2 - galleryRect.top;
                  gallery.style.setProperty('--gallery-arrow-y', `${center}px`);
                  if (!image.complete) image.addEventListener('load', positionArrows, { once: true });
                };
                const setActive = (index) => {
                  slides.forEach((slide, slideIndex) => slide.classList.toggle('is-active', slideIndex === index));
                  counterCurrent?.replaceChildren(document.createTextNode(formatCounter(index + 1)));
                  if (progressFill) progressFill.style.width = `${((index + 1) / slides.length) * 100}%`;
                  positionArrows();
                };
                const getClosestIndex = () => {
                  const center = track.scrollLeft + track.clientWidth / 2;
                  return slides.reduce((closest, slide, index) => {
                    const distance = Math.abs(slide.offsetLeft + slide.offsetWidth / 2 - center);
                    const closestDistance = Math.abs(slides[closest].offsetLeft + slides[closest].offsetWidth / 2 - center);
                    return distance < closestDistance ? index : closest;
                  }, 0);
                };
                const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                let isProgrammaticScroll = false;
                let scrollEndFallbackTimer;
                let galleryResizeObserver;
                let galleryIntersectionObserver;
                const finishProgrammaticScroll = () => {
                  isProgrammaticScroll = false;
                  if (scrollEndFallbackTimer !== undefined) {
                    window.clearTimeout(scrollEndFallbackTimer);
                    scrollEndFallbackTimer = undefined;
                  }
                };
                const scrollToSlide = (index) => {
                  const target = slides[(index + slides.length) % slides.length];
                  if (!target) return;
                  const left = target.offsetLeft - (track.clientWidth - target.offsetWidth) / 2;
                  isProgrammaticScroll = true;
                  track.scrollTo({
                    left,
                    behavior: prefersReducedMotion ? 'auto' : 'smooth',
                  });
                  setActive((index + slides.length) % slides.length);
                };

                if (slides.length > 1) {
                  const previous = document.createElement('button');
                  previous.type = 'button';
                  previous.className = 'lore-gallery-arrow lore-gallery-arrow-previous';
                  previous.setAttribute('aria-label', '上一张');
                  previous.innerHTML = '<svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 20 7 12 15 4" /></svg>';
                  previous.addEventListener('click', () => scrollToSlide(getClosestIndex() - 1));

                  const next = document.createElement('button');
                  next.type = 'button';
                  next.className = 'lore-gallery-arrow lore-gallery-arrow-next';
                  next.setAttribute('aria-label', '下一张');
                  next.innerHTML = '<svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 20 17 12 9 4" /></svg>';
                  next.addEventListener('click', () => scrollToSlide(getClosestIndex() + 1));

                  const counter = document.createElement('div');
                  counter.className = 'lore-gallery-counter';
                  counter.setAttribute('aria-live', 'polite');
                  counterCurrent = document.createElement('span');
                  counterCurrent.className = 'lore-gallery-current';
                  const separator = document.createElement('span');
                  separator.className = 'lore-gallery-sep';
                  separator.textContent = '/';
                  const total = document.createElement('span');
                  total.className = 'lore-gallery-total';
                  total.textContent = formatCounter(slides.length);
                  counter.append(counterCurrent, separator, total);

                  const progress = document.createElement('div');
                  progress.className = 'lore-gallery-progress';
                  progressFill = document.createElement('span');
                  progress.append(progressFill);
                  gallery.append(previous, next, counter, progress);
                }

                setActive(0);
                if ('ResizeObserver' in window) {
                  galleryResizeObserver = new ResizeObserver(positionArrows);
                  galleryResizeObserver.observe(gallery);
                }
                const updateActive = () => {
                  if (!isProgrammaticScroll) setActive(getClosestIndex());
                };
                galleryIntersectionObserver = new IntersectionObserver(updateActive, { root: track, threshold: [0.25, 0.5, 0.75] });
                slides.forEach((slide) => galleryIntersectionObserver.observe(slide));
                track.addEventListener('scroll', () => {
                  if (isProgrammaticScroll) {
                    if (scrollEndFallbackTimer !== undefined) window.clearTimeout(scrollEndFallbackTimer);
                    scrollEndFallbackTimer = window.setTimeout(finishProgrammaticScroll, 150);
                    return;
                  }
                  updateActive();
                }, { passive: true });
                track.addEventListener('scrollend', finishProgrammaticScroll);

                gallery.addEventListener('keydown', (event) => {
                  if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
                  event.preventDefault();
                  scrollToSlide(getClosestIndex() + (event.key === 'ArrowRight' ? 1 : -1));
                });
                gallery.addEventListener('click', (event) => {
                  const target = event.target;
                  if (!(target instanceof HTMLImageElement)) return;
                  const slide = target.closest('.lore-gallery-slide');
                  if (!slide || slide.classList.contains('is-active')) return;
                  event.preventDefault();
                  event.stopPropagation();
                  scrollToSlide(slides.indexOf(slide));
                });

                document.addEventListener('astro:before-swap', () => {
                  if (scrollEndFallbackTimer !== undefined) window.clearTimeout(scrollEndFallbackTimer);
                  galleryResizeObserver?.disconnect();
                  galleryIntersectionObserver?.disconnect();
                  delete gallery.dataset.initialized;
                }, { once: true });
                console.info('[lore-gallery] 已启动');
              });
            } catch (error) {
              console.error('[lore-gallery]', error);
            }
          };

          if (!window.__loreGalleryLifecycle) {
            window.__loreGalleryLifecycle = true;
            document.addEventListener('astro:after-swap', initLoreGalleries);
          }
          initLoreGalleries();
        })();
      </script>

      <nav class="lore-pager" aria-label="上一篇和下一篇">
        {previous ? (
          <a href={`/lore/${getLoreSlug(previous.id)}`}>
            <span>上一篇</span>
            <strong>{previous.data.title}</strong>
          </a>
        ) : (
          <span></span>
        )}
        {next ? (
          <a href={`/lore/${getLoreSlug(next.id)}`}>
            <span>下一篇</span>
            <strong>{next.data.title}</strong>
          </a>
        ) : (
          <span></span>
        )}
      </nav>
    </article>

    {toc.length > 0 && (
      <aside class="lore-toc">
        <h2>目录</h2>
        <nav aria-label="文章目录">
          {toc.map((heading) => (
            <a href={`#${heading.slug}`}>{heading.text}</a>
          ))}
        </nav>
      </aside>
    )}
  </div>
</BaseLayout>

<style>
  .lore-content :global(.lore-furgin-concept-image),
  .lore-content :global(.lore-kahn-concept-image),
  .lore-content :global(.lore-xiu-bo-er-illustration-image) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
  }

</style>
