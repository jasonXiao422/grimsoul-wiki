---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

type LoreScrollEntry = CollectionEntry<'lore-scrolls'>;

export async function getStaticPaths() {
  const entries = (await getCollection('lore-scrolls'))
    .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title, 'zh-Hans-CN'));

  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: LoreScrollEntry };
const groupEntries = (await getCollection('lore-scrolls'))
  .filter((candidate) => candidate.data.group === entry.data.group)
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title, 'zh-Hans-CN'));
const entryIndex = groupEntries.findIndex((candidate) => candidate.id === entry.id);
const previous = groupEntries[entryIndex - 1] ?? null;
const next = groupEntries[entryIndex + 1] ?? null;
const { Content, headings } = await render(entry);
const toc = headings.filter((heading) => heading.depth === 2);
const plainText = entry.body
  .replace(/<p>\s*<span[^>]*class=["'][^"']*scroll-page[^"']*["'][^>]*>.*?<\/span>\s*<\/p>/gis, ' ')
  .replace(/<[^>]*>/g, ' ')
  .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
  .replace(/[`*_~>#-]/g, ' ')
  .replace(/\s+/g, '');
const wordCount = (plainText.match(/[\u3400-\u9fffA-Za-z0-9]/g) ?? []).length;
const readingMinutes = Math.max(1, Math.ceil(wordCount / 400));
const getScrollSlug = (id: string) => id.replace(/\.md$/, '');
---

<BaseLayout title={entry.data.title} description={`${entry.data.group} · 共 ${entry.data.pages} 页`}>
  <div class="lore-detail-layout scroll-detail-layout">
    <article class="lore-article">
      <header class="page-heading">
        <Breadcrumb items={[
          { label: '背景故事', href: '/lore' },
          { label: '卷轴原文', href: '/lore/scrolls' },
          { label: entry.data.title },
        ]} />
        <p class="eyebrow">{entry.data.group}</p>
        <h1>{entry.data.title}</h1>
        <p class="muted">{entry.data.group} · {entry.data.pages} 页 · 约 {wordCount} 字 · 阅读约 {readingMinutes} 分钟</p>
      </header>

      {toc.length > 0 && (
        <details class="lore-toc-mobile">
          <summary>目录</summary>
          <nav aria-label="文章目录">
            {toc.map((heading) => (
              <a href={`#${heading.slug}`}>{heading.text}</a>
            ))}
          </nav>
        </details>
      )}

      <div class="lore-content panel scroll-body">
        <Content />
      </div>

      <nav class="lore-pager" aria-label="上一篇和下一篇">
        {previous ? (
          <a href={`/lore/scrolls/${getScrollSlug(previous.id)}`}>
            <span>上一篇</span>
            <strong>{previous.data.title}</strong>
          </a>
        ) : (
          <span></span>
        )}
        {next ? (
          <a href={`/lore/scrolls/${getScrollSlug(next.id)}`}>
            <span>下一篇</span>
            <strong>{next.data.title}</strong>
          </a>
        ) : (
          <span></span>
        )}
      </nav>
    </article>

    <aside class="scroll-sidebar">
      {toc.length > 0 && (
        <section>
          <h2>目录</h2>
          <nav aria-label="文章目录">
            {toc.map((heading) => (
              <a href={`#${heading.slug}`}>{heading.text}</a>
            ))}
          </nav>
        </section>
      )}
      <section>
        <h2>同组卷轴</h2>
        <nav aria-label="同组卷轴">
          {groupEntries.map((candidate) => (
            <a
              href={`/lore/scrolls/${getScrollSlug(candidate.id)}`}
              aria-current={candidate.id === entry.id ? 'page' : undefined}
            >
              {candidate.data.title}
            </a>
          ))}
        </nav>
      </section>
    </aside>
  </div>
</BaseLayout>
