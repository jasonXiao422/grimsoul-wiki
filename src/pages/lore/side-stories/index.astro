---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('side-stories'))
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title, 'zh-Hans-CN'));
---

<BaseLayout title="官方外传" description="官方在游戏之外发布的背景故事，目前来自官方 Discord。">
  <Breadcrumb items={[
    { label: '首页', href: '/' },
    { label: '世界观', href: '/lore' },
    { label: '官方外传' },
  ]} />

  <section class="page-heading">
    <p class="eyebrow">背景故事</p>
    <h1>官方外传</h1>
    <p class="muted">官方在游戏之外发布的背景故事，目前来自官方 Discord。它们不会出现在游戏里，但属于官方设定。中文为本站翻译。</p>
  </section>

  <section class="lore-index side-stories-index" aria-label="官方外传目录">
    {entries.map((entry) => (
      <a class="lore-card side-story-card" href={`/lore/side-stories/${entry.id.replace(/\.md$/, '')}`}>
        <span>
          <strong>{entry.data.title}</strong>
          <span>{entry.data.summary}</span>
        </span>
        <small class="side-story-source">来源：{entry.data.source}</small>
      </a>
    ))}
  </section>
</BaseLayout>
