---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import LoreTimeline from '../components/LoreTimeline.astro';
import { getCollection } from 'astro:content';
import { MANUAL_LORE_CARDS } from '../lib/lore-cards';

const getLoreSlug = (id: string) => id.replace(/\.md$/, '');

const entries = (await getCollection('lore'))
  .filter((entry) => getLoreSlug(entry.id) !== '07-knight-orders')
  .map((entry) => ({
    order: entry.data.order,
    title: entry.data.title,
    summary: entry.data.summary,
    href: `/lore/${getLoreSlug(entry.id)}`,
  }));

const loreCards = [
  ...entries,
  ...MANUAL_LORE_CARDS,
].sort((a, b) => a.order - b.order || a.title.localeCompare(b.title, 'zh-Hans-CN'));

---

<BaseLayout title="世界观" description="瘟疫之地背景故事目录">
  <Breadcrumb items={[
    { label: '首页', href: '/' },
    { label: '世界观' },
  ]} />

  <section class="page-heading">
    <p class="eyebrow">背景故事</p>
    <h1>世界观</h1>
    <p class="muted">整理瘟疫之地的传说、瘟疫、帝国记录与未解谜团。</p>
  </section>

  <LoreTimeline />

  <section class="lore-index" aria-label="背景故事目录">
      {loreCards.map((entry) => (
        <a class="lore-card" href={entry.href}>
          <span class="lore-order">{String(entry.order).padStart(2, '0')}</span>
          <span>
            <strong>{entry.title}</strong>
            <span>{entry.summary}</span>
          </span>
        </a>
      ))}
  </section>
</BaseLayout>
