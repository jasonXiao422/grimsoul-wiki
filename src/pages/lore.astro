---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

const entries = await getCollection('lore');
const loreEntries = await Promise.all(
  entries
    .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title, 'zh-Hans-CN'))
    .map(async (entry) => ({
      ...entry,
      ...(await render(entry)),
    }))
);
---

<BaseLayout title="背景故事" description="灰蚀之地背景故事">
  <section class="page-heading">
    <p class="eyebrow">世界观</p>
    <h1>背景故事</h1>
    <p class="muted">整理灰蚀之地的传说、瘟疫与幸存者记录。</p>
  </section>

  <div class="lore-content panel">
    {loreEntries.map((entry) => {
      const Content = entry.Content;
      return (
        <article>
          <h2>{entry.data.title}</h2>
          <Content />
        </article>
      );
    })}
  </div>
</BaseLayout>
