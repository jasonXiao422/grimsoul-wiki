---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ArmorCalculator from '../../components/ArmorCalculator.astro';
import DamageCalculator from '../../components/DamageCalculator.astro';
import HorseCalculator from '../../components/HorseCalculator.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

type GuideEntry = CollectionEntry<'guides'>;

export async function getStaticPaths() {
  const entries = (await getCollection('guides'))
    .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title, 'zh-Hans-CN'));

  return entries.map((entry, index) => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: {
      entry,
      previous: entries[index - 1] ?? null,
      next: entries[index + 1] ?? null,
    },
  }));
}

const { entry, previous, next } = Astro.props as {
  entry: GuideEntry;
  previous: GuideEntry | null;
  next: GuideEntry | null;
};
const { Content, headings } = await render(entry);
const toc = headings.filter((heading) => heading.depth === 2);
const slug = entry.id.replace(/\.md$/, '');
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <div class="lore-detail-layout">
    <article class="lore-article">
      <header class="page-heading">
        <Breadcrumb items={[
          { label: '首页', href: '/' },
          { label: entry.data.title },
        ]} />
        <p class="eyebrow">机制攻略</p>
        <h1>{entry.data.title}</h1>
        <p class="muted">{entry.data.summary}</p>
      </header>

      {toc.length > 0 && (
        <details class="lore-toc-mobile">
          <summary>目录</summary>
          <nav aria-label="文章目录">
            {toc.map((heading) => (
              <a href={`#${heading.slug}`}>{heading.text}</a>
            ))}
          </nav>
        </details>
      )}

      <div class="lore-content guide-content panel">
        <Content />
        {slug === 'horse' && <HorseCalculator />}
        {slug === 'armor' && <ArmorCalculator />}
        {slug === 'armor' && <DamageCalculator />}
      </div>

      <nav class="lore-pager" aria-label="上一篇和下一篇">
        {previous ? (
          <a href={`/guides/${previous.id.replace(/\.md$/, '')}`}>
            <span>上一篇</span>
            <strong>{previous.data.title}</strong>
          </a>
        ) : (
          <span></span>
        )}
        {next ? (
          <a href={`/guides/${next.id.replace(/\.md$/, '')}`}>
            <span>下一篇</span>
            <strong>{next.data.title}</strong>
          </a>
        ) : (
          <span></span>
        )}
      </nav>
    </article>

    {toc.length > 0 && (
      <aside class="lore-toc">
        <h2>目录</h2>
        <nav aria-label="文章目录">
          {toc.map((heading) => (
            <a href={`#${heading.slug}`}>{heading.text}</a>
          ))}
        </nav>
      </aside>
    )}
  </div>
</BaseLayout>

<style>
  .lore-article :global(.horse-levels-image) {
    display: block;
    width: 100%;
    height: auto;
    margin: 22px 0;
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .lore-article :global(.horse-appearance-grid) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    width: 100%;
    max-width: 640px;
    margin: 22px auto;
  }

  .lore-article :global(.horse-appearance-card) {
    margin: 0;
    text-align: center;
  }

  .lore-article :global(.horse-appearance-card img) {
    display: block;
    width: 100%;
    max-width: 300px;
    height: auto;
    border-radius: 8px;
    margin: 0 auto;
  }

  .lore-article :global(.horse-appearance-card figcaption) {
    margin-top: 2px;
    color: var(--accent);
    font-family: var(--font-serif);
    font-size: 1.05rem;
    line-height: 1.4;
    text-align: center;
  }

  @media (max-width: 720px) {
    .lore-article :global(.horse-appearance-grid) {
      grid-template-columns: 1fr;
    }

    .lore-article :global(.horse-appearance-card img) {
      max-width: 320px;
    }
  }
</style>
