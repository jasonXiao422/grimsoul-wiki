---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import sharpen from '../../data/sharpen.json';
import { getItemIconSrc } from '../../lib/data';
import { QUALITY_META, type Quality } from '../../lib/quality';

export function getStaticPaths() {
  return sharpen.map((item) => ({
    params: { id: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const fallback =
  'data:image/svg+xml;charset=utf-8,' +
  encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 96 96"><rect width="96" height="96" fill="#1b1d21"/><path d="M21 69h54L61 48 49 61 39 41z" fill="#2c2f35"/><circle cx="36" cy="30" r="8" fill="#8a6f1a"/></svg>`);

const getQualityMeta = (quality: string) => QUALITY_META[quality as Quality];
const getContrastText = (hex: string) => {
  const value = hex.replace('#', '');
  const rgb = [0, 2, 4].map((index) => Number.parseInt(value.slice(index, index + 2), 16) / 255);
  const luminance = rgb.map((channel) => channel <= 0.03928 ? channel / 12.92 : ((channel + 0.055) / 1.055) ** 2.4)
    .reduce((sum, channel, index) => sum + channel * [0.2126, 0.7152, 0.0722][index], 0);
  return luminance > 0.45 ? '#131416' : '#f5f2eb';
};

const gain = item.gain;
---

<BaseLayout title={`${item.name}磨尖`} description={`${item.name}磨尖等级、伤害与成功率`}>
  <Breadcrumb items={[
    { label: '首页', href: '/' },
    { label: '磨尖武器', href: '/sharpen' },
    { label: item.name },
  ]} />

  <section class="page-heading">
    <p class="eyebrow">磨尖武器</p>
    <h1>{item.name}</h1>
    <p class="muted">从白板到磨5，伤害提升 {gain}</p>
  </section>

  <section class="panel sharpen-summary">
    <p>各级成功率独立判定，失败不会累积到下一次。</p>
    <a href={`/weapons/${item.weaponId}`}>查看「{item.name}」武器详情</a>
  </section>

  <section class="section" aria-labelledby="sharpen-levels-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">等级数据</p>
        <h2 id="sharpen-levels-title">磨尖等级</h2>
      </div>
    </div>

    <div class="sharpen-level-grid">
      {item.levels.map((level) => {
        const qualityMeta = getQualityMeta(level.quality);
        const qualityStyle = `--quality-border:${qualityMeta.border};--quality-glow:${qualityMeta.glow}`;
        const badgeStyle = `background:${qualityMeta.border};color:${getContrastText(qualityMeta.border)}`;
        return (
          <article class="sharpen-level-card">
            <div class="sharpen-level-icon-wrap">
              <img
                class="item-icon quality-icon sharpen-level-icon"
                src={getItemIconSrc('sharpen', item)}
                alt={`${item.name}${level.level ? `磨${level.level}` : ''}`}
                loading="lazy"
                style={qualityStyle}
                data-fallback={fallback}
                onerror="this.onerror=null;this.src=this.dataset.fallback;this.classList.add('is-missing')"
              />
              {level.level > 0 && <span class="sharpen-level-badge" style={badgeStyle}>磨{level.level}</span>}
            </div>
            <p class="sharpen-level-stat sharpen-level-damage">伤害 {level.damage}</p>
            {level.successRate !== null && <p class="sharpen-level-stat sharpen-level-success">成功率 {level.successRate}%</p>}
          </article>
        );
      })}
    </div>
  </section>
</BaseLayout>
