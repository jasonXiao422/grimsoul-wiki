---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DetailPanel from '../../components/DetailPanel.astro';
import { CATEGORIES } from '../../lib/categories';
import { DATA_BY_CATEGORY, getListItems, type CategorySlug } from '../../lib/data';

export function getStaticPaths() {
  return CATEGORIES.flatMap((category) => (
    getListItems(category.slug as CategorySlug).map((item) => ({
      params: { category: category.slug, id: item.id },
      props: { category, item },
    }))
  ));
}

const { category, item } = Astro.props;
---

<BaseLayout title={item.name} description={`${item.name}详细资料`}>
  <DetailPanel categorySlug={category.slug as keyof typeof DATA_BY_CATEGORY} item={item} />
</BaseLayout>
