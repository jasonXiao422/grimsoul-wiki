---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import DataTable from '../../components/DataTable.astro';
import ListScrollRestoration from '../../components/ListScrollRestoration.astro';
import { CATEGORIES } from '../../lib/categories';
import { getCategoryBlurb, getListItems, type CategorySlug } from '../../lib/data';

export function getStaticPaths() {
  return CATEGORIES.filter((category) => category.slug !== 'orders').map((category) => ({
    params: { category: category.slug },
    props: {
      category,
      items: getListItems(category.slug as CategorySlug),
    },
  }));
}

const { category, items } = Astro.props;
---

<BaseLayout title={category.label} description={`${category.label}资料列表`}>
  <Breadcrumb items={[
    { label: '首页', href: '/' },
    { label: category.label },
  ]} />

  <section class="page-heading">
    <p class="eyebrow">资料列表</p>
    <h1>{category.label}</h1>
    <p class="muted">{getCategoryBlurb(category.slug as CategorySlug)}</p>
  </section>

  <DataTable category={category} items={items} />
  <ListScrollRestoration />
</BaseLayout>
