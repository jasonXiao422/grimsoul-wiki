---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import DataTable from '../../components/DataTable.astro';
import ListScrollRestoration from '../../components/ListScrollRestoration.astro';
import { ARMOR_PIECES_TABLE, CATEGORIES } from '../../lib/categories';
import { EXTRA_DATA, getCategoryBlurb, getListItems, type CategorySlug } from '../../lib/data';

export function getStaticPaths() {
  return CATEGORIES.filter((category) => !['orders', 'cabinets', 'surface-chests'].includes(category.slug)).map((category) => ({
    params: { category: category.slug },
    props: {
      category,
      items: getListItems(category.slug as CategorySlug),
    },
  }));
}

const { category, items } = Astro.props;
const armorPieces = category.slug === 'armor'
  ? [...EXTRA_DATA['armor-pieces']].sort((a, b) => a.armor - b.armor || a.name.localeCompare(b.name, 'zh-Hans-CN'))
  : [];
const isArmor = category.slug === 'armor';
---

<BaseLayout title={category.label} description={`${category.label}资料列表`}>
  <ListScrollRestoration slot="head" />

  <Breadcrumb items={[
    { label: '首页', href: '/' },
    { label: category.label },
  ]} />

  <section class="page-heading">
    <p class="eyebrow">资料列表</p>
    <h1>{category.label}</h1>
    <p class="muted">{getCategoryBlurb(category.slug as CategorySlug)}</p>
  </section>

  {isArmor ? (
    <>
      <div class="armor-page-tools">
        <label>
          <span class="sr-only">搜索护甲</span>
          <input class="search-input" type="search" data-armor-search placeholder="搜索护甲" />
        </label>
        <label>
          <span class="sr-only">护甲类型</span>
          <select class="filter-select" data-armor-type>
            <option value="all">全部</option>
            <option value="sets">套装</option>
            <option value="pieces">散件</option>
          </select>
        </label>
      </div>

      <section class="armor-section" data-armor-section="sets" aria-labelledby="armor-sets-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">成套护甲</p>
            <h2 id="armor-sets-title">套装</h2>
          </div>
          <span class="muted">{items.length} 套</span>
        </div>
        <DataTable category={category} items={items} externalSearchSelector="[data-armor-search]" />
      </section>

      <section class="armor-section armor-pieces-section" data-armor-section="pieces" aria-labelledby="armor-pieces-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">单件护甲</p>
            <h2 id="armor-pieces-title">散件</h2>
          </div>
          <span class="muted">{armorPieces.length} 件</span>
        </div>
        <DataTable category={ARMOR_PIECES_TABLE} items={armorPieces} externalSearchSelector="[data-armor-search]" />
      </section>
    </>
  ) : (
    <DataTable category={category} items={items} />
  )}
</BaseLayout>

{isArmor && (
  <script>
    const typeFilter = document.querySelector<HTMLSelectElement>('[data-armor-type]');
    const sections = [...document.querySelectorAll<HTMLElement>('[data-armor-section]')];

    typeFilter?.addEventListener('change', () => {
      const value = typeFilter.value;
      sections.forEach((section) => {
        section.hidden = value !== 'all' && section.dataset.armorSection !== value;
      });
    });
  </script>
)}
