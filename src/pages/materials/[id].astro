---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import DetailPanel from '../../components/DetailPanel.astro';
import materials from '../../data/materials.json';
import { getEntityCategoryLabel, getEntityHref, getRecipeUsages } from '../../lib/data';

export function getStaticPaths() {
  return materials.map((item) => ({
    params: { id: item.id },
    props: { item, usages: getRecipeUsages(item.id) },
  }));
}

const { item, usages } = Astro.props;
const entityHref = getEntityHref(item.entity);
const entityLabel = getEntityCategoryLabel(item.entity);
---

<BaseLayout title={item.name} description={`${item.name}来源与用途`}>
  <Breadcrumb items={[
    { label: '首页', href: '/' },
    { label: '材料', href: '/materials' },
    { label: item.name },
  ]} />

  {entityHref && (
    <section class="material-entity-link panel" aria-label="关联条目">
      <a href={entityHref}>这也是一件{entityLabel} →</a>
    </section>
  )}

  <DetailPanel categorySlug="materials" item={item} attributeTitle="相关配方数量">
    {typeof item.description === 'string' && item.description.trim() && (
      <section class="section panel material-description">
        <h2 class="detail-panel-title">材料介绍</h2>
        <p class="material-description-text">{item.description}</p>
      </section>
    )}
  </DetailPanel>

  <section class="section panel">
    <h2>哪些配方用到这个材料</h2>
    {usages.length > 0 ? (
      <ul class="usage-list recipe-list">
        {usages.map((usage) => (
          <li>
            <a href={usage.href}>
              <span>
                <strong>{usage.name}</strong>
                <span class="muted">（{usage.categoryLabel}，{usage.source}）</span>
              </span>
              <span class="qty">×{usage.qty}</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="muted">当前没有配方使用这个材料。</p>
    )}
  </section>
</BaseLayout>
