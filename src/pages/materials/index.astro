---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DataTable from '../../components/DataTable.astro';
import { CATEGORY_BY_SLUG } from '../../lib/categories';
import { getListItems } from '../../lib/data';

const category = CATEGORY_BY_SLUG.materials;
const items = getListItems('materials');
---

<BaseLayout title="材料" description="材料资料列表">
  <section class="page-heading">
    <p class="eyebrow">资料列表</p>
    <h1>材料</h1>
    <p class="muted">{category.blurb}</p>
  </section>

  <DataTable category={category} items={items} />
</BaseLayout>
