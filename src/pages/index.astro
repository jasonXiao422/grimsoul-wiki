---
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryCard from '../components/EntryCard.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../lib/categories';
import { getCategoryBlurb, getCategoryCount, type CategorySlug } from '../lib/data';
import knightOrders from '../data/knight-orders.json';
import armor from '../data/armor.json';
import armorPieces from '../data/armor-pieces.json';
import boxes from '../data/boxes.json';

const loreCount = (await getCollection('lore')).length;
const tipsCount = (await getCollection('tips')).length;
const orderCount = knightOrders.length;

const categoryCards = CATEGORIES.map((category) => ({
  ...category,
  href: `/${category.slug}`,
  blurb: getCategoryBlurb(category.slug as CategorySlug),
  badge: category.slug === 'armor'
    ? `${armor.length} 套 + ${armorPieces.length} 件`
    : `${getCategoryCount(category.slug as CategorySlug)} 条`,
}));

// 最近更新区块只维护类别 slug；卡片内容与资料入口统一从现有类别配置和数据生成。
const RECENT_UPDATES = ['fixed-buildings'] as const;
const recentUpdateCards = RECENT_UPDATES.flatMap((slug) => {
  const card = categoryCards.find((entry) => entry.slug === slug);
  return card ? [card] : [];
});

const entryCards = [
  ...categoryCards,
  {
    slug: 'horse-guide',
    label: '马匹机制',
    blurb: '饱食度、升级消耗与交易价格',
    href: '/guides/horse',
    badge: '机制攻略',
  },
  {
    slug: 'armor-guide',
    label: '护甲与减伤',
    blurb: '护甲值与减伤的换算关系',
    href: '/guides/armor',
    badge: '机制攻略',
  },
  {
    slug: 'boxes',
    label: '武器盒子',
    blurb: '普通、稀有、独特与传奇盒子掉落',
    href: '/boxes',
    badge: `${boxes.length} 个盒子`,
  },
  {
    slug: 'lore',
    label: '背景故事',
    blurb: '世界背景、历史与未解之谜',
    href: '/lore',
    badge: `${loreCount} 篇`,
  },
  {
    slug: 'orders',
    label: '骑士团',
    blurb: '骑士团的起源、职责与最终命运',
    href: '/orders',
    badge: `${orderCount} 支`,
  },
  {
    slug: 'tips',
    label: '攻略Tips',
    blurb: '玩家投稿的文章与视频攻略',
    href: '/tips',
    badge: `${tipsCount} 篇`,
  },
];

const heroHoldMs = 6000;
const heroFadeMs = 1500;
const heroImageModules = import.meta.glob('/public/images/hero/bg-*.webp', { eager: true });
const getHeroImageNumber = (path: string) => Number(path.match(/bg-(\d+)\.webp$/)?.[1] ?? 0);
const heroImages = Object.keys(heroImageModules)
  .sort((a, b) => getHeroImageNumber(a) - getHeroImageNumber(b) || a.localeCompare(b))
  .map((path, index) => ({
    src: path.replace(/^\/public/, ''),
    isFirst: index === 0,
    isTopAligned: [1, 4].includes(getHeroImageNumber(path)),
  }));
---

<BaseLayout title="首页" description="Grim Soul 中文攻略资料站">
  <section
    class="hero"
    data-hero-slideshow
    data-hero-hold={heroHoldMs}
    data-hero-fade={heroFadeMs}
    style={`--hero-fade-duration: ${heroFadeMs}ms`}
  >
    <div class="hero-media" aria-hidden="true">
      {heroImages.map((image) => (
        <img
          class:list={['hero-image', { 'is-active': image.isFirst, 'is-top-aligned': image.isTopAligned }]}
          src={image.src}
          data-hero-image
          loading={image.isFirst ? 'eager' : 'lazy'}
          fetchpriority={image.isFirst ? 'high' : undefined}
          decoding="async"
          alt=""
        />
      ))}
    </div>
    <div class="hero-content">
      <h1>冷酷灵魂：黑暗幻想生存</h1>
      <p class="hero-tagline">在瘟疫之地活得更久</p>
      <p class="hero-description">汇总装备与制作材料、符文卷轴、护符、敌人和背景故事资料，方便中文玩家快速查找属性、效果、配方、出没地点与世界线索。</p>
    </div>
  </section>

  <section>
    <h2 class="home-section-title">最近更新</h2>
    <div class="grid">
      {recentUpdateCards.map((card) => (
        <EntryCard {...card} />
      ))}
    </div>
  </section>

  <section>
    <h2 class="home-section-title">资料入口</h2>
    <div class="grid">
      {entryCards.map((category) => (
        <EntryCard {...category} />
      ))}
    </div>
  </section>

  <script>
    const hero = document.querySelector('[data-hero-slideshow]');

    if (hero) {
      const images = Array.from(hero.querySelectorAll<HTMLImageElement>('[data-hero-image]'));
      const hold = Number(hero.getAttribute('data-hero-hold') || '6000');
      const fade = Number(hero.getAttribute('data-hero-fade') || '1500');
      const reduceMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
      let activeIndex = 0;
      let timer = 0;

      const activate = (index) => {
        activeIndex = index;
        images.forEach((image, imageIndex) => {
          image.classList.toggle('is-active', imageIndex === index);
        });
      };

      const loadedIndexes = () =>
        images
          .map((image, index) => ({ image, index }))
          .filter(({ image }) => image.dataset.failed !== 'true' && image.dataset.loaded === 'true')
          .map(({ index }) => index);

      const stop = () => {
        if (timer) {
          window.clearTimeout(timer);
          timer = 0;
        }
        activate(0);
      };

      const showNext = () => {
        const availableIndexes = loadedIndexes();

        if (availableIndexes.length < 2) {
          return;
        }

        const currentPosition = availableIndexes.indexOf(activeIndex);
        const nextPosition = currentPosition === -1 ? 0 : (currentPosition + 1) % availableIndexes.length;
        activate(availableIndexes[nextPosition]);
      };

      const scheduleNext = (delay) => {
        timer = window.setTimeout(() => {
          showNext();
          scheduleNext(hold + fade);
        }, delay);
      };

      const start = () => {
        stop();

        if (reduceMotionQuery.matches) {
          return;
        }

        scheduleNext(hold);
      };

      images.forEach((image, index) => {
        const markLoaded = () => {
          if (image.naturalWidth > 0) {
            image.dataset.loaded = 'true';
          }
        };

        if (image.complete) {
          markLoaded();
        }

        image.addEventListener('load', markLoaded);
        image.addEventListener('error', () => {
          image.dataset.failed = 'true';
          image.hidden = true;

          if (index === activeIndex) {
            const [nextIndex = 0] = loadedIndexes();
            activate(nextIndex);
          }
        });
      });

      start();
      reduceMotionQuery.addEventListener('change', start);
    }
  </script>
</BaseLayout>
