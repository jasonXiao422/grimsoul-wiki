---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import MaterialCostList from '../../components/MaterialCostList.astro';
import surfaceChests from '../../data/surface-chests.json';

const fallback =
  'data:image/svg+xml;charset=utf-8,' +
  encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 96 96"><rect width="96" height="96" fill="#1b1d21"/><path d="M21 69h54L61 48 49 61 39 41z" fill="#2c2f35"/><circle cx="36" cy="30" r="8" fill="#8a6f1a"/></svg>`);

export function getStaticPaths() {
  return surfaceChests.map((chest) => ({
    params: { id: chest.id },
    props: { chest },
  }));
}

const { chest } = Astro.props;
---

<BaseLayout title={chest.name} description={`${chest.name}详细资料`}>
  <Breadcrumb items={[
    { label: '首页', href: '/' },
    { label: '地表箱子', href: '/surface-chests' },
    { label: chest.name },
  ]} />

  <section class="cabinet-detail-hero panel">
    <div class="cabinet-detail-image-wrap">
      <img
        class="cabinet-detail-image"
        src={`/images/surface-chests/${chest.id}.webp`}
        alt={chest.name}
        data-fallback={fallback}
        onerror="this.onerror=null;this.src=this.dataset.fallback;this.classList.add('is-missing')"
      />
    </div>
    <div>
      <p class="eyebrow">建筑资料</p>
      <h1>{chest.name}</h1>
      <p class="muted">地点：{chest.location}</p>
    </div>
  </section>

  <section class="cabinet-levels" aria-label="地表箱子等级信息">
    {chest.levels.map((level) => (
      <article class="cabinet-level panel">
        <h2>{level.level}</h2>
        <dl class="cabinet-level-stats">
          <div><dt>储存空间</dt><dd>{level.capacity}</dd></div>
        </dl>
        <h3>组装材料</h3>
        <MaterialCostList cost={level.cost} compact />
      </article>
    ))}
  </section>
</BaseLayout>
