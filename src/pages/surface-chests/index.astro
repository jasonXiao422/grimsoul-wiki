---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import surfaceChests from '../../data/surface-chests.json';

const fallback =
  'data:image/svg+xml;charset=utf-8,' +
  encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 96 96"><rect width="96" height="96" fill="#1b1d21"/><path d="M21 69h54L61 48 49 61 39 41z" fill="#2c2f35"/><circle cx="36" cy="30" r="8" fill="#8a6f1a"/></svg>`);
---

<BaseLayout title="地表箱子" description={`${surfaceChests.length} 个地表箱子资料`}>
  <Breadcrumb items={[
    { label: '首页', href: '/' },
    { label: '地表箱子' },
  ]} />

  <section class="page-heading">
    <p class="eyebrow">建筑资料</p>
    <h1>地表箱子</h1>
    <p class="muted">整理{surfaceChests.length}个地表箱子的储存空间与组装材料。</p>
  </section>

  <div class="cabinets-grid">
    {surfaceChests.map((chest) => (
      <a class="cabinet-card" href={`/surface-chests/${chest.id}`}>
        <div class="cabinet-card-image">
          <img
            class="cabinet-card-icon"
            src={`/images/surface-chests-location/${chest.id}.webp`}
            alt={chest.location}
            loading="lazy"
            data-fallback={fallback}
            onerror="this.onerror=null;this.src=this.dataset.fallback;this.classList.add('is-missing')"
          />
        </div>
        <strong class="cabinet-card-name">{chest.location}</strong>
      </a>
    ))}
  </div>
</BaseLayout>
