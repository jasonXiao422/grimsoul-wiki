---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import skills from '../../../data/skills.json';
import { getSkillCategoryId } from '../../../lib/skills';
import { QUALITY_META, type Quality } from '../../../lib/quality';

export function getStaticPaths() {
  return skills.map((skill) => ({
    params: { category: getSkillCategoryId(skill.category), id: skill.id },
    props: { skill },
  }));
}

const { skill } = Astro.props;
const levelQuality = (level: number): Quality => level <= 2 ? 'common' : level <= 6 ? 'rare' : level <= 10 ? 'unique' : 'legendary';
const categoryColor = skill.categoryColor;
const fallback =
  'data:image/svg+xml;charset=utf-8,' +
  encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 96 96"><rect width="96" height="96" fill="#1b1d21"/><path d="M21 69h54L61 48 49 61 39 41z" fill="#2c2f35"/><circle cx="36" cy="30" r="8" fill="#8a6f1a"/></svg>`);
---

<BaseLayout title={skill.name} description={`${skill.name}技能详情`}>
  <Breadcrumb items={[{ label: '首页', href: '/' }, { label: '技能', href: '/skills' }, { label: skill.category, href: `/skills/${getSkillCategoryId(skill.category)}` }, { label: skill.name }]} />

  <section class="cabinet-detail-hero panel skill-detail-hero">
    <div class="cabinet-detail-image-wrap">
      <img
        class="cabinet-detail-image quality-icon"
        src={`/images/skills/${skill.id}.webp`}
        alt={skill.name}
        style={`--quality-border:${categoryColor};--quality-glow:${categoryColor}`}
        data-fallback={fallback}
        onerror="this.onerror=null;this.src=this.dataset.fallback;this.classList.add('is-missing')"
      />
    </div>
    <div>
      <p class="eyebrow">技能资料</p>
      <h1 style={`color:${categoryColor}`}>{skill.name}</h1>
      <span class="tag" style={`color:${categoryColor};border-color:${categoryColor}`}>{skill.category}</span>
    </div>
  </section>

  <section class="skill-level-list panel">
    <h2>等级效果</h2>
    <dl>
      {skill.levels.map((level) => {
        const quality = QUALITY_META[levelQuality(level.level)];
        return <div><dt>Lv{level.level}</dt><dd style={`color:${quality.text}`}>{level.value}</dd></div>;
      })}
    </dl>
  </section>

  <section class="skill-drop-panel panel">
    <h2>掉落地点</h2>
    <p>{skill.dropLocationsRaw || '暂无记录'}</p>
  </section>
</BaseLayout>
