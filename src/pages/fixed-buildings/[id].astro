---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ImageZoom from '../../components/ImageZoom.astro';
import MaterialCostList from '../../components/MaterialCostList.astro';
import fixedBuildings from '../../data/fixed-buildings.json';
import { BUILDING_CONCEPTS } from '../../lib/building-concepts';
import { getItemIconSrc } from '../../lib/data';
import { QUALITY_META, type Quality } from '../../lib/quality';

export function getStaticPaths() {
  return fixedBuildings.map((building) => ({ params: { id: building.id }, props: { building } }));
}

const { building } = Astro.props;
const buildingConcepts = BUILDING_CONCEPTS[building.id] ?? [];
const quality = typeof building.quality === 'string' && building.quality in QUALITY_META
  ? QUALITY_META[building.quality as Quality]
  : QUALITY_META.common;
const qualityStyle = `--quality-border:${quality.border};--quality-glow:${quality.glow}`;
const hasValue = (value: unknown) => value !== null && value !== undefined && value !== '' && value !== '无';
const hasBuildCost = building.buildCostPending || building.buildCost.length > 0;
const hasAssembleCost = building.assembleCostPending || building.assembleCost.length > 0;
---

<BaseLayout title={building.name} description={`${building.name}详细资料`}>
  <Breadcrumb items={[{ label: '首页', href: '/' }, { label: '不可升级建筑', href: '/fixed-buildings' }, { label: building.name }]} />

  <section class="fixed-building-detail-hero panel">
    <div class="fixed-building-detail-image-wrap">
      <ImageZoom
        src={getItemIconSrc('fixed-buildings', building)}
        alt={building.name}
        class="fixed-building-detail-image quality-icon"
        style={qualityStyle}
      />
    </div>
    <div>
      <h1 style={`color:${quality.text}`}>{building.name}</h1>
      <div class="tag-list fixed-building-detail-tags">{building.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
      <dl class="fixed-building-summary">
        {hasValue(building.castlePoints) && <div class="tag fixed-building-summary-item"><dt class="eyebrow">城堡点数</dt><dd>{building.castlePoints}</dd></div>}
        {hasValue(building.capacity) && <div class="tag fixed-building-summary-item"><dt class="eyebrow">储存空间</dt><dd>{building.capacity}</dd></div>}
        {hasValue(building.maxCount) && <div class="tag fixed-building-summary-item fixed-building-max-count"><dt class="eyebrow">最多建造数量</dt><dd style="color:var(--accent)">{building.maxCount}</dd></div>}
      </dl>
    </div>
  </section>

  {hasValue(building.purpose) && <section class="fixed-building-purpose panel"><h2>用途</h2><p>{building.purpose}</p></section>}
  {hasValue(building.blueprintSource) && <section class="fixed-building-blueprint panel"><h2>图纸掉落地点</h2><p>{building.blueprintSource}</p></section>}

  <div class="fixed-building-cost-grid">
    {hasBuildCost && <section class="panel fixed-building-cost-panel"><h2>建造材料</h2>{building.buildCostPending ? <p class="muted">配方待补充</p> : <MaterialCostList cost={building.buildCost} compact />}</section>}
    {hasAssembleCost && <section class="panel fixed-building-cost-panel"><h2>组装材料</h2>{building.assembleCostPending ? <p class="muted">配方待补充</p> : <MaterialCostList cost={building.assembleCost} compact />}</section>}
  </div>
  {buildingConcepts.length > 0 && (
    <section class="enemy-concepts section panel">
      <h2 class="detail-panel-title">建筑原画</h2>
      <div class="enemy-concepts-list">
        {buildingConcepts.map((concept) => (
          <figure class="enemy-concept">
            <ImageZoom
              src={`/images/concepts/${concept.file}`}
              alt={concept.caption}
              class="enemy-concept-image"
            />
            <figcaption class="enemy-concept-caption">
              <span>{concept.caption}</span>
              {concept.creditUrl ? (
                <a
                  class="enemy-concept-credit"
                  href={concept.creditUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {concept.credit}
                </a>
              ) : (
                <span class="enemy-concept-credit">{concept.credit}</span>
              )}
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
