---
import '../styles/global.css';
import SearchBox from '../components/SearchBox.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Grim Soul 中文攻略资料站' } = Astro.props;
const currentPath = Astro.url.pathname;
const equipmentNavItems = [
  { label: '武器', href: '/weapons' },
  { label: '磨尖武器', href: '/sharpen' },
  { label: '护甲', href: '/armor' },
  { label: '驮篮', href: '/backpacks' },
  { label: '盾牌', href: '/shields' },
];
const scrollNavItems = [
  { label: '卷轴', href: '/scrolls' },
  { label: '符文', href: '/runes' },
];
const withActiveState = (items: Array<{ label: string; href: string }>) =>
  items.map((item) => ({ ...item, active: currentPath.startsWith(item.href) }));
const equipmentItems = withActiveState(equipmentNavItems);
const scrollItems = withActiveState(scrollNavItems);
const consumablesNavItem = { label: '食物&药剂', href: '/consumables', active: currentPath.startsWith('/consumables') };
const otherNavItems = [
  {
    label: '材料',
    href: '/materials',
    active: currentPath.startsWith('/materials'),
  },
  {
    label: '马匹机制',
    href: '/guides/horse',
    active: currentPath.startsWith('/guides/horse'),
  },
  {
    label: '护甲与减伤',
    href: '/guides/armor',
    active: currentPath.startsWith('/guides/armor'),
  },
];
const isOtherNavActive = otherNavItems.some((item) => item.active);
const isEquipmentNavActive = equipmentItems.some((item) => item.active);
const isScrollNavActive = scrollItems.some((item) => item.active);
interface Contributor {
  name: string;
  url?: string;
}

const CONTRIBUTORS: Array<{ group: string; people: Contributor[] }> = [
  {
    group: '网站贡献',
    people: [
      { name: 'JokerAF-安枫', url: 'https://space.bilibili.com/402585650' },
      { name: '浪里白花小飞龙', url: 'https://space.bilibili.com/310337826' },
      { name: '情义常少', url: 'https://space.bilibili.com/505467311' },
    ],
  },
  {
    group: '数据贡献',
    people: [
      { name: '林林子呀', url: 'https://space.bilibili.com/3494358919678209' },
      { name: '芙桃不傲娇', url: 'https://space.bilibili.com/483430426' },
      { name: '旋转青桃', url: 'https://space.bilibili.com/416097645' },
      { name: '长夜漫漫-无心睡眠', url: 'https://space.bilibili.com/405471736' },
      { name: 'MeowthGS', url: 'https://space.bilibili.com/198479610' },
      { name: '莫小染es', url: 'https://space.bilibili.com/1901808438' },
      { name: '秋风凛凛月依依', url: 'https://space.bilibili.com/1565954819' },
      { name: 'noxpeb', url: 'https://space.bilibili.com/487528348' },
    ],
  },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <slot name="head" />
    <meta name="description" content={description} />
    <title>{title} | Grim Soul 中文攻略站</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header" data-site-header>
        <div class="header-inner">
          <a class="brand" href="/">Grim Soul 中文攻略站</a>
          <button class="nav-menu-toggle" type="button" data-nav-menu-toggle aria-expanded="false" aria-controls="main-navigation">
            <span aria-hidden="true"></span>
            <span class="sr-only">打开主导航</span>
          </button>
          <nav class="main-nav" id="main-navigation" data-main-nav aria-label="主导航">
            <div class="nav-dropdown" data-nav-dropdown>
              <button
                class="nav-dropdown-toggle"
                type="button"
                data-nav-dropdown-toggle
                aria-expanded="false"
                aria-controls="equipment-nav-menu"
                aria-current={isEquipmentNavActive ? 'page' : undefined}
              >
                装备数据
              </button>
              <div class="nav-dropdown-menu" id="equipment-nav-menu" data-nav-dropdown-menu>
                {equipmentItems.map((item) => (
                  <a href={item.href} aria-current={item.active ? 'page' : undefined}>{item.label}</a>
                ))}
              </div>
            </div>
            <div class="nav-dropdown" data-nav-dropdown>
              <button
                class="nav-dropdown-toggle"
                type="button"
                data-nav-dropdown-toggle
                aria-expanded="false"
                aria-controls="scroll-nav-menu"
                aria-current={isScrollNavActive ? 'page' : undefined}
              >
                符文&卷轴
              </button>
              <div class="nav-dropdown-menu" id="scroll-nav-menu" data-nav-dropdown-menu>
                {scrollItems.map((item) => (
                  <a href={item.href} aria-current={item.active ? 'page' : undefined}>{item.label}</a>
                ))}
              </div>
            </div>
            <a href={consumablesNavItem.href} aria-current={consumablesNavItem.active ? 'page' : undefined}>{consumablesNavItem.label}</a>
            <a href="/amulets" aria-current={currentPath.startsWith('/amulets') ? 'page' : undefined}>护符</a>
            <a href="/enemies" aria-current={currentPath.startsWith('/enemies') ? 'page' : undefined}>敌人</a>
            <a href="/lore" aria-current={currentPath.startsWith('/lore') ? 'page' : undefined}>背景故事</a>
            <div class="nav-dropdown" data-nav-dropdown>
              <button
                class="nav-dropdown-toggle"
                type="button"
                data-nav-dropdown-toggle
                aria-expanded="false"
                aria-controls="other-nav-menu"
                aria-current={isOtherNavActive ? 'page' : undefined}
              >
                其他
              </button>
              <div class="nav-dropdown-menu" id="other-nav-menu" data-nav-dropdown-menu>
                {otherNavItems.map((item) => (
                  <a href={item.href} aria-current={item.active ? 'page' : undefined}>{item.label}</a>
                ))}
              </div>
            </div>
          </nav>
          <SearchBox />
        </div>
      </header>

      <main class="main-content">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="footer-inner">
          <div class="footer-contributors" aria-labelledby="footer-contributors-title">
            <h2 id="footer-contributors-title">贡献者</h2>
            <div class="footer-contributor-groups">
              {CONTRIBUTORS.map((group) => (
                <section class="footer-contributor-group" aria-labelledby={`footer-contributor-${group.group}`}>
                  <h3 id={`footer-contributor-${group.group}`}>{group.group}</h3>
                  <p class="footer-contributor-links">
                    {group.people.map((contributor) => (
                      contributor.url ? (
                        <a href={contributor.url} target="_blank" rel="noopener noreferrer">{contributor.name}</a>
                      ) : (
                        contributor.name
                      )
                    ))}
                  </p>
                </section>
              ))}
            </div>
          </div>
          <div class="footer-contact" aria-labelledby="footer-contact-title">
            <h2 id="footer-contact-title">联系方式</h2>
            <p>冷酷灵魂正版QQ群：905629612</p>
            <p>邮箱：<a href="mailto:jason030422@outlook.com">jason030422@outlook.com</a></p>
          </div>
          <p>本站为玩家自制非官方攻略站，与 Brickworks Games Ltd. 无隶属关系。</p>
          <p>游戏素材版权归原作者所有。</p>
        </div>
      </footer>
    </div>
    <script>
      const menuToggle = document.querySelector<HTMLButtonElement>('[data-nav-menu-toggle]');
      const siteHeader = document.querySelector<HTMLElement>('[data-site-header]');
      const mainNav = document.querySelector<HTMLElement>('[data-main-nav]');
      const dropdowns = [...document.querySelectorAll<HTMLElement>('[data-nav-dropdown]')];

      const setMenuOpen = (open: boolean) => {
        mainNav?.classList.toggle('is-open', open);
        menuToggle?.setAttribute('aria-expanded', String(open));
      };

      const setDropdownOpen = (dropdown: HTMLElement, open: boolean) => {
        dropdown.classList.toggle('is-open', open);
        dropdown.querySelector<HTMLButtonElement>('[data-nav-dropdown-toggle]')?.setAttribute('aria-expanded', String(open));
      };

      const focusDropdownItem = (dropdown: HTMLElement, index: number) => {
        const links = [...dropdown.querySelectorAll<HTMLAnchorElement>('[data-nav-dropdown-menu] a')];
        if (links.length === 0) return;
        links[(index + links.length) % links.length]?.focus();
      };

      const updateHeaderHeight = () => {
        if (!siteHeader) return;
        document.documentElement.style.setProperty('--header-height', `${siteHeader.offsetHeight}px`);
      };

      updateHeaderHeight();
      window.addEventListener('resize', updateHeaderHeight);
      if ('ResizeObserver' in window && siteHeader) {
        new ResizeObserver(updateHeaderHeight).observe(siteHeader);
      }

      menuToggle?.addEventListener('click', () => {
        setMenuOpen(!mainNav?.classList.contains('is-open'));
      });

      dropdowns.forEach((dropdown) => {
        const dropdownToggle = dropdown.querySelector<HTMLButtonElement>('[data-nav-dropdown-toggle]');
        const dropdownMenu = dropdown.querySelector<HTMLElement>('[data-nav-dropdown-menu]');

        dropdownToggle?.addEventListener('click', () => {
          const open = !dropdown.classList.contains('is-open');
          dropdowns.forEach((other) => setDropdownOpen(other, other === dropdown && open));
        });

        dropdownToggle?.addEventListener('keydown', (event) => {
          if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
          event.preventDefault();
          setDropdownOpen(dropdown, true);
          const links = [...dropdown.querySelectorAll<HTMLAnchorElement>('[data-nav-dropdown-menu] a')];
          focusDropdownItem(dropdown, event.key === 'ArrowDown' ? 0 : links.length - 1);
        });

        dropdownMenu?.addEventListener('keydown', (event) => {
          if (!(event.target instanceof HTMLAnchorElement)) return;
          const links = [...dropdown.querySelectorAll<HTMLAnchorElement>('[data-nav-dropdown-menu] a')];
          const currentIndex = links.indexOf(event.target);
          if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
            event.preventDefault();
            focusDropdownItem(dropdown, currentIndex + (event.key === 'ArrowDown' ? 1 : -1));
          }
        });
      });

      document.addEventListener('click', (event) => {
        const target = event.target;
        if (target instanceof Node && !dropdowns.some((dropdown) => dropdown.contains(target))) {
          dropdowns.forEach((dropdown) => setDropdownOpen(dropdown, false));
        }
      });

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        dropdowns.forEach((dropdown) => setDropdownOpen(dropdown, false));
        setMenuOpen(false);
      });
    </script>
  </body>
</html>
