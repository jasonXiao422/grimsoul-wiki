---
import '../styles/global.css';
import SearchBox from '../components/SearchBox.astro';
import ImageDialog from '../components/ImageDialog.astro';
import NavLoader from '../components/NavLoader.astro';
import BgmPlayer from '../components/BgmPlayer.astro';
import { ClientRouter } from 'astro:transitions';
import { DATA_VERSION } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  detailVersion?: boolean;
}

const { title, description = 'Grim Soul 中文攻略资料站', detailVersion = false } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const pathParts = currentPath.split('/').filter(Boolean);
const detailRoots = new Set([
  'weapons',
  'armor',
  'shields',
  'backpacks',
  'amulets',
  'scrolls',
  'runes',
  'consumables',
  'enemies',
  'armor-pieces',
  'materials',
  'cabinets',
  'fixed-buildings',
  'surface-chests',
  'sharpen',
  'orders',
  'upgradable-buildings',
  'guides',
  'tips',
]);
const isDetailPath =
  (pathParts.length === 2 && detailRoots.has(pathParts[0])) ||
  (pathParts.length === 2 && pathParts[0] === 'lore' && !['side-stories', 'scrolls'].includes(pathParts[1])) ||
  (pathParts.length === 3 && ['fixed-buildings', 'skills', 'lore'].includes(pathParts[0]));
const showDataVersion = detailVersion || isDetailPath;
const equipmentNavItems = [
  { label: '武器', href: '/weapons' },
  { label: '磨尖武器', href: '/sharpen' },
  { label: '护甲', href: '/armor' },
  { label: '驮篮', href: '/backpacks' },
  { label: '盾牌', href: '/shields' },
];
const scrollNavItems = [
  { label: '卷轴', href: '/scrolls' },
  { label: '符文', href: '/runes' },
  { label: '护符', href: '/amulets' },
];
const withActiveState = (items: Array<{ label: string; href: string }>) =>
  items.map((item) => ({ ...item, active: currentPath.startsWith(item.href) }));
const equipmentItems = withActiveState(equipmentNavItems);
const scrollItems = withActiveState(scrollNavItems);
const consumablesNavItem = { label: '食物&药', href: '/consumables', active: currentPath.startsWith('/consumables') };
const skillsNavItem = { label: '技能', href: '/skills', active: currentPath.startsWith('/skills') };
const buildingNavItems = [
  { label: '柜子', href: '/cabinets', active: currentPath.startsWith('/cabinets') },
  { label: '地表箱子', href: '/surface-chests', active: currentPath.startsWith('/surface-chests') },
  { label: '不可升级建筑', href: '/fixed-buildings', active: currentPath.startsWith('/fixed-buildings') },
  { label: '可升级建筑', href: '/upgradable-buildings', active: currentPath.startsWith('/upgradable-buildings') },
];
const otherNavItems = [
  {
    label: '材料',
    href: '/materials',
    active: currentPath.startsWith('/materials'),
  },
  {
    label: '马匹机制',
    href: '/guides/horse',
    active: currentPath.startsWith('/guides/horse'),
  },
  {
    label: '护甲与减伤',
    href: '/guides/armor',
    active: currentPath.startsWith('/guides/armor'),
  },
  {
    label: '武器盒子',
    href: '/boxes',
    active: currentPath.startsWith('/boxes'),
  },
  {
    label: '攻略Tips',
    href: '/tips',
    active: currentPath.startsWith('/tips'),
  },
  {
    label: 'NPC兑换图',
    href: '/npc-exchange',
    active: currentPath.startsWith('/npc-exchange'),
  },
];
const isOtherNavActive = otherNavItems.some((item) => item.active);
const isLoreScrolls = currentPath.startsWith('/lore/scrolls');
const loreNavItems = [
  { label: '世界观', href: '/lore', active: (currentPath === '/lore' || currentPath.startsWith('/lore/')) && !isLoreScrolls },
  { label: '卷轴原文', href: '/lore/scrolls', active: isLoreScrolls },
];
const isLoreNavActive = loreNavItems.some((item) => item.active);
const isEquipmentNavActive = equipmentItems.some((item) => item.active);
const isScrollNavActive = scrollItems.some((item) => item.active);
const isBuildingNavActive = buildingNavItems.some((item) => item.active);
interface Contributor {
  name: string;
  url?: string;
}

const CONTRIBUTORS: Array<{ group: string; people: Contributor[] }> = [
  {
    group: '网站贡献',
    people: [
      { name: 'JokerAF-安枫', url: 'https://space.bilibili.com/402585650' },
    ],
  },
  {
    group: '数据贡献',
    people: [
      { name: '浪里白花小飞龙', url: 'https://space.bilibili.com/310337826' },
      { name: '林林子呀', url: 'https://space.bilibili.com/3494358919678209' },
      { name: '芙桃不傲娇', url: 'https://space.bilibili.com/483430426' },
      { name: '旋转青桃', url: 'https://space.bilibili.com/416097645' },
      { name: '长夜漫漫-无心睡眠', url: 'https://space.bilibili.com/405471736' },
      { name: 'MeowthGS', url: 'https://space.bilibili.com/198479610' },
      { name: '莫小染es', url: 'https://space.bilibili.com/1901808438' },
      { name: '秋风凛凛月依依', url: 'https://space.bilibili.com/1565954819' },
      { name: 'noxpeb', url: 'https://space.bilibili.com/487528348' },
      { name: '情义常少', url: 'https://space.bilibili.com/505467311' },
    ],
  },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <ClientRouter />
    <slot name="head" />
    <script is:inline>
      (() => {
        if (window.__onPageReady) return;
        const callbacks = new Set();
        const keyedCallbacks = new Map();
        let pageReady = false;
        const runCallbacks = () => {
          pageReady = true;
          callbacks.forEach((callback) => callback());
        };
        document.addEventListener('astro:page-load', runCallbacks);
        window.__onPageReady = (callback, key) => {
          if (key) {
            const previousCallback = keyedCallbacks.get(key);
            if (previousCallback) callbacks.delete(previousCallback);
            keyedCallbacks.set(key, callback);
          } else if (callbacks.has(callback)) {
            return;
          }
          callbacks.add(callback);
          if (pageReady) queueMicrotask(callback);
        };
      })();
    </script>
    <meta name="description" content={description} />
    <title>{title} | Grim Soul 中文攻略站</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header" data-site-header transition:name="site-header">
        <div class="header-inner">
          <a class="brand" href="/">Grim Soul 中文攻略站</a>
          <button class="nav-menu-toggle" type="button" data-nav-menu-toggle aria-expanded="false" aria-controls="main-navigation">
            <span aria-hidden="true"></span>
            <span class="sr-only">打开主导航</span>
          </button>
          <nav class="main-nav" id="main-navigation" data-main-nav aria-label="主导航">
            <div class="nav-dropdown" data-nav-dropdown>
              <button
                class="nav-dropdown-toggle"
                type="button"
                data-nav-dropdown-toggle
                aria-expanded="false"
                aria-controls="equipment-nav-menu"
                aria-current={isEquipmentNavActive ? 'page' : undefined}
              >
                装备数据
              </button>
              <div class="nav-dropdown-menu" id="equipment-nav-menu" data-nav-dropdown-menu>
                {equipmentItems.map((item) => (
                  <a href={item.href} aria-current={item.active ? 'page' : undefined}>{item.label}</a>
                ))}
              </div>
            </div>
            <div class="nav-dropdown" data-nav-dropdown>
              <button
                class="nav-dropdown-toggle"
                type="button"
                data-nav-dropdown-toggle
                aria-expanded="false"
                aria-controls="scroll-nav-menu"
                aria-current={isScrollNavActive ? 'page' : undefined}
              >
                魔法物品
              </button>
              <div class="nav-dropdown-menu" id="scroll-nav-menu" data-nav-dropdown-menu>
                {scrollItems.map((item) => (
                  <a href={item.href} aria-current={item.active ? 'page' : undefined}>{item.label}</a>
                ))}
              </div>
            </div>
            <a href={consumablesNavItem.href} aria-current={consumablesNavItem.active ? 'page' : undefined}>{consumablesNavItem.label}</a>
            <a href={skillsNavItem.href} aria-current={skillsNavItem.active ? 'page' : undefined}>{skillsNavItem.label}</a>
            <div class="nav-dropdown" data-nav-dropdown>
              <button
                class="nav-dropdown-toggle"
                type="button"
                data-nav-dropdown-toggle
                aria-expanded="false"
                aria-controls="building-nav-menu"
                aria-current={isBuildingNavActive ? 'page' : undefined}
              >
                建筑
              </button>
              <div class="nav-dropdown-menu" id="building-nav-menu" data-nav-dropdown-menu>
                {buildingNavItems.map((item) => (
                  <a href={item.href} aria-current={item.active ? 'page' : undefined}>{item.label}</a>
                ))}
              </div>
            </div>
            <a href="/enemies" aria-current={currentPath.startsWith('/enemies') ? 'page' : undefined}>敌人</a>
            <div class="nav-dropdown" data-nav-dropdown>
              <button
                class="nav-dropdown-toggle"
                type="button"
                data-nav-dropdown-toggle
                aria-expanded="false"
                aria-controls="lore-nav-menu"
                aria-current={isLoreNavActive ? 'page' : undefined}
              >
                背景故事
              </button>
              <div class="nav-dropdown-menu" id="lore-nav-menu" data-nav-dropdown-menu>
                {loreNavItems.map((item) => (
                  <a href={item.href} aria-current={item.active ? 'page' : undefined}>{item.label}</a>
                ))}
              </div>
            </div>
            <div class="nav-dropdown" data-nav-dropdown>
              <button
                class="nav-dropdown-toggle"
                type="button"
                data-nav-dropdown-toggle
                aria-expanded="false"
                aria-controls="other-nav-menu"
                aria-current={isOtherNavActive ? 'page' : undefined}
              >
                其他
              </button>
              <div class="nav-dropdown-menu" id="other-nav-menu" data-nav-dropdown-menu>
                {otherNavItems.map((item) => (
                  <a href={item.href} aria-current={item.active ? 'page' : undefined}>{item.label}</a>
                ))}
              </div>
            </div>
          </nav>
          <SearchBox />
          <div class="bgm-control" data-bgm-control>
            <button
              class="bgm-toggle"
              type="button"
              data-bgm-toggle
              transition:persist="bgm-button"
              aria-label="播放背景音乐"
              aria-pressed="false"
              title="背景音乐：Grim Soul 原声《Trader's Camp》"
            >
              <svg class="bgm-icon bgm-icon-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M4 10v4h3l4 3V7l-4 3H4z" />
                <path d="m17 9 4 6" />
                <path d="m21 9-4 6" />
              </svg>
              <svg class="bgm-icon bgm-icon-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M4 10v4h3l4 3V7l-4 3H4z" />
                <path class="bgm-wave bgm-wave-near" d="M15 9.5c1.7 1.3 1.7 3.7 0 5" />
                <path class="bgm-wave bgm-wave-far" d="M18 7c3.3 2.8 3.3 7.2 0 10" />
              </svg>
            </button>
            <button class="bgm-next-toggle" type="button" data-bgm-next aria-label="下一首" title="下一首">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M5 7v10l8-5-8-5z" />
                <path d="M18 7v10" />
              </svg>
            </button>
          </div>
        </div>
      </header>

      <slot name="hero" />

      <main class="main-content">
        <slot />
        {showDataVersion && (
          <p class="data-version-note">基于 {DATA_VERSION} 游戏资料整理</p>
        )}
      </main>

      <footer class="site-footer">
        <div class="footer-inner">
          <div class="footer-contributors" aria-labelledby="footer-contributors-title">
            <h2 id="footer-contributors-title">贡献者</h2>
            <div class="footer-contributor-groups">
              {CONTRIBUTORS.map((group) => (
                <section class="footer-contributor-group" aria-labelledby={`footer-contributor-${group.group}`}>
                  <h3 id={`footer-contributor-${group.group}`}>{group.group}</h3>
                  <p class="footer-contributor-links">
                    {group.people.map((contributor) => (
                      contributor.url ? (
                        <a href={contributor.url} target="_blank" rel="noopener noreferrer">{contributor.name}</a>
                      ) : (
                        contributor.name
                      )
                    ))}
                  </p>
                </section>
              ))}
            </div>
          </div>
          <div class="footer-contact" aria-labelledby="footer-contact-title">
            <h2 id="footer-contact-title">联系方式</h2>
            <p>冷酷灵魂正版QQ群：905629612</p>
            <p>邮箱：<a href="mailto:jason030422@outlook.com" data-astro-reload>jason030422@outlook.com</a></p>
          </div>
          <p>本站为玩家自制非官方攻略站，与 Brickworks Games Ltd. 无隶属关系。</p>
          <p>游戏素材版权归原作者所有。</p>
        </div>
      </footer>
    </div>
    <button class="back-to-top" type="button" data-back-to-top aria-label="回到顶部">
      <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false">
        <circle class="to-top-track" cx="24" cy="24" r="22" />
        <circle class="to-top-progress" cx="24" cy="24" r="22" />
        <polyline class="to-top-chevron" points="17 27 24 20 31 27" />
      </svg>
    </button>
    <ImageDialog />
    <NavLoader />
    <BgmPlayer />
    <script>
      import { onPageReady } from '../lib/lifecycle';
      import { initSourceHintListeners } from '../lib/source-hint';

      onPageReady(() => {
      try {
        initSourceHintListeners();
      } catch (error) {
        console.error('[source-hint] 初始化失败', error);
      }
      });
    </script>
    <script>
      import { onPageReady } from '../lib/lifecycle';

      const runIndependentInit = (name: string, init: () => void) => {
        try {
          init();
        } catch (error) {
          console.error(`[${name}] 初始化失败`, error);
        }
      };

      const initHeaderMeasurement = () => {
        const update = () => {
          const header = document.querySelector<HTMLElement>('[data-site-header]');
          const inner = header?.querySelector<HTMLElement>('.header-inner');
          if (!header || !inner) return;
          const firstRowHeight = Number.parseFloat(getComputedStyle(inner).gridTemplateRows.split(' ')[0] ?? '');
          const height = Number.isFinite(firstRowHeight) ? firstRowHeight + 1 : header.offsetHeight;
          document.documentElement.style.setProperty('--header-height', `${height}px`);
          document.documentElement.style.setProperty(
            '--header-bar-height',
            `${Number.isFinite(firstRowHeight) ? firstRowHeight : header.offsetHeight}px`,
          );
        };
        let frame: number | undefined;
        const schedule = () => {
          if (frame !== undefined) return;
          frame = window.requestAnimationFrame(() => {
            frame = undefined;
            update();
          });
        };
        update();
        if (!window.__grimsoulHeaderResizeListener) {
          window.__grimsoulHeaderResizeListener = true;
          window.addEventListener('resize', schedule, { passive: true });
        }
        const header = document.querySelector<HTMLElement>('[data-site-header]');
        if ('ResizeObserver' in window && header && !header.dataset.resizeObserved) {
          header.dataset.resizeObserved = 'true';
          new ResizeObserver(schedule).observe(header);
        }
      };

      const initNavigation = () => {
        if (window.__grimsoulNavigationDelegates) return;
        window.__grimsoulNavigationDelegates = true;
        const closeAll = () => {
          document.querySelector<HTMLElement>('[data-main-nav]')?.classList.remove('is-open');
          document.querySelector<HTMLButtonElement>('[data-nav-menu-toggle]')?.setAttribute('aria-expanded', 'false');
          document.querySelectorAll<HTMLElement>('[data-nav-dropdown]').forEach((dropdown) => {
            dropdown.classList.remove('is-open');
            dropdown.querySelector<HTMLButtonElement>('[data-nav-dropdown-toggle]')?.setAttribute('aria-expanded', 'false');
          });
        };
        const focusItem = (dropdown: HTMLElement, index: number) => {
          const links = [...dropdown.querySelectorAll<HTMLAnchorElement>('[data-nav-dropdown-menu] a')];
          if (links.length > 0) links[(index + links.length) % links.length]?.focus();
        };
        document.addEventListener('click', (event) => {
          try {
            const target = event.target;
            if (!(target instanceof Element)) return;
            const menuToggle = target.closest('[data-nav-menu-toggle]');
            if (menuToggle) {
              const nav = document.querySelector<HTMLElement>('[data-main-nav]');
              const open = !nav?.classList.contains('is-open');
              nav?.classList.toggle('is-open', open);
              document.querySelector<HTMLButtonElement>('[data-nav-menu-toggle]')?.setAttribute('aria-expanded', String(open));
              return;
            }
            const dropdownToggle = target.closest('[data-nav-dropdown-toggle]');
            if (dropdownToggle) {
              const dropdown = dropdownToggle.closest<HTMLElement>('[data-nav-dropdown]');
              if (!dropdown) return;
              const open = !dropdown.classList.contains('is-open');
              document.querySelectorAll<HTMLElement>('[data-nav-dropdown]').forEach((item) => {
                item.classList.toggle('is-open', item === dropdown && open);
                item.querySelector<HTMLButtonElement>('[data-nav-dropdown-toggle]')?.setAttribute('aria-expanded', String(item === dropdown && open));
              });
              return;
            }
            const nav = document.querySelector<HTMLElement>('[data-main-nav]');
            if (!nav || !nav.contains(target)) closeAll();
          } catch (error) {
            console.error('[nav]', error);
          }
        });
        document.addEventListener('keydown', (event) => {
          try {
            if (event.key === 'Escape') {
              closeAll();
              return;
            }
            const target = event.target;
            if (!(target instanceof Element)) return;
            const dropdownToggle = target.closest('[data-nav-dropdown-toggle]');
            if (dropdownToggle && (event.key === 'ArrowDown' || event.key === 'ArrowUp')) {
              event.preventDefault();
              const dropdown = dropdownToggle.closest<HTMLElement>('[data-nav-dropdown]');
              if (!dropdown) return;
              const open = !dropdown.classList.contains('is-open');
              document.querySelectorAll<HTMLElement>('[data-nav-dropdown]').forEach((item) => {
                item.classList.toggle('is-open', item === dropdown && (open || item === dropdown));
                item.querySelector<HTMLButtonElement>('[data-nav-dropdown-toggle]')?.setAttribute('aria-expanded', String(item === dropdown));
              });
              const links = [...dropdown.querySelectorAll<HTMLAnchorElement>('[data-nav-dropdown-menu] a')];
              focusItem(dropdown, event.key === 'ArrowDown' ? 0 : links.length - 1);
              return;
            }
            const link = target.closest<HTMLAnchorElement>('[data-nav-dropdown-menu] a');
            if (link && (event.key === 'ArrowDown' || event.key === 'ArrowUp')) {
              event.preventDefault();
              const dropdown = link.closest<HTMLElement>('[data-nav-dropdown]');
              if (!dropdown) return;
              const links = [...dropdown.querySelectorAll<HTMLAnchorElement>('[data-nav-dropdown-menu] a')];
              focusItem(dropdown, links.indexOf(link) + (event.key === 'ArrowDown' ? 1 : -1));
            }
          } catch (error) {
            console.error('[nav]', error);
          }
        });
        document.addEventListener('astro:after-swap', () => {
          try {
            closeAll();
          } catch (error) {
            console.error('[nav]', error);
          }
        });
      };

      const initSwapCleanup = () => {
        if (window.__grimsoulSwapCleanupListener) return;
        window.__grimsoulSwapCleanupListener = true;
        document.addEventListener('astro:after-swap', () => {
          runIndependentInit('navigation-cleanup', () => {
            try { sessionStorage.setItem('nav:in-app', '1'); } catch { /* 受限模式下忽略 */ }
            document.querySelector<HTMLElement>('[data-main-nav]')?.classList.remove('is-open');
            document.querySelector<HTMLButtonElement>('[data-nav-menu-toggle]')?.setAttribute('aria-expanded', 'false');
          });
          runIndependentInit('search-cleanup', () => {
            const results = document.querySelector<HTMLElement>('[data-global-results]');
            results?.classList.remove('is-open');
            results?.replaceChildren();
          });
          runIndependentInit('image-dialog-cleanup', () => {
            document.querySelector<HTMLDialogElement>('[data-image-dialog]')?.close();
          });
          runIndependentInit('header-measurement', initHeaderMeasurement);
        });
      };

      onPageReady(() => runIndependentInit('header-measurement', initHeaderMeasurement), 'header-measurement-independent');
      onPageReady(() => runIndependentInit('navigation', initNavigation), 'navigation-independent');
      onPageReady(() => runIndependentInit('swap-cleanup', initSwapCleanup), 'swap-cleanup-independent');
    </script>
    <script is:inline>
      (() => {
        if (window.__grimsoulBackToTopStandalone) return;
        window.__grimsoulBackToTopStandalone = true;
        try {

        const progressCircumference = 2 * Math.PI * 22;
        let updateFrame;

        const update = () => {
          updateFrame = undefined;
          const button = document.querySelector('[data-back-to-top]');
          if (!button) return;
          const progressCircle = button.querySelector('.to-top-progress');
          const maxScrollY = document.documentElement.scrollHeight - window.innerHeight;
          const hasScrollableContent = maxScrollY > 0;
          const progress = hasScrollableContent
            ? Math.min(1, Math.max(0, window.scrollY / maxScrollY))
            : 0;
          button.classList.toggle('is-visible', hasScrollableContent && window.scrollY > window.innerHeight);
          progressCircle?.style.setProperty(
            'stroke-dashoffset',
            String(progressCircumference * (1 - progress)),
          );
        };

        const scheduleUpdate = () => {
          if (updateFrame !== undefined) return;
          updateFrame = window.requestAnimationFrame(update);
        };

        window.addEventListener('scroll', scheduleUpdate, { passive: true });
        window.addEventListener('resize', scheduleUpdate, { passive: true });
        document.addEventListener('click', (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          const button = target.closest('[data-back-to-top]');
          if (!button) return;
          window.scrollTo({
            top: 0,
            left: 0,
            behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
          });
        });

        document.addEventListener('astro:page-load', update);
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', update, { once: true });
        } else {
          update();
        }
        } catch (error) {
          console.error('[back-to-top]', error);
        }
      })();
    </script>
  </body>
</html>
