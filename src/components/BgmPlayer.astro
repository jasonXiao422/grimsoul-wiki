<div class="bgm-audio-engine" data-bgm-audio-engine transition:persist="bgm">
  <audio src="/audio/bgm.mp3" loop preload="none" data-bgm-audio></audio>
</div>

<script>
  if (!window.__grimsoulBgmInitialized) {
    window.__grimsoulBgmInitialized = true;
    const audio = document.querySelector<HTMLAudioElement>('[data-bgm-audio]');

    if (audio) {
      let audioContext: AudioContext | undefined;
      let source: MediaElementAudioSourceNode | undefined;
      let gain: GainNode | undefined;
      let fadeToken = 0;
      let enabled = false;
      let waitingForGesture = false;
      let loadFailed = false;

      const getButton = () => document.querySelector<HTMLButtonElement>('[data-bgm-toggle]');
      const saveState = () => {
        try {
          localStorage.setItem('bgm:enabled', enabled ? '1' : '0');
        } catch {
          // localStorage may be unavailable in restricted browser modes.
        }
      };

      const updateButton = () => {
        const button = getButton();
        if (!button) return;
        button.setAttribute('aria-label', enabled ? '停止背景音乐' : '播放背景音乐');
        button.setAttribute('aria-pressed', String(enabled));
        button.title = loadFailed ? '音乐文件加载失败' : '背景音乐：Grim Soul 原声《Trader\'s Camp》';
        button.classList.toggle('is-playing', enabled);
      };

      const ensureAudioGraph = () => {
        if (audioContext && source && gain) return true;
        try {
          audioContext = new AudioContext();
          source = audioContext.createMediaElementSource(audio);
          gain = audioContext.createGain();
          source.connect(gain).connect(audioContext.destination);
          gain.gain.value = 0;
          return true;
        } catch {
          loadFailed = true;
          enabled = false;
          saveState();
          updateButton();
          return false;
        }
      };

      const fadeGain = (target: number, callback?: () => void) => {
        if (!gain || !audioContext) {
          callback?.();
          return;
        }
        const now = audioContext.currentTime;
        gain.gain.cancelScheduledValues(now);
        gain.gain.setValueAtTime(gain.gain.value, now);
        gain.gain.linearRampToValueAtTime(target, now + 0.6);
        if (callback) window.setTimeout(callback, 600);
      };

      const startPlayback = async () => {
        if (!enabled || !ensureAudioGraph()) return;
        fadeToken += 1;
        const token = fadeToken;
        try {
          await audioContext?.resume();
          await audio.play();
          if (token !== fadeToken || !enabled) return;
          fadeGain(1);
          waitingForGesture = false;
        } catch {
          waitingForGesture = true;
        }
      };

      const stopPlayback = () => {
        fadeToken += 1;
        const token = fadeToken;
        fadeGain(0, () => {
          if (token === fadeToken) audio.pause();
        });
      };

      const setEnabled = (nextEnabled: boolean) => {
        enabled = nextEnabled;
        loadFailed = false;
        saveState();
        updateButton();
        if (enabled) startPlayback();
        else stopPlayback();
      };

      const bindButton = () => {
        const button = getButton();
        if (!button || button.dataset.bgmBound === 'true') {
          updateButton();
          return;
        }
        button.dataset.bgmBound = 'true';
        button.addEventListener('click', () => {
          if (enabled && waitingForGesture) startPlayback();
          else setEnabled(!enabled);
        });
        updateButton();
      };

      try {
        enabled = localStorage.getItem('bgm:enabled') === '1';
      } catch {
        enabled = false;
      }
      waitingForGesture = enabled;

      audio.addEventListener('error', () => {
        loadFailed = true;
        enabled = false;
        stopPlayback();
        saveState();
        updateButton();
      });
      document.addEventListener('click', (event) => {
        if (event.target instanceof Element && event.target.closest('[data-bgm-toggle]')) return;
        if (enabled && waitingForGesture) startPlayback();
      });
      document.addEventListener('keydown', () => {
        if (enabled && waitingForGesture) startPlayback();
      });
      document.addEventListener('touchstart', (event) => {
        if (event.target instanceof Element && event.target.closest('[data-bgm-toggle]')) return;
        if (enabled && waitingForGesture) startPlayback();
      }, { passive: true });
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'hidden') {
          if (enabled) stopPlayback();
        } else if (enabled && !waitingForGesture) {
          startPlayback();
        }
      });
      document.addEventListener('astro:page-load', bindButton);
      bindButton();
    }
  }
</script>

<style is:global>
  .bgm-audio-engine { display: none; }
  .bgm-control { position: relative; flex: 0 0 36px; width: 36px; height: 36px; }
  .bgm-toggle { display: grid; width: 36px; height: 36px; padding: 0; place-items: center; border: 1px solid var(--line-strong); border-radius: 6px; color: var(--text-dim); background: var(--card-fill); box-shadow: var(--card-highlight), 0 2px 4px rgba(0, 0, 0, 0.4); cursor: pointer; transition: background 0.2s, box-shadow 0.2s, border-color 0.2s, color 0.2s; }
  .bgm-toggle:hover, .bgm-toggle:focus-visible { border-color: color-mix(in srgb, var(--line-hover) 50%, transparent); color: var(--text); }
  .bgm-toggle[aria-pressed='true'] { border-color: var(--line-gold); color: var(--accent); background: color-mix(in srgb, var(--bg-deep) 85%, var(--accent-dim)); box-shadow: var(--icon-inset), 0 0 10px color-mix(in srgb, var(--accent) 25%, transparent); }
  .bgm-toggle[aria-pressed='true']:hover, .bgm-toggle[aria-pressed='true']:focus-visible { border-color: color-mix(in srgb, var(--line-hover) 70%, var(--line-gold)); color: var(--accent); }
  .bgm-toggle:focus-visible { outline: 1px solid var(--accent-dim); outline-offset: 2px; }
  .bgm-toggle:active { transform: translateY(1px); }
  .bgm-icon { width: 20px; height: 20px; }
  .bgm-icon-on, .bgm-toggle[aria-pressed='true'] .bgm-icon-off { display: none; }
  .bgm-toggle[aria-pressed='true'] .bgm-icon-on { display: block; }
  .bgm-wave { animation: bgm-wave-breathe 1.8s ease-in-out infinite; }
  .bgm-wave-far { animation-delay: 0.25s; }
  @keyframes bgm-wave-breathe { 0%, 100% { opacity: 0.55; } 50% { opacity: 1; } }
  @media (max-width: 990px) { .bgm-control { grid-column: 3; grid-row: 1; } }
  @media (max-width: 639px) { .bgm-control { grid-column: 2; grid-row: 1; } }
  @media (prefers-reduced-motion: reduce) { .bgm-wave { animation: none; } .bgm-toggle:active { transform: none; } }
</style>
