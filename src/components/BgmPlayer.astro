<div class="bgm-player" data-bgm-player transition:persist="bgm">
  <button
    class="bgm-toggle"
    type="button"
    data-bgm-toggle
    aria-label="播放背景音乐"
    aria-pressed="false"
    title="播放背景音乐"
  >
    <svg class="bgm-icon bgm-icon-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M4 10v4h3l4 3V7l-4 3H4z" />
      <path d="m17 9 4 6" />
      <path d="m21 9-4 6" />
    </svg>
    <svg class="bgm-icon bgm-icon-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M4 10v4h3l4 3V7l-4 3H4z" />
      <path class="bgm-wave bgm-wave-near" d="M15 9.5c1.7 1.3 1.7 3.7 0 5" />
      <path class="bgm-wave bgm-wave-far" d="M18 7c3.3 2.8 3.3 7.2 0 10" />
    </svg>
  </button>

  <div class="bgm-volume-popover" data-bgm-volume-popover hidden>
    <label class="bgm-volume" aria-label="音量">
      <input type="range" min="0" max="100" step="1" value="40" data-bgm-volume aria-label="音量" />
    </label>
    <p class="bgm-credit">Trader's Camp</p>
  </div>

  <audio src="/audio/bgm.mp3" loop preload="none" data-bgm-audio></audio>
</div>

<script>
  if (!window.__grimsoulBgmInitialized) {
    window.__grimsoulBgmInitialized = true;

    const player = document.querySelector<HTMLElement>('[data-bgm-player]');
    const audio = player?.querySelector<HTMLAudioElement>('[data-bgm-audio]');
    const toggle = player?.querySelector<HTMLButtonElement>('[data-bgm-toggle]');
    const volumePopover = player?.querySelector<HTMLElement>('[data-bgm-volume-popover]');
    const volume = player?.querySelector<HTMLInputElement>('[data-bgm-volume]');

    if (player && audio && toggle && volumePopover && volume) {
      let audioContext: AudioContext | undefined;
      let source: MediaElementAudioSourceNode | undefined;
      let gain: GainNode | undefined;
      let fadeToken = 0;
      let enabled = false;
      let currentVolume = 0.4;
      let waitingForGesture = false;
      let loadFailed = false;
      let hoverShowTimer: number | undefined;
      let volumeHideTimer: number | undefined;
      let longPressTimer: number | undefined;
      let suppressNextToggle = false;

      const readStorage = () => {
        try {
          enabled = localStorage.getItem('bgm:enabled') === '1';
          const storedVolume = Number.parseFloat(localStorage.getItem('bgm:volume') ?? '0.4');
          currentVolume = Number.isFinite(storedVolume) ? Math.min(1, Math.max(0, storedVolume)) : 0.4;
        } catch {
          enabled = false;
          currentVolume = 0.4;
        }
      };

      const saveState = () => {
        try {
          localStorage.setItem('bgm:enabled', enabled ? '1' : '0');
          localStorage.setItem('bgm:volume', String(currentVolume));
        } catch {
          // localStorage may be unavailable in restricted browser modes.
        }
      };

      const updateRange = () => {
        volume.value = String(Math.round(currentVolume * 100));
        volume.style.setProperty('--bgm-range-percent', `${currentVolume * 100}%`);
      };

      const updateControls = () => {
        toggle.setAttribute('aria-label', enabled ? '停止背景音乐' : '播放背景音乐');
        toggle.setAttribute('aria-pressed', String(enabled));
        toggle.title = loadFailed ? '音乐文件加载失败' : '背景音乐：Grim Soul 原声《Trader\'s Camp》';
        toggle.classList.toggle('is-playing', enabled);
        player.classList.toggle('is-enabled', enabled);
        updateRange();
      };

      const openVolume = () => {
        if (volumeHideTimer !== undefined) window.clearTimeout(volumeHideTimer);
        volumePopover.hidden = false;
        requestAnimationFrame(() => volumePopover.classList.add('is-visible'));
        volumeHideTimer = window.setTimeout(closeVolume, 3000);
      };

      const closeVolume = () => {
        if (volumeHideTimer !== undefined) window.clearTimeout(volumeHideTimer);
        volumeHideTimer = undefined;
        volumePopover.classList.remove('is-visible');
        window.setTimeout(() => {
          if (!volumePopover.classList.contains('is-visible')) volumePopover.hidden = true;
        }, 200);
      };

      const ensureAudioGraph = () => {
        if (audioContext && source && gain) return true;
        try {
          audioContext = new AudioContext();
          source = audioContext.createMediaElementSource(audio);
          gain = audioContext.createGain();
          source.connect(gain).connect(audioContext.destination);
          gain.gain.value = 0;
          return true;
        } catch {
          loadFailed = true;
          enabled = false;
          saveState();
          updateControls();
          return false;
        }
      };

      const fadeGain = (target: number, callback?: () => void) => {
        if (!gain || !audioContext) {
          callback?.();
          return;
        }
        const now = audioContext.currentTime;
        gain.gain.cancelScheduledValues(now);
        gain.gain.setValueAtTime(gain.gain.value, now);
        gain.gain.linearRampToValueAtTime(target, now + 0.6);
        if (callback) window.setTimeout(callback, 600);
      };

      const startPlayback = async () => {
        if (!enabled || !ensureAudioGraph()) return;
        fadeToken += 1;
        const token = fadeToken;
        try {
          await audioContext?.resume();
          await audio.play();
          if (token !== fadeToken || !enabled) return;
          fadeGain(currentVolume);
          waitingForGesture = false;
        } catch {
          waitingForGesture = true;
        }
      };

      const stopPlayback = () => {
        fadeToken += 1;
        const token = fadeToken;
        fadeGain(0, () => {
          if (token === fadeToken) audio.pause();
        });
      };

      const setEnabled = (nextEnabled: boolean) => {
        enabled = nextEnabled;
        loadFailed = false;
        saveState();
        updateControls();
        if (enabled) {
          openVolume();
          startPlayback();
        } else {
          closeVolume();
          stopPlayback();
        }
      };

      const resumeAfterGesture = () => {
        if (enabled && waitingForGesture) startPlayback();
      };

      readStorage();
      waitingForGesture = enabled;
      updateControls();
      audio.addEventListener('error', () => {
        loadFailed = true;
        enabled = false;
        stopPlayback();
        closeVolume();
        saveState();
        updateControls();
      });

      toggle.addEventListener('click', () => {
        if (suppressNextToggle) {
          suppressNextToggle = false;
          return;
        }
        if (enabled && waitingForGesture) startPlayback();
        else setEnabled(!enabled);
      });
      volume.addEventListener('input', () => {
        currentVolume = Math.min(1, Math.max(0, Number(volume.value) / 100));
        saveState();
        updateRange();
        openVolume();
        if (enabled && gain && audioContext) fadeGain(currentVolume);
      });
      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Node) || player.contains(event.target)) return;
        closeVolume();
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeVolume();
        if (document.activeElement === toggle && (event.key === 'ArrowUp' || event.key === 'ArrowDown')) {
          event.preventDefault();
          openVolume();
          const nextVolume = Math.min(100, Math.max(0, Number(volume.value) + (event.key === 'ArrowUp' ? 5 : -5)));
          volume.value = String(nextVolume);
          volume.dispatchEvent(new Event('input', { bubbles: true }));
        }
        resumeAfterGesture();
      });
      const canHover = window.matchMedia('(hover: hover) and (pointer: fine)');
      const scheduleHoverShow = () => {
        if (!canHover.matches) return;
        if (volumeHideTimer !== undefined) window.clearTimeout(volumeHideTimer);
        hoverShowTimer = window.setTimeout(openVolume, 300);
      };
      const scheduleHoverHide = () => {
        if (hoverShowTimer !== undefined) window.clearTimeout(hoverShowTimer);
        if (volumeHideTimer !== undefined) window.clearTimeout(volumeHideTimer);
        volumeHideTimer = window.setTimeout(closeVolume, 3000);
      };
      toggle.addEventListener('mouseenter', scheduleHoverShow);
      toggle.addEventListener('mouseleave', scheduleHoverHide);
      volumePopover.addEventListener('mouseenter', () => {
        if (volumeHideTimer !== undefined) window.clearTimeout(volumeHideTimer);
      });
      volumePopover.addEventListener('mouseleave', scheduleHoverHide);
      toggle.addEventListener('pointerdown', (event) => {
        if (event.pointerType !== 'touch') return;
        longPressTimer = window.setTimeout(() => {
          suppressNextToggle = true;
          openVolume();
        }, 500);
      });
      toggle.addEventListener('pointerup', () => {
        if (longPressTimer !== undefined) window.clearTimeout(longPressTimer);
        longPressTimer = undefined;
      });
      toggle.addEventListener('pointercancel', () => {
        if (longPressTimer !== undefined) window.clearTimeout(longPressTimer);
        longPressTimer = undefined;
      });
      document.addEventListener('pointerdown', resumeAfterGesture, { passive: true });
      document.addEventListener('touchstart', resumeAfterGesture, { passive: true });
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'hidden') {
          if (enabled) stopPlayback();
        } else if (enabled && !waitingForGesture) {
          startPlayback();
        }
      });
      document.addEventListener('astro:before-preparation', closeVolume);
    }
  }
</script>

<style>
  .bgm-player {
    position: fixed;
    left: 20px;
    bottom: calc(10% + env(safe-area-inset-bottom, 0px));
    z-index: 25;
  }

  .bgm-toggle {
    display: grid;
    width: 44px;
    height: 44px;
    padding: 0;
    place-items: center;
    border: 1px solid var(--glass-border);
    border-radius: 50%;
    color: var(--text-dim);
    background: var(--glass-bg);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    box-shadow: var(--glass-highlight), var(--glass-shadow);
    cursor: pointer;
  }

  .bgm-toggle:hover,
  .bgm-toggle:focus-visible {
    border-color: var(--line-hover);
    color: var(--accent);
  }

  .bgm-icon {
    width: 20px;
    height: 20px;
  }

  .bgm-icon-on {
    display: none;
  }

  .bgm-player.is-enabled .bgm-icon-off {
    display: none;
  }

  .bgm-player.is-enabled .bgm-icon-on {
    display: block;
    color: var(--accent);
  }

  .bgm-player.is-enabled .bgm-toggle {
    border-color: var(--line-gold);
    box-shadow: var(--glass-highlight), var(--glass-shadow), 0 0 10px color-mix(in srgb, var(--accent-dim) 22%, transparent);
  }

  .bgm-wave {
    transform-origin: center;
    animation: bgm-wave-breathe 1.8s ease-in-out infinite;
  }

  .bgm-wave-far {
    animation-delay: 0.25s;
  }

  .bgm-volume-popover {
    position: absolute;
    bottom: calc(44px + 10px);
    left: 0;
    display: flex;
    width: 36px;
    height: 150px;
    padding: 14px 0;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    color: var(--text);
    background: var(--glass-bg-strong);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    box-shadow: var(--glass-highlight), var(--glass-shadow);
    opacity: 0;
    pointer-events: none;
    transform: translateY(6px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .bgm-volume-popover[hidden] {
    display: none;
  }

  .bgm-volume-popover.is-visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .bgm-volume {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .bgm-volume input {
    width: 3px;
    height: 122px;
    margin: 0;
    appearance: none;
    border-radius: 999px;
    background: linear-gradient(to top, var(--accent) var(--bgm-range-percent, 40%), var(--line-strong) var(--bgm-range-percent, 40%));
    writing-mode: vertical-lr;
    direction: rtl;
    cursor: pointer;
  }

  .bgm-volume input::-webkit-slider-thumb {
    width: 12px;
    height: 12px;
    appearance: none;
    border: 0;
    border-radius: 50%;
    background: var(--accent);
  }

  .bgm-volume input:active::-webkit-slider-thumb {
    width: 14px;
    height: 14px;
  }

  .bgm-volume input::-moz-range-thumb {
    width: 12px;
    height: 12px;
    border: 0;
    border-radius: 50%;
    background: var(--accent);
  }

  .bgm-volume input:active::-moz-range-thumb {
    width: 14px;
    height: 14px;
  }

  .bgm-credit {
    position: absolute;
    bottom: 5px;
    left: 50%;
    width: max-content;
    margin: 0;
    color: var(--text-dim);
    font-size: 0.5rem;
    line-height: 1;
    transform: translateX(-50%);
    white-space: nowrap;
  }

  @supports not (backdrop-filter: blur(1px)) {
    .bgm-toggle,
    .bgm-volume-popover {
      background: var(--bg-panel);
    }
  }

  @keyframes bgm-wave-breathe {
    0%, 100% { opacity: 0.55; }
    50% { opacity: 1; }
  }

  @media (max-width: 639px) {
    .bgm-toggle,
    .bgm-player {
      width: 44px;
      height: 44px;
    }

    .bgm-player {
      left: 12px;
    }

    .bgm-toggle,
    .bgm-volume-popover {
      backdrop-filter: blur(10px) saturate(140%);
      -webkit-backdrop-filter: blur(10px) saturate(140%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bgm-wave {
      animation: none;
    }

    .bgm-volume-popover,
    .bgm-volume-popover.is-visible {
      transform: none;
      transition: opacity 0.2s ease;
    }
  }
</style>
