---
import { BGM_TRACKS } from '../lib/bgm-tracks';
---

<div class="bgm-audio-engine" data-bgm-audio-engine transition:persist="bgm">
  <audio preload="none" data-bgm-audio></audio>
</div>

<script>
  import { BGM_TRACKS } from '../lib/bgm-tracks';

  if (!window.__grimsoulBgmInitialized) {
    window.__grimsoulBgmInitialized = true;
    const audio = document.querySelector<HTMLAudioElement>('[data-bgm-audio]');
    const tracks = BGM_TRACKS;
    const BGM_VOLUME = 0.45;

    if (audio && tracks.length > 0) {
      let audioContext: AudioContext | undefined;
      let source: MediaElementAudioSourceNode | undefined;
      let gain: GainNode | undefined;
      let fadeToken = 0;
      let enabled = true;
      let isPlaying = false;
      let waitingForGesture = false;
      let loadFailed = false;
      let trackIndex = -1;

      const getControl = () => document.querySelector<HTMLElement>('[data-bgm-control]');
      const getButton = () => getControl()?.querySelector<HTMLButtonElement>('[data-bgm-toggle]');
      const getNextButton = () => getControl()?.querySelector<HTMLButtonElement>('[data-bgm-next]');

      const saveState = () => {
        try { localStorage.setItem('bgm:enabled', enabled ? '1' : '0'); } catch { /* ignore storage errors */ }
      };

      const updateButton = () => {
        const button = getButton();
        if (!button) return;
        button.setAttribute('aria-label', enabled ? '停止背景音乐' : '播放背景音乐');
        button.setAttribute('aria-pressed', String(enabled));
        button.title = loadFailed ? '音乐文件加载失败' : '背景音乐';
      };

      const ensureAudioGraph = () => {
        if (audioContext && source && gain) return true;
        try {
          audioContext = new AudioContext();
          source = audioContext.createMediaElementSource(audio);
          gain = audioContext.createGain();
          source.connect(gain).connect(audioContext.destination);
          gain.gain.value = 0;
          return true;
        } catch {
          loadFailed = true;
          enabled = false;
          isPlaying = false;
          saveState();
          updateButton();
          return false;
        }
      };

      const fadeGain = (target: number, duration: number, callback?: () => void) => {
        if (!gain || !audioContext) { callback?.(); return; }
        const now = audioContext.currentTime;
        gain.gain.cancelScheduledValues(now);
        gain.gain.setValueAtTime(gain.gain.value, now);
        gain.gain.linearRampToValueAtTime(target, now + duration);
        if (callback) window.setTimeout(callback, duration * 1000);
      };

      const randomIndex = (exclude = -1) => {
        if (tracks.length <= 1) return 0;
        let next = Math.floor(Math.random() * tracks.length);
        while (next === exclude) next = Math.floor(Math.random() * tracks.length);
        return next;
      };

      const setTrackSource = (index: number) => {
        trackIndex = (index + tracks.length) % tracks.length;
        audio.src = tracks[trackIndex].src;
        audio.loop = tracks.length === 1;
        audio.load();
      };

      const startPlayback = async () => {
        if (!enabled || !ensureAudioGraph()) return;
        const isFirstPlayback = trackIndex < 0;
        if (isFirstPlayback) setTrackSource(randomIndex());
        fadeToken += 1;
        const token = fadeToken;
        try {
          await audioContext?.resume();
          await audio.play();
          if (token !== fadeToken || !enabled) return;
          fadeGain(BGM_VOLUME, isFirstPlayback ? 2 : 0.6);
          isPlaying = true;
          waitingForGesture = false;
          updateButton();
        } catch { waitingForGesture = true; }
      };

      const stopPlayback = () => {
        fadeToken += 1;
        const token = fadeToken;
        fadeGain(0, 0.6, () => {
          if (token === fadeToken) { audio.pause(); isPlaying = false; }
        });
        isPlaying = false;
      };

      const switchTrack = async (nextIndex: number) => {
        if (!ensureAudioGraph()) return;
        const wasPlaying = isPlaying;
        fadeToken += 1;
        const token = fadeToken;
        const changeSource = async () => {
          if (token !== fadeToken) return;
          setTrackSource(nextIndex);
          if (!enabled) return;
          try {
            await audioContext?.resume();
            await audio.play();
            if (token !== fadeToken || !enabled) return;
            fadeGain(BGM_VOLUME, 0.6);
            isPlaying = true;
            waitingForGesture = false;
            updateButton();
          } catch { waitingForGesture = true; }
        };
        if (wasPlaying) fadeGain(0, 0.4, () => { audio.pause(); void changeSource(); });
        else void changeSource();
      };

      const playNext = () => {
        enabled = true;
        loadFailed = false;
        saveState();
        updateButton();
        void switchTrack(randomIndex(trackIndex));
      };

      const setEnabled = (nextEnabled: boolean) => {
        enabled = nextEnabled;
        loadFailed = false;
        saveState();
        updateButton();
        if (enabled) void startPlayback();
        else stopPlayback();
      };

      const bindControls = () => {
        const button = getButton();
        const nextButton = getNextButton();
        if (button && button.dataset.bgmBound !== 'true') {
          button.dataset.bgmBound = 'true';
          button.addEventListener('click', () => {
            if (enabled && waitingForGesture) setEnabled(false);
            else setEnabled(!enabled);
          });
        }
        if (nextButton && tracks.length > 1 && nextButton.dataset.bgmBound !== 'true') {
          nextButton.dataset.bgmBound = 'true';
          nextButton.addEventListener('click', playNext);
        }
        if (nextButton && tracks.length <= 1) nextButton.hidden = true;
        updateButton();
      };

      try { enabled = localStorage.getItem('bgm:enabled') !== '0'; } catch { enabled = true; }
      audio.addEventListener('ended', () => {
        if (tracks.length === 1) { audio.currentTime = 0; void startPlayback(); }
        else void switchTrack(randomIndex(trackIndex));
      });
      audio.addEventListener('error', () => {
        loadFailed = true;
        enabled = false;
        isPlaying = false;
        stopPlayback();
        saveState();
        updateButton();
      });
      document.addEventListener('click', (event) => {
        const control = getControl();
        if (event.target instanceof Node && control?.contains(event.target)) return;
        if (enabled && waitingForGesture) void startPlayback();
      });
      document.addEventListener('keydown', (event) => {
        if (event.target instanceof Element && event.target.closest('[data-bgm-control]')) return;
        if (enabled && waitingForGesture) void startPlayback();
      });
      document.addEventListener('touchstart', (event) => {
        if (event.target instanceof Element && event.target.closest('[data-bgm-control]')) return;
        if (enabled && waitingForGesture) void startPlayback();
      }, { passive: true });
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'hidden') { if (enabled) stopPlayback(); }
        else if (enabled && !waitingForGesture) void startPlayback();
      });
      document.addEventListener('astro:before-preparation', () => updateButton());
      document.addEventListener('astro:page-load', bindControls);
      waitingForGesture = enabled;
      bindControls();
    }
  }
</script>

<style is:global>
  .bgm-audio-engine { display: none; }
  .bgm-control { position: relative; display: flex; flex: 0 0 76px; width: 76px; height: 36px; gap: 4px; }
  .bgm-toggle, .bgm-next-toggle { display: grid; width: 36px; height: 36px; padding: 0; place-items: center; border: 1px solid var(--line-strong); border-radius: 6px; color: var(--text-dim); background: var(--card-fill); box-shadow: var(--card-highlight), 0 2px 4px rgba(0, 0, 0, 0.4); cursor: pointer; transition: background 0.2s, box-shadow 0.2s, border-color 0.2s, color 0.2s; }
  .bgm-toggle:hover, .bgm-toggle:focus-visible, .bgm-next-toggle:hover, .bgm-next-toggle:focus-visible { border-color: color-mix(in srgb, var(--line-hover) 50%, transparent); color: var(--text); }
  .bgm-toggle[aria-pressed='true'] { border-color: var(--line-gold); color: var(--accent); background: color-mix(in srgb, var(--bg-deep) 85%, var(--accent-dim)); box-shadow: var(--icon-inset), 0 0 10px color-mix(in srgb, var(--accent) 25%, transparent); }
  .bgm-toggle[aria-pressed='true']:hover, .bgm-toggle[aria-pressed='true']:focus-visible { border-color: color-mix(in srgb, var(--line-hover) 70%, var(--line-gold)); color: var(--accent); }
  .bgm-toggle:focus-visible, .bgm-next-toggle:focus-visible { outline: 1px solid var(--accent-dim); outline-offset: 2px; }
  .bgm-toggle:active, .bgm-next-toggle:active { transform: translateY(1px); }
  .bgm-next-toggle svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .bgm-icon { width: 20px; height: 20px; }
  .bgm-icon-on, .bgm-toggle[aria-pressed='true'] .bgm-icon-off { display: none; }
  .bgm-toggle[aria-pressed='true'] .bgm-icon-on { display: block; }
  .bgm-wave { animation: bgm-wave-breathe 1.8s ease-in-out infinite; }
  .bgm-wave-far { animation-delay: 0.25s; }
  @keyframes bgm-wave-breathe { 0%, 100% { opacity: 0.55; } 50% { opacity: 1; } }
  @media (max-width: 990px) { .bgm-control { grid-column: 3; grid-row: 1; } }
  @media (max-width: 639px) { .bgm-control { grid-column: 2; grid-row: 1; } }
  @media (prefers-reduced-motion: reduce) { .bgm-wave { animation: none; } .bgm-toggle:active, .bgm-next-toggle:active { transform: none; } }
</style>
