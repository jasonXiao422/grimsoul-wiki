---
import { LOADING_LINES } from '../lib/loading-lines';
---

<script define:vars={{ loadingLines: LOADING_LINES }}>
  if (!window.__GRIMSOUL_LOADING_LINES__) window.__GRIMSOUL_LOADING_LINES__ = loadingLines;
</script>

<div class="nav-loader" data-nav-loader hidden>
  <div
    class="nav-loader-dialog"
    role="dialog"
    aria-modal="true"
    aria-live="polite"
    aria-label="页面加载中"
    data-nav-loader-dialog
  >
    <button class="nav-loader-close" type="button" aria-label="关闭" data-nav-loader-close>
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false">
        <path d="m6 6 12 12M18 6 6 18" />
      </svg>
    </button>
    <div class="nav-loader-content">
      <span class="nav-loader-spinner" aria-hidden="true"></span>
      <span data-nav-loader-message></span>
    </div>
  </div>
</div>

<script is:inline>
  if (!window.__grimsoulNavLoaderInitialized) {
    window.__grimsoulNavLoaderInitialized = true;
  (() => {
    const getLoader = () => document.querySelector('[data-nav-loader]');
    const getCloseButton = () => getLoader()?.querySelector('[data-nav-loader-close]');
    const getMessage = () => getLoader()?.querySelector('[data-nav-loader-message]');

    const randomLoadingLine = () => {
      const lines = window.__GRIMSOUL_LOADING_LINES__ ?? [];
      return lines[Math.floor(Math.random() * lines.length)] ?? '';
    };
    let showTimer;
    let hideTimer;
    let navigationInProgress = false;

    const clearTimers = () => {
      if (showTimer !== undefined) window.clearTimeout(showTimer);
      if (hideTimer !== undefined) window.clearTimeout(hideTimer);
      showTimer = undefined;
      hideTimer = undefined;
    };

    const hideLoader = () => {
      clearTimers();
      const loader = getLoader();
      if (loader) loader.hidden = true;
    };

    const showLoader = () => {
      showTimer = undefined;
      const loader = getLoader();
      const message = getMessage();
      const closeButton = getCloseButton();
      if (!loader || !message || !closeButton) return;
      message.textContent = randomLoadingLine();
      loader.hidden = false;
      closeButton.focus({ preventScroll: true });
      hideTimer = window.setTimeout(hideLoader, 10000);
    };

    const startTimer = () => {
      const loader = getLoader();
      if (showTimer !== undefined || (loader && !loader.hidden)) return;
      showTimer = window.setTimeout(showLoader, 500);
    };

    document.addEventListener('astro:before-preparation', () => {
      navigationInProgress = true;
      startTimer();
    });

    document.addEventListener('astro:after-swap', () => {
      navigationInProgress = false;
      hideLoader();
    });

    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element) || !event.target.closest('[data-nav-loader-close]')) return;
      if (navigationInProgress && history.length > 1) history.back();
      hideLoader();
    });

    document.addEventListener('keydown', (event) => {
      const loader = getLoader();
      if (event.key === 'Escape' && loader && !loader.hidden) {
        if (navigationInProgress && history.length > 1) history.back();
        hideLoader();
      }
    });

    window.addEventListener('pageshow', hideLoader);
  })();
  }
</script>

<style>
  .nav-loader {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    animation: nav-loader-fade-in 0.2s ease;
  }

  .nav-loader[hidden] {
    display: none;
  }

  .nav-loader-dialog {
    position: relative;
    width: min(560px, calc(100% - 32px));
    padding: 10px;
    border: 1px solid var(--accent-dim);
    border-radius: 8px;
    background: var(--glass-bg-strong);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    box-shadow: var(--glass-shadow);
  }

  .nav-loader-content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 20px;
    padding: 28px 44px 28px 28px;
    border: 1px solid var(--line-gold);
    border-radius: 6px;
    color: var(--text);
    font-size: 0.95rem;
  }

  .nav-loader-spinner {
    flex: 0 0 20px;
    width: 20px;
    height: 20px;
    border: 1px solid var(--line);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: nav-loader-spin 0.8s linear infinite;
  }

  .nav-loader-close {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 1;
    display: grid;
    width: 32px;
    height: 32px;
    place-items: center;
    padding: 0;
    border: 1px solid var(--line-gold);
    border-radius: 6px;
    color: var(--text-dim);
    background: transparent;
    cursor: pointer;
  }

  .nav-loader-close:hover,
  .nav-loader-close:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
  }

  @supports not (backdrop-filter: blur(1px)) {
    .nav-loader-dialog {
      background: var(--bg-panel);
    }
  }

  @keyframes nav-loader-fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes nav-loader-spin {
    to { transform: rotate(360deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-loader {
      animation: none;
    }

    .nav-loader-spinner {
      animation: none;
    }
  }
</style>
