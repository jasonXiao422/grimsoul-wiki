---
/**
 * 分组共用的场地机制说明，只在详情页出现。
 *
 * 数据来自 enemies.json 的 groupNoteBlocks 字段，由 import_excel.py 从
 * Excel「场地机制」列的分组说明拆出。
 *
 * 列表页绝不能引用本组件——长文本只在详情页显示。
 *
 * 用法：
 *   <GroupNote blocks={enemy.groupNoteBlocks} group={enemy.group} />
 * blocks 为空时不渲染任何东西，调用方不必先判空。
 */
import { getItemIconSrc } from '../lib/data';
import ImageZoom from './ImageZoom.astro';
import { GROUP_NOTE_ILLUSTRATIONS } from '../lib/group-note-illustrations';

interface NoteItem {
  index?: number | string;
  name: string;
  desc: string;
  iconCat?: string | null;
  iconId?: string | null;
}

interface NoteBlock {
  title: string;
  body: string;
  items?: NoteItem[];
}

interface Props {
  blocks?: NoteBlock[] | null;
  /** 分组名，用于标题，如「大车炮台」。 */
  group?: string | null;
}

const { blocks, group } = Astro.props;
const illustration = group ? GROUP_NOTE_ILLUSTRATIONS[group] : undefined;
const fallback =
  'data:image/svg+xml;charset=utf-8,' +
  encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 96 96"><rect width="96" height="96" fill="#1b1d21"/><path d="M21 69h54L61 48 49 61 39 41z" fill="#2c2f35"/></svg>`);
---

{blocks && blocks.length > 0 && (
  <section class="group-note">
    <h2 class="group-note__title">{group ? `${group}｜场地机制` : '场地机制'}</h2>
    <div class="group-note__body">
      {illustration && (
        <section class="group-note__block">
          <h3>场地俯瞰图</h3>
          <ImageZoom
            src={illustration.src}
            alt={illustration.alt}
            class="group-note__illustration"
          />
        </section>
      )}
      {blocks.map((block) => (
        <section class="group-note__block">
          <h3>{block.title}</h3>
          {block.body && <p>{block.body}</p>}
          {block.items && block.items.length > 0 && (
            <ol class="group-note__items">
              {block.items.map((entry) => (
                <li class="group-note__item">
                  {entry.iconId && (
                    <img
                      class="group-note__icon"
                      src={getItemIconSrc(entry.iconCat ?? 'debuffs', {
                        id: entry.iconId,
                        iconCat: entry.iconCat,
                        iconId: entry.iconId,
                      })}
                      alt={entry.name}
                      title={entry.name}
                      loading="lazy"
                      data-fallback={fallback}
                      onerror="this.onerror=null;this.src=this.dataset.fallback;this.classList.add('is-missing')"
                    />
                  )}
                  <div class="group-note__item-copy">
                    <h4>{entry.index ? `${entry.index}. ` : ''}{entry.name}</h4>
                    <p>{entry.desc}</p>
                  </div>
                </li>
              ))}
            </ol>
          )}
        </section>
      ))}
    </div>
  </section>
)}

<style>
  .group-note {
    margin-block-start: 24px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg-panel);
  }

  .group-note__title {
    padding: 12px 16px;
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1rem;
    color: var(--accent);
  }

  .group-note__body {
    padding: 0 16px 16px;
    border-block-start: 1px solid var(--border);
    padding-block-start: 12px;
    margin-block-start: 4px;
  }

  .group-note__body p {
    margin: 0 0 10px;
    line-height: 1.75;
    color: var(--text);
    font-size: 0.9375rem;
  }

  .group-note__block {
    margin-block-end: 20px;
  }

  .group-note__block:last-child {
    margin-block-end: 0;
  }

  .group-note__block h3 {
    margin: 0 0 8px;
    color: var(--accent);
    font-size: 1rem;
    font-weight: 600;
  }

  :global(.group-note__illustration) {
    display: block;
    width: 100%;
    max-width: 50%;
    height: auto;
    margin-inline: 0;
    border-radius: 8px;
    cursor: zoom-in;
  }

  .group-note__items {
    display: grid;
    gap: 12px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }

  .group-note__item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    min-width: 0;
  }

  .group-note__icon {
    flex: 0 0 44px;
    width: 44px;
    height: 44px;
    object-fit: contain;
    border-radius: 4px;
    background: var(--bg);
  }

  .group-note__item-copy {
    min-width: 0;
  }

  .group-note__item-copy h4 {
    margin: 0 0 3px;
    color: var(--accent);
    font-weight: 600;
  }

  .group-note__item-copy p:last-child,
  .group-note__block > p:last-child {
    margin-block-end: 0;
  }

  @media (max-width: 640px) {
    :global(.group-note__illustration) {
      max-width: 100%;
    }

    .group-note__title {
      padding: 10px 12px;
    }

    .group-note__body {
      padding-inline: 12px;
      padding-block-end: 12px;
    }
  }
</style>
