---
import ImageZoom from './ImageZoom.astro';
import MaterialCostList from './MaterialCostList.astro';
import { getItemIconSrc } from '../lib/data';
import { QUALITY_META, type Quality } from '../lib/quality';

const { building } = Astro.props;
const quality = typeof building.quality === 'string' && building.quality in QUALITY_META
  ? QUALITY_META[building.quality as Quality]
  : QUALITY_META.common;
const qualityStyle = `--quality-border:${quality.border};--quality-glow:${quality.glow}`;
const fallback =
  'data:image/svg+xml;charset=utf-8,' +
  encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 96 96"><rect width="96" height="96" fill="#1b1d21"/><path d="M21 69h54L61 48 49 61 39 41z" fill="#2c2f35"/></svg>');
const blueprintFallback =
  'data:image/svg+xml;charset=utf-8,' +
  encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 96 96"><rect width="96" height="96" fill="#1b1d21"/><path d="M24 16h48v64H24z" fill="#2c2f35"/><path d="M32 29h32M32 43h32M32 57h24" stroke="#8a6f1a" stroke-width="5"/></svg>');
const getBlueprintQuality = (blueprint: any) => typeof blueprint.weaponQuality === 'string' && blueprint.weaponQuality in QUALITY_META
  ? QUALITY_META[blueprint.weaponQuality as Quality]
  : undefined;
const hasBuildCost = building.buildCost?.length > 0;
const hasAssembleCost = building.assembleCost?.length > 0;

---

<section class="fixed-building-detail-hero panel element-forge-hero">
  <div class="fixed-building-detail-image-wrap">
    <ImageZoom
      src={getItemIconSrc('fixed-buildings', building)}
      alt={building.name}
      class="fixed-building-detail-image quality-icon"
      style={qualityStyle}
    />
  </div>
  <div>
    <h1 style={`color:${quality.text}`}>{building.name}</h1>
    <dl class="fixed-building-summary">
      <div class="tag fixed-building-summary-item"><dt class="eyebrow">城堡点数</dt><dd>{building.castlePoints}</dd></div>
    </dl>
  </div>
</section>

<div class="fixed-building-cost-grid">
  {hasBuildCost && <section class="panel fixed-building-cost-panel"><h2>建造材料</h2><MaterialCostList cost={building.buildCost} compact /></section>}
  {hasAssembleCost && <section class="panel fixed-building-cost-panel"><h2>组装材料</h2><MaterialCostList cost={building.assembleCost} compact /></section>}
</div>

<section class="section panel element-forge-blueprints">
  <h2 class="detail-panel-title">元素武器图纸</h2>
  <div class="element-forge-blueprint-list">
    {building.blueprints.map((blueprint) => (
      <a class="element-forge-blueprint-card" href={`/fixed-buildings/${building.id}/${blueprint.weaponId}`}>
        {(() => {
          const blueprintQuality = getBlueprintQuality(blueprint);
          const blueprintStyle = blueprintQuality
            ? `--quality-border:${blueprintQuality.border};--quality-glow:${blueprintQuality.glow}`
            : undefined;
          return <>
        <img
          class:list={['element-forge-blueprint-icon', blueprintQuality && 'quality-icon']}
          src={`/images/forge-blueprints/${blueprint.weaponId}.webp`}
          alt={blueprint.weaponName}
          loading="lazy"
          style={blueprintStyle}
          data-fallback={blueprintFallback}
          onerror="this.onerror=null;this.src=this.dataset.fallback;this.classList.add('is-missing')"
        />
        <strong style={blueprintQuality ? `color:${blueprintQuality.text}` : undefined}>{blueprint.weaponName}</strong>
          </>;
        })()}
      </a>
    ))}
  </div>
</section>

<style>
  .element-forge-blueprint-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .element-forge-blueprint-card {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 88px;
    min-width: 0;
    padding: 12px 16px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg-panel);
    color: var(--text);
    text-decoration: none;
  }

  .element-forge-blueprint-card strong {
    min-width: 0;
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .element-forge-blueprint-card:hover,
  .element-forge-blueprint-card:focus-visible {
    border-color: var(--accent-dim);
    background: var(--bg-panel-soft, var(--bg-panel));
  }

  .element-forge-blueprint-icon {
    width: 64px;
    height: 64px;
    flex: 0 0 64px;
    object-fit: contain;
    border-radius: 6px;
  }

  @media (max-width: 639px) {
    .element-forge-blueprint-list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
