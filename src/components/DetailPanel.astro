---
import ImageZoom from './ImageZoom.astro';
import { TIER_COLOR } from '../lib/tiers';
import { FIELD_LABELS, formatValue } from '../lib/display';
import { getAnyItemName, MATERIALS_BY_ID, type CategorySlug } from '../lib/data';

interface Props {
  categorySlug: CategorySlug;
  item: Record<string, any>;
}

const { categorySlug, item } = Astro.props;
const iconSrc = `/images/${categorySlug}/${item.id}.webp`;
const hiddenKeys = new Set(['id', 'name', 'cost', 'pieces', 'dataIncomplete']);
const materialFallback =
  'data:image/svg+xml;charset=utf-8,' +
  encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 96 96"><rect width="96" height="96" fill="#1b1d21"/><path d="M21 69h54L61 48 49 61 39 41z" fill="#2c2f35"/></svg>`);

const getDetailValue = (key: string, value: unknown) => {
  if ((value === null || value === undefined || value === '') && item.dataIncomplete) return '数据待补充';
  if (key === 'upgradeOf' && typeof value === 'string') return getAnyItemName(value);
  return formatValue(key, value);
};

const attrRows = Object.entries(item)
  .filter(([key, value]) => !hiddenKeys.has(key) && value !== undefined)
  .filter(([key, value]) => key !== 'obtain' || (value !== null && value !== ''))
  .map(([key, value]) => [FIELD_LABELS[key] ?? key, getDetailValue(key, value)]);

const hasCostField = Array.isArray(item.cost);
const pieces = Array.isArray(item.pieces) ? item.pieces : [];
const eyebrow = item.tier ? `品阶 ${item.tier}` : '资料详情';
const tierColor = typeof item.tier === 'string' ? TIER_COLOR[item.tier] : undefined;
---

<article class="detail-grid">
  <aside>
    <ImageZoom src={iconSrc} alt={item.name} class="detail-image" />
  </aside>

  <div>
    <div class="page-heading">
      <p class="eyebrow" style={tierColor ? `color:${tierColor}` : undefined}>{eyebrow}</p>
      <h1>{item.name}</h1>
    </div>

    {attrRows.length > 0 && (
      <section class="panel">
        <h2>属性</h2>
        <table class="attr-table">
          <tbody>
            {attrRows.map(([label, value]) => (
              <tr>
                <th>{label}</th>
                <td>{value}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    )}

    {hasCostField && (
      <section class="section panel">
        <h2>合成配方</h2>
        {item.cost.length > 0 ? (
          <ul class="recipe-list">
            {item.cost.map((cost) => {
              const material = MATERIALS_BY_ID.get(cost.material);
              return material && (
                <li>
                  <a href={`/materials/${material.id}`}>
                    <img
                      class="item-icon"
                      src={`/images/materials/${material.id}.webp`}
                      alt={material.name}
                      loading="lazy"
                      data-fallback={materialFallback}
                      onerror="this.onerror=null;this.src=this.dataset.fallback;this.classList.add('is-missing')"
                    />
                    <span>{material.name}</span>
                    <span class="qty">×{cost.qty}</span>
                  </a>
                </li>
              );
            })}
          </ul>
        ) : (
          <p class="muted">该条目无法制作，可能只能掉落、购买或活动获取。</p>
        )}
      </section>
    )}

    {pieces.length > 0 && (
      <section class="section panel">
        <h2>套装部件</h2>
        <div class="piece-list">
          {pieces.map((piece) => (
            <article class="piece-card" id={piece.id}>
              <div class="piece-head">
                <img
                  class="item-icon"
                  src={`/images/armor-pieces/${piece.id}.webp`}
                  alt={piece.name}
                  loading="lazy"
                  data-fallback={materialFallback}
                  onerror="this.onerror=null;this.src=this.dataset.fallback;this.classList.add('is-missing')"
                />
                <div>
                  <h3>{piece.name}</h3>
                  <p class="muted">
                    护甲{formatValue('armor', piece.armor)}
                    {piece.protection ? `，元素防护${formatValue('protection', piece.protection)}` : ''}
                    {piece.effect ? `，${piece.effect}` : ''}
                  </p>
                </div>
              </div>

              {piece.cost?.length > 0 ? (
                <ul class="recipe-list compact">
                  {piece.cost.map((cost) => {
                    const material = MATERIALS_BY_ID.get(cost.material);
                    return material && (
                      <li>
                        <a href={`/materials/${material.id}`}>
                          <img
                            class="item-icon"
                            src={`/images/materials/${material.id}.webp`}
                            alt={material.name}
                            loading="lazy"
                            data-fallback={materialFallback}
                            onerror="this.onerror=null;this.src=this.dataset.fallback;this.classList.add('is-missing')"
                          />
                          <span>{material.name}</span>
                          <span class="qty">×{cost.qty}</span>
                        </a>
                      </li>
                    );
                  })}
                </ul>
              ) : (
                <p class="muted">该部件无合成配方。</p>
              )}
            </article>
          ))}
        </div>
      </section>
    )}
  </div>
</article>
