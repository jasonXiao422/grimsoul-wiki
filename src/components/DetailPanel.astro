---
import ImageZoom from './ImageZoom.astro';
import GroupNote from './GroupNote.astro';
import MaterialCostList from './MaterialCostList.astro';
import QualityText from './QualityText.astro';
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import { TIER_COLOR } from '../lib/tiers';
import { FIELD_LABELS, formatValue } from '../lib/display';
import { getAnyItemName, getItemIconSrc, type CategorySlug } from '../lib/data';
import { getEnemyConcepts } from '../lib/enemy-concepts';
import { QUALITY_META, elementColor, type Quality } from '../lib/quality';

type DetailCategorySlug = CategorySlug | 'armor-pieces';

interface Props {
  categorySlug: DetailCategorySlug;
  item: Record<string, any>;
  attributeTitle?: string;
}

const { categorySlug, item, attributeTitle = '属性' } = Astro.props;
const fullImageCategory = categorySlug === 'enemies'
  ? 'enemies-full'
  : categorySlug === 'backpacks'
    ? 'backpacks-full'
    : categorySlug === 'materials'
      ? 'materials-full'
    : undefined;
const fullImagePath = fullImageCategory
  ? resolve(process.cwd(), 'public', 'images', fullImageCategory, `${item.id}.webp`)
  : undefined;
const iconSrc = fullImageCategory && fullImagePath && existsSync(fullImagePath)
  ? `/images/${fullImageCategory}/${item.id}.webp`
  : getItemIconSrc(categorySlug, item);
const hiddenKeys = new Set(['id', 'name', 'quality', 'cost', 'pieces', 'recipes', 'healingSort', 'isRanged', 'dotTypes', 'dataIncomplete', 'entity', 'description', 'group', 'groupNote', 'groupNoteBlocks', 'noteSegments', 'restoredFromDate']);
const materialFallback =
  'data:image/svg+xml;charset=utf-8,' +
  encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 96 96"><rect width="96" height="96" fill="#1b1d21"/><path d="M21 69h54L61 48 49 61 39 41z" fill="#2c2f35"/></svg>`);

const isEmptyValue = (value: unknown) =>
  value === null || value === undefined || value === '' || (Array.isArray(value) && value.length === 0);
const isDataIncomplete = item.dataIncomplete === true;

const getDetailValue = (key: string, value: unknown) => {
  if (isEmptyValue(value) && isDataIncomplete) return '数据待补充';
  if (key === 'upgradeOf' && typeof value === 'string') return getAnyItemName(value);
  return formatValue(key, value);
};

type QualityTextSegment = { text: string; quality?: Quality };

const trimTextRange = (text: string, start: number, end: number) => {
  while (start < end && /\s/.test(text[start])) start += 1;
  while (end > start && /\s/.test(text[end - 1])) end -= 1;
  return { start, end };
};

const sliceQualitySegments = (
  segments: QualityTextSegment[] | undefined,
  start: number,
  end: number,
) => {
  if (!segments) return undefined;
  const result: QualityTextSegment[] = [];
  let offset = 0;
  for (const segment of segments) {
    const segmentEnd = offset + segment.text.length;
    const from = Math.max(start, offset);
    const to = Math.min(end, segmentEnd);
    if (from < to) {
      result.push({
        text: segment.text.slice(from - offset, to - offset),
        ...(segment.quality ? { quality: segment.quality } : {}),
      });
    }
    offset = segmentEnd;
    if (offset >= end) break;
  }
  return result;
};

const getEnemyModeColor = (mode?: string) => {
  if (mode === '英雄模式') return QUALITY_META.unique.text;
  if (mode === '传奇模式') return QUALITY_META.legendary.text;
  if (mode === '普通模式') return 'var(--text)';
  return undefined;
};

const parseEnemyNote = (value: unknown, sourceSegments?: QualityTextSegment[]) => {
  if (typeof value !== 'string' || !value.includes('【') || !value.includes('】')) return undefined;
  const matches = [...value.matchAll(/【([^】]+)】/g)];
  if (matches.length === 0) return undefined;
  const introRange = trimTextRange(value, 0, matches[0].index ?? 0);
  const intro = value.slice(introRange.start, introRange.end);
  const introSegments = sliceQualitySegments(sourceSegments, introRange.start, introRange.end);
  const skills = matches.map((match, index) => {
    const matchStart = match.index ?? 0;
    const titleStart = matchStart + 1;
    const titleRange = trimTextRange(value, titleStart, matchStart + match[0].length - 1);
    const title = value.slice(titleRange.start, titleRange.end);
    const heading = `【${title}】`;
    const headingSegments = sourceSegments
      ? [
          ...(sliceQualitySegments(sourceSegments, matchStart, matchStart + 1) ?? []),
          ...(sliceQualitySegments(sourceSegments, titleRange.start, titleRange.end) ?? []),
          ...(sliceQualitySegments(sourceSegments, matchStart + match[0].length - 1, matchStart + match[0].length) ?? []),
        ]
      : undefined;
    const start = matchStart + match[0].length;
    const end = matches[index + 1]?.index ?? value.length;
    const lines: { mode?: string; text: string; segments?: QualityTextSegment[] }[] = [];
    let lineStart = start;
    while (lineStart < end) {
      const newline = value.indexOf('\n', lineStart);
      const rawEnd = newline === -1 || newline >= end ? end : newline;
      const contentEnd = rawEnd > lineStart && value[rawEnd - 1] === '\r' ? rawEnd - 1 : rawEnd;
      const lineRange = trimTextRange(value, lineStart, contentEnd);
      let cleanEnd = lineRange.end;
      if (cleanEnd > lineRange.start && /[；;]/.test(value[cleanEnd - 1])) cleanEnd -= 1;
      if (cleanEnd > lineRange.start) {
        const lineText = value.slice(lineRange.start, cleanEnd);
        if (sourceSegments) {
          lines.push({
            text: lineText,
            segments: sliceQualitySegments(sourceSegments, lineRange.start, cleanEnd),
          });
        } else {
          const modeMatch = lineText.match(/^(普通模式|英雄模式|传奇模式)：(.*)$/);
          lines.push(modeMatch
            ? { mode: modeMatch[1], text: modeMatch[2] }
            : { text: lineText });
        }
      }
      if (rawEnd === end || newline === -1 || newline >= end) break;
      lineStart = newline + 1;
    }
    return { heading, headingSegments, lines };
  });
  return { intro, introSegments, skills };
};

const getDetailLabel = (key: string) => {
  if (categorySlug === 'shields' && key === 'armor') return '防御值';
  if (categorySlug === 'shields' && key === 'effect') return '效果';
  if (categorySlug === 'backpacks' && key === 'slots') return '储存栏';
  if (categorySlug === 'backpacks' && key === 'effect') return '效果';
  return FIELD_LABELS[key] ?? key;
};

const getElementStyle = (key: string, rawValue: unknown) => {
  if (!['element', 'protection', 'elementDamage'].includes(key)) return undefined;
  if (!rawValue || typeof rawValue !== 'object') return undefined;
  const type = (rawValue as Record<string, unknown>).type;
  return typeof type === 'string' ? `color:${elementColor(type)}` : undefined;
};

const getQualityMeta = (value: unknown) => {
  const quality = typeof value === 'string' ? value as Quality : undefined;
  return quality ? QUALITY_META[quality] : undefined;
};

const unknownKeys = Object.keys(item).filter((key) => !hiddenKeys.has(key) && !Object.hasOwn(FIELD_LABELS, key));
if (import.meta.env.DEV && unknownKeys.length > 0) {
  console.warn(`详情页存在未配置中文标签的字段：${unknownKeys.join('、')}`);
}

const attrRows = Object.entries(item)
  .filter(([key, value]) =>
    !hiddenKeys.has(key) &&
    Object.hasOwn(FIELD_LABELS, key) &&
    (!isEmptyValue(value) || isDataIncomplete),
  )
  .map(([key, value]) => ({
    key,
    rawValue: value,
    label: getDetailLabel(key),
    value: getDetailValue(key, value),
    enemyNote: categorySlug === 'enemies' && key === 'note'
      ? parseEnemyNote(value, item.noteSegments)
      : undefined,
    elementStyle: getElementStyle(key, value),
    isIncomplete: isDataIncomplete && isEmptyValue(value),
  }));

const hasCostField = Array.isArray(item.cost);
const recipes = categorySlug === 'consumables' && Array.isArray(item.recipes) ? item.recipes : [];
const pieces = Array.isArray(item.pieces) ? item.pieces : [];
const eyebrow = item.tier ? `品阶 ${item.tier}` : '资料详情';
const tierColor = typeof item.tier === 'string' ? TIER_COLOR[item.tier] : undefined;
const qualityMeta = getQualityMeta(item.quality);
const qualityStyle = qualityMeta
  ? `--quality-border:${qualityMeta.border};--quality-glow:${qualityMeta.glow}`
  : undefined;
const titleColor = qualityMeta?.text ?? tierColor;
const recipeTitle = ['shields', 'amulets'].includes(categorySlug) ? '制作配方' : '合成配方';
const enemyConcepts = categorySlug === 'enemies' ? getEnemyConcepts(item.id) : [];
---

<article class="detail-grid">
  <aside>
    <ImageZoom
      src={iconSrc}
      alt={item.name}
      class={`detail-image${qualityMeta ? ' quality-icon' : ''}`}
      style={qualityStyle}
    />
  </aside>

  <div>
    <div class="page-heading">
      <p class="eyebrow" style={tierColor ? `color:${tierColor}` : undefined}>{eyebrow}</p>
      <h1 style={titleColor ? `color:${titleColor}` : undefined}>{item.name}</h1>
    </div>

    {attrRows.length > 0 && (
      <section class="panel">
        <h2 class="detail-panel-title">{attributeTitle}</h2>
        <table class="attr-table">
          <tbody>
            {attrRows.map((row) => (
              <tr>
                <th>{row.label}</th>
                  <td class:list={[row.isIncomplete && 'attr-value-incomplete']}>
                  {row.enemyNote ? (
                    <div class="enemy-note">
                      {row.enemyNote.intro && (
                        <p class="enemy-note-intro">
                          <QualityText text={row.enemyNote.intro} segments={row.enemyNote.introSegments} />
                        </p>
                      )}
                      {row.enemyNote.skills.map((skill) => (
                        <p class="enemy-note-skill">
                          <strong><QualityText text={skill.heading} segments={skill.headingSegments} /></strong>
                          {skill.lines.map((line) => (
                            <span class="enemy-note-line">
                              {line.mode ? (
                                <>
                                  <span style={getEnemyModeColor(line.mode) ? `color:${getEnemyModeColor(line.mode)}` : undefined}>
                                    {line.mode}
                                  </span>
                                  ：{line.text}
                                </>
                              ) : (
                                <QualityText text={line.text} segments={line.segments} />
                              )}
                            </span>
                          ))}
                        </p>
                      ))}
                    </div>
                  ) : row.elementStyle ? (
                    <span class="element-value" style={row.elementStyle}>{row.value}</span>
                  ) : (
                    row.value
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    )}

    <slot />

    {categorySlug === 'enemies' && <GroupNote blocks={item.groupNoteBlocks} group={item.group} />}

    {recipes.length > 0 && (
      <section class="section panel">
        <h2 class="detail-panel-title">制作配方</h2>
        <div class="piece-list">
          {recipes.map((recipe) => (
            <article class="piece-card consumable-recipe">
              {recipe.label && <h3>{recipe.label}</h3>}
              {recipe.items?.length > 0 && (
                <ul class="recipe-list compact consumable-recipe-list">
                  {recipe.items.map((recipeItem) => {
                    const ref = recipeItem.ref;
                    const refHref = ref?.cat && ref?.id ? `/${ref.cat}/${ref.id}` : undefined;
                    const refQualityMeta = getQualityMeta(ref?.quality ?? 'common');
                    const refQualityStyle = refQualityMeta
                      ? `--quality-border:${refQualityMeta.border};--quality-glow:${refQualityMeta.glow}`
                      : undefined;
                    const recipeItemContent = (
                      <>
                        {refHref && (
                          <img
                            class:list={['item-icon', refQualityMeta && 'quality-icon']}
                            src={getItemIconSrc(ref.cat, ref)}
                            alt={recipeItem.name}
                            loading="lazy"
                            style={refQualityStyle}
                            data-fallback={materialFallback}
                            onerror="this.onerror=null;this.src=this.dataset.fallback;this.classList.add('is-missing')"
                          />
                        )}
                        <span>
                          {recipeItem.name} ×{recipeItem.qty}
                          {recipeItem.note && `（${recipeItem.note}）`}
                        </span>
                      </>
                    );
                    return (
                      <li>
                        {refHref ? (
                          <a class="recipe-item-link" href={refHref}>{recipeItemContent}</a>
                        ) : (
                          <span class="recipe-item-unlinked">{recipeItemContent}</span>
                        )}
                      </li>
                    );
                  })}
                </ul>
              )}
              {recipe.yield && <p class="muted recipe-yield">得到{recipe.yield}</p>}
            </article>
          ))}
        </div>
      </section>
    )}

    {hasCostField && (
      <section class="section panel">
        <h2 class="detail-panel-title">{recipeTitle}</h2>
        {item.cost.length > 0 ? (
          <MaterialCostList cost={item.cost} />
        ) : (
          <p class="muted">该条目无法制作，可能只能掉落、购买或活动获取。</p>
        )}
      </section>
    )}

    {pieces.length > 0 && (
      <section class="section panel">
        <h2 class="detail-panel-title">套装部件</h2>
        <div class="piece-list">
          {pieces.map((piece) => {
            const pieceQualityMeta = getQualityMeta(piece.quality);
            const pieceQualityStyle = pieceQualityMeta
              ? `--quality-border:${pieceQualityMeta.border};--quality-glow:${pieceQualityMeta.glow}`
              : undefined;
            return (
              <article class="piece-card" id={piece.id}>
                <div class="piece-head">
                  <img
                    class:list={['item-icon', pieceQualityMeta && 'quality-icon']}
                    src={getItemIconSrc('armor-pieces', piece)}
                    alt={piece.name}
                    loading="lazy"
                    style={pieceQualityStyle}
                    data-fallback={materialFallback}
                    onerror="this.onerror=null;this.src=this.dataset.fallback;this.classList.add('is-missing')"
                  />
                  <div>
                    <h3 style={pieceQualityMeta ? `color:${pieceQualityMeta.text}` : undefined}>{piece.name}</h3>
                    <p class="muted">
                      护甲{formatValue('armor', piece.armor)}
                      {piece.protection ? `，元素防护${formatValue('protection', piece.protection)}` : ''}
                      {piece.effect ? `，${piece.effect}` : ''}
                    </p>
                  </div>
                </div>

                {piece.cost?.length > 0 ? (
                  <MaterialCostList cost={piece.cost} compact />
                ) : (
                  <p class="muted">该部件无合成配方。</p>
                )}
              </article>
            );
          })}
        </div>
      </section>
    )}

    {enemyConcepts.length > 0 && (
      <section class="enemy-concepts section panel">
        <h2 class="detail-panel-title">角色原画</h2>
        <div class="enemy-concepts-list">
          {enemyConcepts.map((concept) => (
            <figure class="enemy-concept">
              <ImageZoom
                src={`/images/concepts/${concept.file}`}
                alt={concept.caption}
                class="enemy-concept-image"
              />
              <figcaption class="enemy-concept-caption">
                <span>{concept.caption}</span>
                {concept.creditUrl ? (
                  <a
                    class="enemy-concept-credit"
                    href={concept.creditUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {concept.credit}
                  </a>
                ) : (
                  <span class="enemy-concept-credit">{concept.credit}</span>
                )}
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}
  </div>
</article>
