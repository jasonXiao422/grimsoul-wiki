---
interface Props {
  src: string;
  alt: string;
  class?: string;
  style?: string;
}

const { src, alt, class: className = '', style } = Astro.props;
const fallback =
  'data:image/svg+xml;charset=utf-8,' +
  encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 160 160"><rect width="160" height="160" fill="#1b1d21"/><path d="M38 116h84L99 83 82 102 67 72z" fill="#2c2f35"/><circle cx="58" cy="52" r="13" fill="#8a6f1a"/></svg>`);
---

<img
  class:list={['js-zoom-image', className]}
  src={src}
  alt={alt}
  style={style}
  loading="lazy"
  data-zoom-src={src}
  data-zoom-alt={alt}
  data-fallback={fallback}
  onerror="this.onerror=null;this.src=this.dataset.fallback;this.dataset.zoomSrc=this.dataset.fallback;this.classList.add('is-missing')"
/>

<script>
  const getImageDialog = () => {
    const existingDialog = document.querySelector<HTMLDialogElement>('[data-image-dialog]');
    if (existingDialog) return existingDialog;

    // 为不使用 BaseLayout 的独立页面保留惰性回退。
    const dialog = document.createElement('dialog');
    dialog.className = 'image-dialog';
    dialog.dataset.imageDialog = '';

    const closeButton = document.createElement('button');
    closeButton.type = 'button';
    closeButton.setAttribute('aria-label', '关闭');
    closeButton.textContent = '×';

    const dialogImage = document.createElement('img');
    dialog.append(closeButton, dialogImage);
    document.body.append(dialog);

    closeButton.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    return dialog;
  };

  document.addEventListener('click', (event) => {
    const image = event.target instanceof HTMLImageElement && event.target.matches('.js-zoom-image')
      ? event.target
      : undefined;
    if (!image) return;

    const dialog = getImageDialog();
    const dialogImage = dialog.querySelector('img');
    const zoomSrc = image.dataset.zoomSrc;
    if (!dialogImage || !zoomSrc) return;

    dialogImage.src = zoomSrc;
    dialogImage.alt = image.dataset.zoomAlt ?? image.alt;
    dialog.showModal();
  });
</script>
