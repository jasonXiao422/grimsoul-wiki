---
import ImageZoom from './ImageZoom.astro';

interface Props {
  containerSelector: string;
  bootstrapSrc: string;
}

const { containerSelector, bootstrapSrc } = Astro.props;
---

<div hidden aria-hidden="true">
  <ImageZoom src={bootstrapSrc} alt="" />
</div>

<script define:vars={{ containerSelector }}>
  const content = document.querySelector(containerSelector);
  content?.querySelectorAll('img').forEach((image) => {
    const src = image.getAttribute('src');
    if (!src) return;
    image.classList.add('js-zoom-image');
    image.dataset.zoomSrc = src;
    image.dataset.zoomAlt = image.getAttribute('alt') ?? '';
  });
</script>
