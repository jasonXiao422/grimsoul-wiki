---
import type { CategoryDef } from '../lib/categories';
import { TIER_COLOR } from '../lib/tiers';
import { getByPath, getItemIconSrc } from '../lib/data';
import { FIELD_LABELS, formatValue, getSortValue, splitEnemyDamageStages, stripEnemyDifficultySuffix } from '../lib/display';
import { normalizeElementName } from '../lib/quality';
import { QUALITY_META, elementColor, type Quality } from '../lib/quality';

interface Props {
  category: CategoryDef;
  items: Array<Record<string, any>>;
  externalSearchSelector?: string;
  externalFilterSelector?: string;
  hideFilters?: boolean;
}

const { category, items, externalSearchSelector, externalFilterSelector, hideFilters = false } = Astro.props;
const fallback =
  'data:image/svg+xml;charset=utf-8,' +
  encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 96 96"><rect width="96" height="96" fill="#1b1d21"/><path d="M21 69h54L61 48 49 61 39 41z" fill="#2c2f35"/><circle cx="36" cy="30" r="8" fill="#8a6f1a"/></svg>`);

const DAMAGE_TYPE_ORDER = ['火', '冰', '毒', '衰败', '雷', '流血', '纯物理'];
const getDamageTypes = (item: Record<string, any>) => {
  const types = new Set<string>();
  const directType = getByPath(item, 'element.type');
  const normalizedDirectType = typeof directType === 'string' ? normalizeElementName(directType) : undefined;
  if (normalizedDirectType && DAMAGE_TYPE_ORDER.includes(normalizedDirectType)) types.add(normalizedDirectType);

  for (const dotType of Array.isArray(item.dotTypes) ? item.dotTypes : []) {
    if (typeof dotType === 'string' && DAMAGE_TYPE_ORDER.includes(dotType === '点燃' ? '火' : dotType === '冻伤' ? '冰' : dotType === '中毒' ? '毒' : dotType === '流血' ? '流血' : dotType)) {
      types.add(dotType === '点燃' ? '火' : dotType === '冻伤' ? '冰' : dotType === '中毒' ? '毒' : dotType);
    }
  }

  if (types.size === 0) types.add('纯物理');
  return DAMAGE_TYPE_ORDER.filter((type) => types.has(type));
};

const getFilterOptions = (key: string) => {
  if (key === 'damageType') {
    const available = new Set(items.flatMap((item) => getDamageTypes(item)));
    return DAMAGE_TYPE_ORDER.filter((type) => available.has(type)).map((type) => [type, type]) as Array<[string, string]>;
  }
  if (key === 'isRanged') return [['true', '远程'], ['false', '近战']] as Array<[string, string]>;

  const values = new Map<string, string>();
  for (const item of items) {
    const raw = getByPath(item, key);
    const rawValues = Array.isArray(raw) ? raw : [raw ?? ''];
    for (const rawValue of rawValues) {
      const value = rawValue === null || rawValue === undefined || rawValue === ''
        ? '__none'
        : key.endsWith('.type') && typeof rawValue === 'string'
          ? normalizeElementName(rawValue) ?? rawValue
          : String(rawValue);
      values.set(value, formatValue(key, rawValue));
    }
  }
  return [...values.entries()].sort((a, b) => a[1].localeCompare(b[1], 'zh-Hans-CN'));
};

const getRowFilterValue = (key: string, value: unknown, item?: Record<string, any>) => {
  if (key === 'damageType' && item) return getDamageTypes(item).join('|');
  if (Array.isArray(value)) return value.map((item) => getRowFilterValue(key, item)).join('|');
  if (value === null || value === undefined || value === '') return '__none';
  if (key.endsWith('.type') && typeof value === 'string') return normalizeElementName(value) ?? value;
  return String(value);
};

const getFilterPlaceholder = (key: string) => key === 'damageType'
  ? '全部伤害类型'
  : key === 'isRanged'
    ? '远程/近战'
    : key === 'hasBlueprint'
      ? '有无图纸'
      : key === 'obtainSources'
        ? '实体获取途径'
        : key === 'blueprintSources'
          ? '图纸获取途径'
    : `全部${FIELD_LABELS[key] ?? '筛选项'}`;

const getDisplayValue = (item: Record<string, any>, key: string, value: unknown) => {
  if ((value === null || value === undefined || value === '') && item.dataIncomplete) return '数据待补充';
  return formatValue(key, value);
};

const getListDisplayValue = (item: Record<string, any>, key: string, value: unknown) => {
  const displayValue = getDisplayValue(item, key, value);
  if (category.slug === 'armor' && key === 'name') return displayValue.replace(/（T\d+\+?级）$/, '');
  if (category.slug === 'enemies' && key === 'name' && typeof displayValue === 'string') {
    return stripEnemyDifficultySuffix(displayValue);
  }
  return displayValue;
};

const getElementColor = (value: unknown) => {
  if (!value || typeof value !== 'object') return undefined;
  const type = (value as Record<string, unknown>).type;
  return typeof type === 'string' ? elementColor(type) : undefined;
};

const getElementDamageValue = (value: unknown) =>
  value && typeof value === 'object' ? (value as Record<string, unknown>).value : undefined;

const getElementLabel = (value: unknown) => {
  if (!value || typeof value !== 'object') return '';
  return formatValue('elementDamage', { ...(value as Record<string, unknown>), value: null });
};

const getQualityMeta = (item: Record<string, any>) => {
  const quality = typeof item.quality === 'string' ? item.quality as Quality : undefined;
  return quality ? QUALITY_META[quality] : undefined;
};

const tableRows: Array<{ type: 'group'; label: string } | { type: 'item'; item: Record<string, any> }> = [];
let currentGroup = '';
for (const item of items) {
  if (category.groupBy) {
    const groupLabel = formatValue(category.groupBy, getByPath(item, category.groupBy));
    if (groupLabel !== currentGroup) {
      currentGroup = groupLabel;
      tableRows.push({ type: 'group', label: groupLabel });
    }
  }
  tableRows.push({ type: 'item', item });
}
---

<section
  class:list={['data-table-block', `table-${category.slug}`]}
  data-table-root
  data-external-filter-selector={externalFilterSelector}
  data-source-hint={category.sourceHint ? 'true' : undefined}
>
  <div class="table-tools">
    {externalSearchSelector ? (
      <div aria-hidden="true"></div>
    ) : (
      <label>
        <span class="sr-only">搜索当前列表</span>
        <input class="search-input" type="search" data-table-search placeholder={`搜索${category.label}`} />
      </label>
    )}
    {category.filters.length > 0 && !hideFilters && (
      <div class="filter-bar">
        {category.filters.map((filterKey) => (
          <label>
            <span class="sr-only">{FIELD_LABELS[filterKey] ?? '筛选项'}</span>
            <select class="filter-select" data-filter={filterKey}>
              <option value="">{getFilterPlaceholder(filterKey)}</option>
              {getFilterOptions(filterKey).map(([value, label]) => (
                <option value={value}>{label}</option>
              ))}
            </select>
          </label>
        ))}
      </div>
    )}
  </div>

  {category.slug === 'enemies' && (
    <p class="muted">
      部分敌人区分难度。数值按「普通 / 英雄 / 传奇」顺序排列,<span style={`color:${QUALITY_META.unique.text}`}>橙色</span>为英雄数据,<span style={`color:${QUALITY_META.legendary.text}`}>紫色</span>为传奇数据。少数敌人只有普通与英雄两档。
    </p>
  )}

  <div class="table-scroll">
    <table class="data-table">
      <thead>
        <tr>
          {category.columns.map((column) => (
            <th class:list={[column.numeric && 'numeric']}>
              {column.sortable ? (
                <button type="button" data-sort-key={column.key}>{column.label}</button>
              ) : (
                column.label
              )}
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {tableRows.map((row) => {
          if (row.type === 'group') {
            return (
              <tr class="group-row" data-group-row>
                <th colspan={category.columns.length}>{row.label}</th>
              </tr>
            );
          }

          const item = row.item;
          const qualityMeta = getQualityMeta(item);
          const qualityStyle = qualityMeta
            ? `--quality-border:${qualityMeta.border};--quality-glow:${qualityMeta.glow}`
            : undefined;
          const hasSourceData = category.sourceHint && (
            (Array.isArray(item.obtainSources) && item.obtainSources.length > 0) ||
            (Array.isArray(item.blueprintSources) && item.blueprintSources.length > 0)
          );
          return (
            <>
              <tr
                data-row
                data-source-item-id={category.sourceHint ? item.id : undefined}
                data-search-name={category.sourceHint ? getListDisplayValue(item, 'name', getByPath(item, 'name')) : undefined}
                data-search={[...
                  category.columns.map((column) => getDisplayValue(item, column.key, getByPath(item, column.key))),
                  ...(category.sourceHint ? [
                    ...(Array.isArray(item.obtainSources) ? item.obtainSources : []),
                    ...(Array.isArray(item.blueprintSources) ? item.blueprintSources : []),
                  ] : []),
                ].join(' ')}
                {...Object.fromEntries(category.filters.map((filter) => [`data-filter-${filter}`, getRowFilterValue(filter, getByPath(item, filter), item)]))}
              >
              {category.columns.map((column, index) => {
                const rawValue = getByPath(item, column.key);
                const value = getListDisplayValue(item, column.key, rawValue);
                const compareKey = column.sortKey ?? column.key;
                const sortRawValue = getByPath(item, compareKey);
                const sortValue = getSortValue(compareKey, sortRawValue);
                const sortEmpty = sortRawValue === null || sortRawValue === undefined || sortRawValue === '';
                const stagedDamage = category.slug === 'enemies'
                  ? splitEnemyDamageStages(
                    column.key === 'elementDamage'
                      ? getElementDamageValue(rawValue)
                      : ['hp', 'damageReduction', 'physicalDamage'].includes(column.key)
                        ? rawValue
                        : undefined,
                  )
                  : undefined;
                const elementLabel = column.key === 'elementDamage' ? getElementLabel(rawValue) : '';
                return (
                  <td
                    class:list={[column.numeric && 'numeric']}
                    data-label={index === 0 ? undefined : column.label}
                    data-sort-value={sortEmpty ? '' : sortValue}
                    data-sort-empty={sortEmpty ? 'true' : undefined}
                    data-source-cell={index === 0 && category.sourceHint && (Array.isArray(item.obtainSources) && item.obtainSources.length > 0 || Array.isArray(item.blueprintSources) && item.blueprintSources.length > 0) ? '' : undefined}
                    data-obtain={index === 0 && category.sourceHint ? JSON.stringify(item.obtainSources ?? []) : undefined}
                    data-blueprint={index === 0 && category.sourceHint ? JSON.stringify(item.blueprintSources ?? []) : undefined}
                  >
                    {index === 0 ? (
                      <span class="item-name-with-source">
                      <a class="item-cell" href={`/${category.slug}/${item.id}`}>
                        <img
                          class:list={['item-icon', qualityMeta && 'quality-icon']}
                          src={getItemIconSrc(category.slug, item)}
                          alt={item.name}
                          style={qualityStyle}
                          data-fallback={fallback}
                          onerror="this.onerror=null;this.src=this.dataset.fallback;this.classList.add('is-missing')"
                        />
                        <strong style={qualityMeta ? `color:${qualityMeta.text}` : undefined}>{value}</strong>
                      </a>
                      {category.sourceHint && (Array.isArray(item.obtainSources) && item.obtainSources.length > 0 || Array.isArray(item.blueprintSources) && item.blueprintSources.length > 0) && (
                        <button
                          type="button"
                          class="source-hint"
                          aria-label="查看获取途径"
                        >
                          <svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
                            <circle cx="12" cy="12" r="8.5" />
                            <path d="M12 10.5v5" />
                            <circle cx="12" cy="7.5" r="0.7" fill="currentColor" stroke="none" />
                          </svg>
                        </button>
                      )}
                      </span>
                    ) : column.render === 'tier' && rawValue ? (
                      <span class="tier-badge" style={`color:${TIER_COLOR[String(rawValue)] ?? 'var(--accent)'}`}>{value}</span>
                    ) : column.render === 'element' && rawValue !== null && rawValue !== undefined && rawValue !== '' && value !== '数据待补充' ? (
                      stagedDamage && column.key === 'elementDamage' ? (
                        <span class="element-value">
                          <span style={`color:${getElementColor(rawValue) ?? 'var(--text)'}`}>{elementLabel}</span>
                          {stagedDamage.map((part) => part.quality
                            ? <span style={`color:${QUALITY_META[part.quality].text}`}>{part.text}</span>
                            : part.text)}
                        </span>
                      ) : (
                        <span class="element-value" style={`color:${getElementColor(rawValue) ?? 'var(--text)'}`}>{value}</span>
                      )
                    ) : stagedDamage ? (
                      stagedDamage.map((part) => part.quality
                        ? <span style={`color:${QUALITY_META[part.quality].text}`}>{part.text}</span>
                        : part.text)
                    ) : column.render === 'list' && Array.isArray(rawValue) ? (
                      <span class="tag-list">{rawValue.map((entry) => <span class="tag">{formatValue(column.key, entry)}</span>)}</span>
                    ) : (
                      value
                    )}
                    {false && (
                      <button
                        type="button"
                        class="source-hint"
                        aria-label="查看获取途径"
                      >
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
                          <circle cx="12" cy="12" r="8.5" />
                          <path d="M12 10.5v5" />
                          <circle cx="12" cy="7.5" r="0.7" fill="currentColor" stroke="none" />
                        </svg>
                      </button>
                    )}
                  </td>
                );
              })}
              </tr>
              {hasSourceData && (
                <tr class="source-row" data-source-for={item.id} hidden>
                  <td colspan={category.columns.length}>
                    <div class="source-row-content">
                      {Array.isArray(item.obtainSources) && item.obtainSources.length > 0 && (
                        <div class="source-row-group">
                          <p class="source-row-title">实体获取途径</p>
                          <div class="tag-list">{item.obtainSources.map((value: string) => <span class="tag">{value}</span>)}</div>
                        </div>
                      )}
                      {Array.isArray(item.blueprintSources) && item.blueprintSources.length > 0 && (
                        <div class="source-row-group">
                          <p class="source-row-title">图纸获取途径</p>
                          <div class="tag-list">{item.blueprintSources.map((value: string) => <span class="tag">{value}</span>)}</div>
                        </div>
                      )}
                    </div>
                  </td>
                </tr>
              )}
            </>
          );
        })}
      </tbody>
    </table>
  </div>
  <p class="muted" data-empty hidden>没有找到符合条件的条目。</p>
</section>

<script>
  import { onPageReady } from '../lib/lifecycle';

  const initDataTables = () => {
  const roots = document.querySelectorAll<HTMLElement>('[data-table-root]:not([data-initialized])');

  roots.forEach((root) => {
    try {
    const externalFilterSelector = root.dataset.externalFilterSelector;
    const hasSourceRows = root.dataset.sourceHint === 'true';
    const search = root.querySelector<HTMLInputElement>('[data-table-search]')
      ?? document.querySelector<HTMLInputElement>('[data-armor-search]');
    const filters = externalFilterSelector
      ? [...document.querySelectorAll<HTMLSelectElement>(externalFilterSelector)]
      : [...root.querySelectorAll<HTMLSelectElement>('[data-filter]')];
    const tbody = root.querySelector<HTMLTableSectionElement>('tbody');
    const empty = root.querySelector<HTMLElement>('[data-empty]');
    let sortState = { key: '', direction: 1 };

    const rows = () => [...root.querySelectorAll<HTMLTableRowElement>('[data-row]')];

    const applyFilters = () => {
      const query = (search?.value ?? '').trim().toLocaleLowerCase('zh-Hans-CN');
      let visibleCount = 0;

      rows().forEach((row) => {
        const searchText = hasSourceRows ? row.dataset.searchName ?? '' : row.dataset.search ?? '';
        const matchesSearch = !query || searchText.toLocaleLowerCase('zh-Hans-CN').includes(query);
        const matchesFilters = filters.every((filter) => {
          if (!filter.value) return true;
          const key = filter.dataset.filter ?? '';
          const rowValue = row.getAttribute(`data-filter-${key}`) ?? '';
          return rowValue.split('|').includes(filter.value);
        });
        const visible = matchesSearch && matchesFilters;
        row.hidden = !visible;
        const sourceRow = row.nextElementSibling?.matches('.source-row')
          ? row.nextElementSibling as HTMLTableRowElement
          : null;
        if (hasSourceRows && sourceRow) sourceRow.hidden = !query || !visible;
        if (visible) visibleCount += 1;
      });

      if (empty) empty.hidden = visibleCount !== 0;

      [...root.querySelectorAll<HTMLTableRowElement>('[data-group-row]')].forEach((groupRow) => {
        let next = groupRow.nextElementSibling as HTMLTableRowElement | null;
        let hasVisibleRow = false;
        while (next && !next.hasAttribute('data-group-row')) {
          if (next.hasAttribute('data-row') && !next.hidden) {
            hasVisibleRow = true;
            break;
          }
          next = next.nextElementSibling as HTMLTableRowElement | null;
        }
        groupRow.hidden = !hasVisibleRow;
      });

      if (externalFilterSelector) {
        document.dispatchEvent(new CustomEvent('data-table:filtered', { detail: { root } }));
      }
    };

    const sortRows = (key: string) => {
      if (!tbody) return;
      sortState = sortState.key === key
        ? { key, direction: sortState.direction * -1 }
        : { key, direction: 1 };
      const headerButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-sort-key]')];
      const columnIndex = headerButtons.findIndex((button) => button.dataset.sortKey === key);
      if (columnIndex < 0) return;

      rows()
        .sort((a, b) => {
          const aCell = a.children[columnIndex];
          const bCell = b.children[columnIndex];
          const aEmpty = aCell?.getAttribute('data-sort-empty') === 'true';
          const bEmpty = bCell?.getAttribute('data-sort-empty') === 'true';
          if (aEmpty !== bEmpty) return aEmpty ? 1 : -1;
          const aValue = aCell?.getAttribute('data-sort-value') ?? '';
          const bValue = bCell?.getAttribute('data-sort-value') ?? '';
          const aNumber = Number(aValue);
          const bNumber = Number(bValue);
          const result = Number.isFinite(aNumber) && Number.isFinite(bNumber)
            ? aNumber - bNumber
            : aValue.localeCompare(bValue, 'zh-Hans-CN');
          return result * sortState.direction;
        })
        .forEach((row) => {
          const sourceRow = row.nextElementSibling?.matches('.source-row')
            ? row.nextElementSibling as HTMLTableRowElement
            : null;
          tbody.append(row);
          if (hasSourceRows && sourceRow) tbody.append(sourceRow);
        });

      if (externalFilterSelector) {
        document.dispatchEvent(new CustomEvent('data-table:sorted', { detail: { root } }));
      }
    };

    if (hasSourceRows) {
      let isComposing = false;
      search?.addEventListener('compositionstart', () => {
        isComposing = true;
      });
      search?.addEventListener('compositionend', () => {
        isComposing = false;
        applyFilters();
      });
      search?.addEventListener('input', (event) => {
        if (isComposing || (event as InputEvent).isComposing) return;
        applyFilters();
      });
    } else {
      search?.addEventListener('input', applyFilters);
    }
    filters.forEach((filter) => filter.addEventListener('change', applyFilters));
    root.querySelectorAll<HTMLButtonElement>('[data-sort-key]').forEach((button) => {
      button.addEventListener('click', () => sortRows(button.dataset.sortKey ?? ''));
    });

    const params = new URLSearchParams(window.location.search);
    const searchQuery = params.get('q');
    if (searchQuery !== null && search) {
      search.value = searchQuery;
    }
    filters.forEach((filter) => {
      const key = filter.dataset.filter;
      const value = key ? params.get(key) : null;
      if (value !== null && [...filter.options].some((option) => option.value === value)) {
        filter.value = value;
      }
    });
    root.dataset.initialized = 'true';
    applyFilters();
    } catch (error) {
      console.error('[data-table] 初始化失败', error);
    }
  });
  };

  const initSourceHintListeners = () => {
    const sourceWindow = window as Window & { __grimsoulSourceHintListeners?: boolean };
    if (true) return;
    sourceWindow.__grimsoulSourceHintListeners = true;

    let popover: HTMLDivElement | null = null;
    let activeButton: HTMLButtonElement | null = null;
    let hideTimer = 0;
    const pointerTypes = new WeakMap<HTMLButtonElement, string>();

    const getPopover = () => {
      if (!popover || !document.body.contains(popover)) {
        popover = document.createElement('div');
        popover.className = 'source-popover';
        popover.setAttribute('role', 'tooltip');
        popover.hidden = true;
        document.body.append(popover);
      }
      return popover;
    };

    const clearHideTimer = () => {
      window.clearTimeout(hideTimer);
      hideTimer = 0;
    };

    const hide = () => {
      clearHideTimer();
      activeButton?.setAttribute('aria-expanded', 'false');
      activeButton = null;
      if (popover) popover.hidden = true;
    };

    const scheduleHide = () => {
      clearHideTimer();
      hideTimer = window.setTimeout(hide, 150);
    };

    const readSources = (value: string | undefined) => {
      try {
        const parsed = JSON.parse(value || '[]');
        return Array.isArray(parsed) ? parsed.filter((entry): entry is string => typeof entry === 'string' && entry.length > 0) : [];
      } catch {
        return [];
      }
    };

    const show = (button: HTMLButtonElement) => {
      clearHideTimer();
      const currentPopover = getPopover();
      currentPopover.replaceChildren();
      const groups = [
        ['实体获取途径', readSources(button.dataset.obtain)],
        ['图纸获取途径', readSources(button.dataset.blueprint)],
      ] as const;
      groups.forEach(([label, values]) => {
        if (values.length === 0) return;
        const group = document.createElement('div');
        const title = document.createElement('p');
        title.className = 'source-popover-title';
        title.textContent = label;
        const tags = document.createElement('div');
        tags.className = 'tag-list';
        values.forEach((value) => {
          const tag = document.createElement('span');
          tag.className = 'tag';
          tag.textContent = value;
          tags.append(tag);
        });
        group.append(title, tags);
        currentPopover.append(group);
      });
      activeButton?.setAttribute('aria-expanded', 'false');
      activeButton = button;
      button.setAttribute('aria-expanded', 'true');
      currentPopover.hidden = false;
      const buttonRect = button.getBoundingClientRect();
      const popoverWidth = currentPopover.offsetWidth;
      const popoverHeight = currentPopover.offsetHeight;
      const margin = 8;
      const left = Math.min(Math.max(margin, buttonRect.left), Math.max(margin, window.innerWidth - popoverWidth - margin));
      const below = buttonRect.bottom + margin;
      const top = below + popoverHeight <= window.innerHeight - margin || buttonRect.top - margin - popoverHeight < margin
        ? below
        : buttonRect.top - margin - popoverHeight;
      currentPopover.style.left = `${left}px`;
      currentPopover.style.top = `${Math.max(margin, top)}px`;
    };

    document.addEventListener('pointerdown', (event) => {
      const button = (event.target as Element | null)?.closest?.('.source-hint') as HTMLButtonElement | null;
      if (button) pointerTypes.set(button, event.pointerType);
    });
    document.addEventListener('pointerover', (event) => {
      if (event.pointerType !== 'mouse') return;
      const button = (event.target as Element | null)?.closest?.('.source-hint') as HTMLButtonElement | null;
      if (button) show(button);
      if (popover && (event.target === popover || popover.contains(event.target as Node))) clearHideTimer();
    });
    document.addEventListener('pointerout', (event) => {
      if (event.pointerType !== 'mouse') return;
      const target = event.target as Node | null;
      const related = event.relatedTarget as Node | null;
      if ((target && (target as Element).closest?.('.source-hint')) || (popover && popover.contains(target))) {
        if (!related || (activeButton && activeButton.contains(related)) || (popover && popover.contains(related))) return;
        scheduleHide();
      }
    });
    document.addEventListener('focusin', (event) => {
      const button = (event.target as Element | null)?.closest?.('.source-hint') as HTMLButtonElement | null;
      if (button) show(button);
    });
    document.addEventListener('focusout', (event) => {
      if ((event.target as Element | null)?.closest?.('.source-hint')) hide();
    });
    document.addEventListener('click', (event) => {
      const target = event.target as Element | null;
      const button = target?.closest?.('.source-hint') as HTMLButtonElement | null;
      if (button) {
        event.preventDefault();
        event.stopPropagation();
        const pointerType = pointerTypes.get(button);
        pointerTypes.delete(button);
        if (pointerType === 'touch' || pointerType === 'pen') {
          if (activeButton === button && popover && !popover.hidden) hide();
          else show(button);
        }
        return;
      }
      if (activeButton && (!popover || !popover.contains(target as Node))) hide();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') hide();
    });
    window.addEventListener('scroll', hide, { passive: true });
    window.addEventListener('resize', hide);
    document.addEventListener('astro:before-swap', hide);
  };

  onPageReady(() => {
    initDataTables();
    initSourceHintListeners();
  });
</script>
