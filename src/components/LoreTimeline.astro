---
const timelineEvents = [
  {
    era: '落光七年',
    label: '建国',
    title: '罗伯特三世建立神光永久帝国',
    body: '达格利亚国王与赫拉特教结盟——他宣布赫拉特教为国教，教会承认他是光明神在地上的代理人。数年之内，他吞并了法尔维斯、卡迪许、卢比尼亚与本恩。',
    orders: ['战犬', '黄昏骑士', '黄昏利刃'],
    note: '这三支骑士团，是女巫凯拉要求组建的',
    href: '/lore/02-chronicle',
  },
  {
    era: '落光三十七年',
    label: '诅咒应验',
    title: '凯拉之死与皇帝暴毙',
    body: '祭司施压，皇帝派出圣殿杀手杀死了凯拉。她临死前留下诅咒：当皇室有两个儿子时，年轻的将吞下年长的，而死神将坐在王位上。六个月后，罗伯特三世死于自己的卧室，死状可怕，无人知道发生了什么。',
    orders: ['黑乌鸦'],
    note: '杀死凯拉的那个人，被封为第四骑士团之主',
    href: '/lore/02-chronicle',
  },
  {
    era: '三个世纪后',
    label: '双子降生',
    title: '威廉一世与那道预言',
    body: '罗伯特的十四代孙架空了祭司，另建四支只服从自己的骑士团。直到他的妃子生下双胞胎——祭司搬出古老预言要求处死幼子，他只答应把其中一个送往远方的城堡。愤怒的祭司密谋多年，最终毒死了他。',
    orders: ['红天使', '白盾', '帝国雄狮', '破碎机'],
    note: '预言开始应验',
    href: '/lore/02-chronicle',
  },
  {
    era: '约翰一世',
    label: '三次进军',
    title: '十二岁的皇帝与三次背叛',
    body: '约翰一世继位时只有十二岁，在祭司胁迫下同意杀死自己的弟弟。女祭司艾莎拒绝执行，带着孩子逃入卢比尼亚森林。此后帝国三次进军瘟疫之地，每一次都毁在自己人手里。',
    orders: ['酷吏', '被弃者', '黄昏利刃'],
    note: '帝国失去了五支最精锐的骑士团',
    href: '/lore/05-three-campaigns',
  },
];
---

<section class="lore-timeline" data-lore-switcher aria-labelledby="lore-timeline-title">
  <div class="lore-section-heading">
    <p class="eyebrow">关键纪年</p>
    <h2 id="lore-timeline-title">灰蚀之地时间线</h2>
  </div>

  <div class="lore-timeline-track" role="tablist" aria-label="背景故事关键节点">
    {timelineEvents.map((event, index) => (
      <button
        class:list={['lore-timeline-node', index === 0 && 'is-active']}
        type="button"
        role="tab"
        aria-selected={index === 0 ? 'true' : 'false'}
        aria-controls={`timeline-panel-${index}`}
        id={`timeline-tab-${index}`}
        tabindex={index === 0 ? '0' : '-1'}
        data-lore-choice
        data-index={index}
      >
        <span class="lore-timeline-dot" aria-hidden="true"></span>
        <span class="lore-timeline-era">{event.era}</span>
        <span class="lore-timeline-label">{event.label}</span>
      </button>
    ))}
  </div>

  <div class="lore-switch-panels">
    {timelineEvents.map((event, index) => (
      <article
        class="lore-switch-panel"
        id={`timeline-panel-${index}`}
        role="tabpanel"
        aria-labelledby={`timeline-tab-${index}`}
        hidden={index !== 0}
        data-lore-panel
      >
        <h3>{event.title}</h3>
        <p>{event.body}</p>
        <div class="lore-chip-list" aria-label="相关骑士团">
          {event.orders.map((order) => <span>{order}</span>)}
        </div>
        <p class="lore-panel-note">{event.note}</p>
        <a class="lore-read-link" href={event.href}>阅读全篇 →</a>
      </article>
    ))}
  </div>
</section>

<script>
  const switcherRoots = document.querySelectorAll<HTMLElement>('.lore-timeline[data-lore-switcher]');

  switcherRoots.forEach((root) => {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-lore-choice]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-lore-panel]')];

    const activate = (nextIndex: number, focus = false) => {
      buttons.forEach((button, index) => {
        const active = index === nextIndex;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-selected', String(active));
        button.tabIndex = active ? 0 : -1;
      });

      panels.forEach((panel, index) => {
        panel.hidden = index !== nextIndex;
      });

      if (focus) buttons[nextIndex]?.focus();
    };

    buttons.forEach((button, index) => {
      button.addEventListener('click', () => activate(index));
      button.addEventListener('keydown', (event) => {
        const last = buttons.length - 1;
        let nextIndex = index;

        if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') nextIndex = index === 0 ? last : index - 1;
        else if (event.key === 'ArrowRight' || event.key === 'ArrowDown') nextIndex = index === last ? 0 : index + 1;
        else if (event.key === 'Home') nextIndex = 0;
        else if (event.key === 'End') nextIndex = last;
        else return;

        event.preventDefault();
        activate(nextIndex, true);
      });
    });
  });
</script>
