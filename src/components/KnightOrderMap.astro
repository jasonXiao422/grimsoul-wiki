---
import knightOrders from '../data/knight-orders.json';
import { ORDER_ERA_SEQUENCE, getOrderStatusLabel } from '../lib/knight-orders';

type KnightOrder = (typeof knightOrders)[number];

const groups = ORDER_ERA_SEQUENCE.map((era) => {
  const items = (knightOrders as KnightOrder[]).filter((item) => item.era === era);
  return {
    era,
    label: items[0]?.eraLabel ?? era,
    items,
  };
}).filter((group) => group.items.length > 0);
---

<section class="knight-order-map" aria-labelledby="knight-order-map-title">
  <div class="lore-section-heading">
    <p class="eyebrow">骑士团谱系</p>
    <h2 id="knight-order-map-title">十四支骑士团</h2>
  </div>

  <div class="knight-legend" aria-label="状态图例">
    <span data-status="loyal">仍效忠</span>
    <span data-status="fallen">遭背叛而覆灭</span>
    <span data-status="turned">倒向异神</span>
    <span data-status="outside">立场特殊</span>
  </div>

  <div class="knight-group-list" aria-label="骑士团列表">
    {groups.map((group) => (
      <section class="knight-group" aria-labelledby={`knight-map-${group.era}`}>
        <h3 id={`knight-map-${group.era}`}>{group.label}</h3>
        <div class="knight-grid">
          {group.items.map((order) => (
            <a class="knight-order-button" href={`/orders/${order.id}`} data-status={order.status}>
              <span>{order.name}</span>
              <small>{getOrderStatusLabel(order.status)}</small>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</section>
