---
const orderGroups = [
  {
    founder: '凯拉时代 · 罗伯特三世',
    orders: [
      { name: '战犬', status: 'turned', statusLabel: '倒向异神', detail: '被征服民众中最强壮者组成的狂战士。领主卡恩在马克斯的宴会上被下毒，此后杀死祭司、被打上叛徒烙印，率部逃入瘟疫之地的古老地下城，自称酷吏。' },
      { name: '黄昏骑士', status: 'fallen', statusLabel: '遭背叛而覆灭', detail: '西部游牧民族自愿效忠。第二次进军中遭黑乌鸦偷袭，领主佩雷格林被俘。他是在酷刑之下才把余部诱入陷阱的——这支骑士团没有选择过自己的结局。' },
      { name: '黄昏利刃', status: 'turned', statusLabel: '倒向异神', detail: '由有前科者和死囚组成，又称黄昏迫害者。领主马克斯被鬼附体后叛变，当着伊万的面倒戈。他最终力竭死于夜游神之手，余部去向不明。' },
      { name: '黑乌鸦', status: 'outside', statusLabel: '立场特殊', detail: '第一任领主，就是奉命杀死凯拉的那个圣殿杀手。福金领主目睹夜游神归来后，判定帝国正面打不赢冷酷国王，于是召唤瘟疫之神、散布灰色死神，把卢比尼亚变成无名之神跨不过去的缓冲带。他从未想过推翻帝国——他是在用一个行省的性命，为帝国换取重建军队的时间。编制完好，至今暗中行事。' },
    ],
  },
  {
    founder: '教会时代 · 赫拉特委员会',
    orders: [
      { name: '帝国之影', status: 'outside', statusLabel: '立场特殊', detail: '落光四十二年由赫拉特高级委员会组建，名义上保护君主。但他们真正效忠的是教会，因此一百多年后被威廉一世解散。' },
      { name: '哀悼死神', status: 'turned', statusLabel: '倒向异神', detail: '第六骑士团，只招募藐视痛苦的扎卡人。领主罗格沃尔投向的是无名之神而非瘟疫之神。他率全团在险恶城堡自尽，复活为忘记过去的幽灵。' },
      { name: '钢狼', status: 'loyal', statusLabel: '仍效忠', detail: '第七骑士团，从新近改信赫拉特教的野蛮部落招募。曾派小队前往险恶城堡搜寻异端文字，遭遇罗格沃尔的影子军队后撤退。' },
      { name: '第八个骑士团', status: 'loyal', statusLabel: '仍效忠', detail: '成员是职业女巫猎杀者与帝国最著名的决斗士。不以军事编制作战，而是作为探子与秘密间谍活动。' },
    ],
  },
  {
    founder: '皇权时代 · 威廉一世',
    orders: [
      { name: '红天使', status: 'loyal', statusLabel: '仍效忠', detail: '象征皇帝的仁慈。抗命庇护尚未失去理智的感染者，秘密护送他们前往瘟疫之地。你就是被他们送来的。领主塞巴斯蒂安·科尔。' },
      { name: '白盾', status: 'loyal', statusLabel: '仍效忠', detail: '象征皇帝的慷慨。奉命沿卢比尼亚四周修筑要塞与高墙，把这片土地彻底隔绝。地图最下方那排墙就是他们建的。' },
      { name: '帝国雄狮', status: 'fallen', statusLabel: '遭背叛而覆灭', detail: '帝国最强，军官是全国军事素养最高的骑士。第二次进军中，他们正在为黄昏利刃的到来大声叫好——然后被从背后捅穿。编制彻底消失，领主伊万隐居北方。' },
      { name: '破碎机', status: 'turned', statusLabel: '倒向异神', detail: '擅长挖地道与爆破攻城。第三次进军中遭帝国子弟兵背刺，领主艾森博格被俘后被祭司洗脑。他们是走投无路才改信的，但仍杀掉了所有不肯改信的弟兄。' },
    ],
  },
  {
    founder: '末期',
    orders: [
      { name: '帝国信使', status: 'loyal', statusLabel: '仍效忠', detail: '领主英格玛。第三次进军中军容整齐地撤出战斗——他无法凭自己去攻击王子。' },
      { name: '帝国子弟兵', status: 'turned', statusLabel: '倒向异神', detail: '卢瑟王子组建，只收贵族与雇佣兵的子弟。建团仅一年就背刺了破碎机骑士团。这是十四支骑士团里唯一一支主动接受瘟疫之神礼物的队伍。' },
    ],
  },
];

const orders = orderGroups.flatMap((group) => group.orders.map((order) => ({ ...order, founder: group.founder })));
---

<section class="knight-order-map" data-lore-switcher aria-labelledby="knight-order-map-title">
  <div class="lore-section-heading">
    <p class="eyebrow">骑士团谱系</p>
    <h2 id="knight-order-map-title">十四支骑士团</h2>
  </div>

  <div class="knight-legend" aria-label="状态图例">
    <span data-status="loyal">仍效忠</span>
    <span data-status="fallen">遭背叛而覆灭</span>
    <span data-status="turned">倒向异神</span>
    <span data-status="outside">立场特殊</span>
  </div>

  <div class="knight-group-list" role="tablist" aria-label="骑士团列表">
    {orderGroups.map((group) => (
      <section class="knight-group" aria-label={group.founder}>
        <h3>{group.founder}</h3>
        <div class="knight-grid">
          {group.orders.map((order) => {
            const index = orders.findIndex((item) => item.name === order.name);
            return (
              <button
                class:list={['knight-order-button', index === 0 && 'is-active']}
                type="button"
                role="tab"
                aria-selected={index === 0 ? 'true' : 'false'}
                aria-controls={`knight-panel-${index}`}
                id={`knight-tab-${index}`}
                tabindex={index === 0 ? '0' : '-1'}
                data-lore-choice
                data-index={index}
                data-status={order.status}
              >
                <span>{order.name}</span>
                <small>{order.statusLabel}</small>
              </button>
            );
          })}
        </div>
      </section>
    ))}
  </div>

  <div class="lore-switch-panels">
    {orders.map((order, index) => (
      <article
        class="knight-detail-panel lore-switch-panel"
        id={`knight-panel-${index}`}
        role="tabpanel"
        aria-labelledby={`knight-tab-${index}`}
        hidden={index !== 0}
        data-lore-panel
      >
        <div>
          <p class="muted">{order.founder}</p>
          <h3>{order.name}</h3>
        </div>
        <span class="knight-status-badge" data-status={order.status}>{order.statusLabel}</span>
        <p>{order.detail}</p>
      </article>
    ))}
  </div>
</section>

<script>
  const knightRoots = document.querySelectorAll<HTMLElement>('.knight-order-map[data-lore-switcher]');

  knightRoots.forEach((root) => {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-lore-choice]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-lore-panel]')];

    const activate = (nextIndex: number, focus = false) => {
      buttons.forEach((button, index) => {
        const active = index === nextIndex;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-selected', String(active));
        button.tabIndex = active ? 0 : -1;
      });

      panels.forEach((panel, index) => {
        panel.hidden = index !== nextIndex;
      });

      if (focus) buttons[nextIndex]?.focus();
    };

    buttons.forEach((button, index) => {
      button.addEventListener('click', () => activate(index));
      button.addEventListener('keydown', (event) => {
        const last = buttons.length - 1;
        let nextIndex = index;

        if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') nextIndex = index === 0 ? last : index - 1;
        else if (event.key === 'ArrowRight' || event.key === 'ArrowDown') nextIndex = index === last ? 0 : index + 1;
        else if (event.key === 'Home') nextIndex = 0;
        else if (event.key === 'End') nextIndex = last;
        else return;

        event.preventDefault();
        activate(nextIndex, true);
      });
    });
  });
</script>
