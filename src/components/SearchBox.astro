<div class="site-search" data-site-search>
  <label>
    <span class="sr-only">全站搜索</span>
    <input class="search-input" type="search" placeholder="搜索全站资料" data-global-search />
  </label>
  <div class="search-results" data-global-results></div>
</div>

<script>
  const root = document.querySelector('[data-site-search]');
  const input = root?.querySelector('[data-global-search]');
  const results = root?.querySelector('[data-global-results]');
  let searchIndex = null;
  let searchIndexPromise = null;

  const closeResults = () => {
    results?.classList.remove('is-open');
    if (results) results.innerHTML = '';
  };

  const showMessage = (message) => {
    if (!results) return;
    results.innerHTML = `<p class="muted search-status">${message}</p>`;
    results.classList.add('is-open');
  };

  const loadSearchIndex = () => {
    if (searchIndex) return Promise.resolve(searchIndex);
    if (!searchIndexPromise) {
      showMessage('正在加载搜索数据……');
      searchIndexPromise = fetch('/search-index.json')
        .then((response) => {
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          return response.json();
        })
        .then((index) => {
          searchIndex = index;
          return index;
        })
        .catch(() => {
          searchIndexPromise = null;
          throw new Error('搜索数据加载失败');
        });
    }
    return searchIndexPromise;
  };

  const renderResults = (index, query) => {
    if (!query || !results) {
      closeResults();
      return;
    }
    const getMatch = (item) => {
      const namePositions = item.terms.map((term) => term.toLowerCase().indexOf(query)).filter((position) => position >= 0);
      const namePosition = namePositions.length > 0 ? Math.min(...namePositions) : -1;
      if (item.terms.some((term) => term.toLowerCase() === query)) return { priority: 0, position: 0 };
      if (namePosition >= 0) return { priority: 1, position: namePosition };
      if (item.pinyin.includes(query) || item.initials.includes(query)) return { priority: 2, position: 0 };
      const categoryMatches = item.categoryTerms?.some((term) => term.toLowerCase().includes(query));
      if (categoryMatches || item.categoryPinyin?.includes(query) || item.categoryInitials?.includes(query)) return { priority: 3, position: 0 };
      return null;
    };
    const matched = index.map((item, index) => ({ item, match: getMatch(item), index })).filter((entry) => entry.match !== null);
    const groups = new Map();
    for (const entry of matched) {
      const key = `${entry.match.priority}:${entry.match.position}`;
      if (!groups.has(key)) groups.set(key, new Map());
      const category = entry.item.category;
      if (!groups.get(key).has(category)) groups.get(key).set(category, []);
      groups.get(key).get(category).push(entry);
    }
    const orderedMatches = [...groups.entries()]
      .sort(([a], [b]) => {
        const [aPriority, aPosition] = a.split(':').map(Number);
        const [bPriority, bPosition] = b.split(':').map(Number);
        return aPriority - bPriority || aPosition - bPosition;
      })
      .map(([, categoryGroups]) => categoryGroups)
      .flatMap((categoryGroups) => {
        const result = [];
        let hasEntries = true;
        while (hasEntries) {
          hasEntries = false;
          for (const entries of categoryGroups.values()) {
            const entry = entries.shift();
            if (entry) {
              result.push(entry);
              hasEntries = true;
            }
          }
        }
        return result;
      });
    const matches = orderedMatches.slice(0, 12);
    const remainingCount = orderedMatches.length - matches.length;
    if (matches.length === 0) {
      results.innerHTML = '<p class="muted search-status">没有找到相关资料。</p>';
    } else {
      results.innerHTML = matches.map(({ item }) => `<a href="${item.href}"><strong>${item.name}</strong><span class="search-category">${item.category}</span></a>`).join('')
        + (remainingCount > 0 ? `<p class="search-more">还有 ${remainingCount} 条结果</p>` : '');
    }
    results.classList.add('is-open');
  };

  const refreshResults = () => {
    const query = input?.value.trim().toLowerCase() ?? '';
    if (!query) {
      closeResults();
      return;
    }
    loadSearchIndex()
      .then((index) => renderResults(index, input?.value.trim().toLowerCase() ?? ''))
      .catch(() => showMessage('搜索数据加载失败，请稍后重试。'));
  };

  input?.addEventListener('focus', () => {
    loadSearchIndex().catch(() => showMessage('搜索数据加载失败，请稍后重试。'));
  });
  input?.addEventListener('input', refreshResults);
  document.addEventListener('click', (event) => {
    if (!root?.contains(event.target)) closeResults();
  });
</script>
